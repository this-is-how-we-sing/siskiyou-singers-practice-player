          const sigs = (hdr.timeSignatures?.length ? hdr.timeSignatures : [{ ticks: 0, timeSignature: [4, 4] }])
            .map(ts => ({
              tick: Math.round(ts.ticks / hdr.ppq * Tone.Transport.PPQ),
              num: ts.timeSignature?.[0] || 4,
              den: ts.timeSignature?.[1] || 4,
            }))
            .sort((a, b) => a.tick - b.tick);
          if (sigs[0].tick > 0) sigs.unshift({ tick: 0, num: 4, den: 4 });
          meterLabel = [...new Set(sigs.map(s => `${s.num}/${s.den}`))].join(' + ');
          beatsPerBar = Math.max(1, Math.round(sigs[0].num * 4 / sigs[0].den));
          // Every tempo in the file, not just the first. `midi.bpm` in
          // season-repertoire.ts scales the lot when the file runs at the
          // wrong speed, as the cut-time Earth Seen From Above export does.
          buildTempoMap(hdr);
          Tone.Transport.timeSignature = beatsPerBar;
          Tone.Transport.bpm.value = tempoMap[0].bpm * rate;

          metroSynth = new Tone.MembraneSynth({
            pitchDecay: 0.008, octaves: 2,
            envelope: { attack: 0.001, decay: 0.15, sustain: 0 },
          }).toDestination();
          metroSynth.volume.value = metroVolDb(metroLevel);
          metroLoop = new Tone.Loop((time) => {
            if (!metronomeOn) return;
            const beat = parseInt(Tone.Transport.position.toString().split(':')[1], 10);
            const isDownbeat = beat === 0;
            metroSynth.triggerAttackRelease(isDownbeat ? 'C5' : 'C4', '32n', time, isDownbeat ? 1 : 0.6);
          }, '4n');

          loadingTx.textContent = 'Loading piano sound…';
          // The page's one decoded piano. The first song opened decodes it;
          // every later song, and every export, reuses it.
          const piano = await sharedPiano(Tone, PIANO_URLS, PIANO_BASE);
          let maxEndTone = 0;
          channels = []; samplers = []; scheduledParts = []; vizParts = [];
          midis.forEach(midi => {
            const ch = new Tone.Channel({ volume: Tone.gainToDb(0.8) }).toDestination();
            const sampler = new Tone.Sampler({ urls: piano }).connect(ch);
            const ppq = midi.header.ppq;
            const flats = keyUsesFlats(midi.header);
            const events = [];
            const vnotes = []; let lo = 127, hi = 0;
            midi.tracks.forEach(tr => tr.notes.forEach(n => {
              const tTone = Math.round(n.ticks / ppq * Tone.Transport.PPQ);
              const dTone = Math.max(1, Math.round(n.durationTicks / ppq * Tone.Transport.PPQ));
              events.push([`${tTone}i`, { name: n.name, dur: `${dTone}i`, vel: n.velocity }]);
              const end = (n.ticks + n.durationTicks) / ppq * Tone.Transport.PPQ;
              if (end > maxEndTone) maxEndTone = end;
              vnotes.push({ sb: n.ticks / ppq, eb: (n.ticks + n.durationTicks) / ppq, midi: n.midi, nm: noteName(n.midi, flats) });
              if (n.midi < lo) lo = n.midi;
              if (n.midi > hi) hi = n.midi;
            }));
            vizParts.push({ notes: vnotes, lo: lo - 1, hi: hi + 1 });
            const part = new Tone.Part((time, ev) => {
              sampler.triggerAttackRelease(ev.name, ev.dur, time, ev.vel);
            }, events);
            channels.push(ch); samplers.push(sampler); scheduledParts.push(part);
          });

          // Walk the meter map to place every measure boundary. A new time
          // signature normally lands on a bar line; if a sloppy export puts one
          // mid-bar, the bar is cut short there so numbering stays in sync.
          barStarts = [];
          {
            let t = 0, si = 0;
            while (t < maxEndTone) {
              barStarts.push(t);
              while (si + 1 < sigs.length && sigs[si + 1].tick <= t) si++;
              const s = sigs[si];
              let next = t + Math.max(1, Math.round(Tone.Transport.PPQ * s.num * 4 / s.den));
              if (si + 1 < sigs.length && sigs[si + 1].tick > t && sigs[si + 1].tick < next) {
                next = sigs[si + 1].tick;
              }
              t = next;
            }
            barStarts.push(t); // end sentinel: last bar padded to its full length
          }
          totalMeasures = Math.max(1, barStarts.length - 1);
          buildMeasureMap();
          // A pickup carries its own short time signature (a 1/8 bar at the
          // head of a 6/8 piece), and that is an artefact of the anacrusis, not
          // a meter the choir reads. Leave it out of the line under the mixer,
          // and count the metronome's beats from the first numbered bar: off
          // the 1/8 bar, beatsPerBar came out 1 and every click sounded like a
          // downbeat.
          if (pickupBars) {
            const after = sigs.filter(sg => sg.tick >= barStarts[pickupBars]);
            if (after.length) meterLabel = [...new Set(after.map(sg => `${sg.num}/${sg.den}`))].join(' + ');
            beatsPerBar = Math.max(1, Math.round(
              (barStarts[pickupBars + 1] - barStarts[pickupBars]) / Tone.Transport.PPQ));
          }
          lastTickTone = barStarts[barStarts.length - 1];
          barStartBeats = new Set(barStarts.map(tk => tk / Tone.Transport.PPQ));
          levels = song.parts.map(() => 0.8);
          enabled = song.parts.map(() => true);
          await Tone.loaded(); // wait for piano samples to download

          await loadSync();
          await loadFollow();
          buildTracks();
          buildMeasures();
          loaded = true;
          activateTransport();
          updatePlayIcon();
          // Score view is available whenever the song has a PDF; the follow
          // dot additionally needs sync data.
          if (song.sheetPdf && sheetToggle) sheetToggle.style.display = '';
          // The button only appears for a song whose map actually carried
          // words, and the strip lines up with the lanes buildTracks just made.
          renderWordsToggle();
          alignWordsToLanes();
          followOn = syncNotes.length > 0 || !!followMap;
          if (followChk) followChk.checked = followOn;
          if (followWrap) followWrap.style.display = followOn ? '' : 'none';
          buildPartPicker();
          draw();
          // Paint the lanes once layout has settled (offsetWidth is 0 on the synchronous pass)
          // Paint the lanes once layout has settled. The bar lines no longer
          // need re-measuring: they are positioned by percentage, so they no
          // longer care what the track's pixel width is.
          requestAnimationFrame(() => drawWave());
          setTimeout(() => drawWave(), 200);
          // Label density is width-derived, so a rotate/resize has to rebuild it.
          // The score needs the same treatment: its canvas was rasterised for
          // the old column width, so rotating a tablet left it stretched or
          // shrunk by CSS rather than re-fitted. Debounced, since resize fires
          // in bursts and a re-render is not cheap.
          // Note: the score canvas is deliberately NOT re-rendered on resize.
          // It is rasterised at 2x, and because the sidebar only appears at
          // >=960px the score column barely changes between orientations
          // (632px portrait vs 582px landscape), so CSS scales it by ~1.09 —
          // invisible at that density. An attempt to re-render here fought the
          // pdfRendering flag and silently did nothing; not worth the risk.
          // The lane's left edge moves with the window: the name rail is sized
          // in ch, and below 640 the lanes go entirely.
          window.addEventListener('resize', () => { drawWave(); alignWordsToLanes(); });

          loadingEl.classList.add('hidden');
          transportEl.classList.remove('hidden');
          tracksEl.classList.remove('hidden');
          // Count the measures the singer can see, not the bars in the file,
          // and quote the tempo the way the page prints it where the two
          // disagree. The pickup is a bar of the file that the page does not
          // number, so it is called out rather than counted — otherwise the
          // repeat note fires on a score that has no repeat signs at all.
          const pickupNote = pickupBars ? ' plus a pickup' : '';
          const repeatNote = printedTotal + pickupBars < totalMeasures ? ' · repeats played in full' : '';
          const tempoNote = song.scoreTempo || `${meterLabel} time · ♩ = ${baseBpm}`;
          // When the library's measure map does not fit this file, the score
          // view stays manual and the line says so; the console has the why.
          const followNote = followPreview
            ? (followOff ? ' · PREVIEW: score follow forced, map does not match the MIDI' : ' · PREVIEW: score follow forced')
            : (followOff ? ' · score follow off' : '');
          statusEl.textContent = `${printedTotal} measures${pickupNote}${repeatNote} · ${tempoNote}${followNote}`;
          // Say so on the boxes too, since "0" is otherwise a number a singer
          // has no reason to try. The box takes three shapes, so the hint
          // names all three rather than the one the pickup made it about.
          if (pickupBars) {
            const hint = 'A measure (10), a measure and beat (10 · 3), or a range (33-40). Measure 0 is the pickup.';
            loopStartEl.title = hint;
            loopEndEl.title = hint;
          }
        } catch (e) {
          loadingTx.textContent = 'Could not load MIDI: ' + e.message;
          console.error('[MIDI] load failed', e);
        }
      }

      // ---- Tempo map ---------------------------------------------------
      // Everything in the player is positioned in ticks, which do not care
      // about tempo. Seconds do, so every tick <-> second conversion goes
      // through this map rather than through Tone's own, which knows only the
      // tempo running right now.
      function buildTempoMap(hdr) {
        const PPQ = Tone.Transport.PPQ;
        const raw = (hdr.tempos || [])
          .filter(t => Number.isFinite(t.bpm) && t.bpm > 0)
          .map(t => ({ tick: Math.max(0, Math.round(t.ticks / hdr.ppq * PPQ)), bpm: t.bpm }))
          .sort((a, b) => a.tick - b.tick);
        const segs = [];
        for (const e of raw) {
          const last = segs[segs.length - 1];
          // Two events on one tick: the later wins. An event that repeats the
          // tempo already running is not a change.
          if (last && last.tick === e.tick) last.bpm = e.bpm;
          else if (!last || Math.abs(last.bpm - e.bpm) > 1e-6) segs.push({ tick: e.tick, bpm: e.bpm, sec: 0 });
        }
        if (!segs.length) segs.push({ tick: 0, bpm: 100, sec: 0 });
        if (segs[0].tick > 0) segs.unshift({ tick: 0, bpm: segs[0].bpm, sec: 0 });
        // `midi.bpm` in season-repertoire.ts names the tempo the page prints
        // for the opening. Scale the whole map to it, so a file that runs at
        // the wrong speed comes right and keeps any tempo changes it holds.
        if (song.bpm > 0) {
          const factor = song.bpm / segs[0].bpm;
          for (const seg of segs) seg.bpm *= factor;
        }
        for (let i = 1; i < segs.length; i++) {
          const prev = segs[i - 1];
          segs[i].sec = prev.sec + (segs[i].tick - prev.tick) * (60 / (prev.bpm * PPQ));
        }
        tempoMap = segs;
        baseBpm = Math.round(segs[0].bpm);
      }

      // The tempo dial and the saloon egg scale the whole map at once.
      const tempoRate = () => (eggActive ? 0.5 : rate);

      function tempoIndexAt(tk) {
        let lo = 0, hi = tempoMap.length - 1, ans = 0;
        while (lo <= hi) {
          const mid = (lo + hi) >> 1;
          if (tempoMap[mid].tick <= tk) { ans = mid; lo = mid + 1; } else hi = mid - 1;
        }
        return ans;
      }

      /** Seconds from the top of the piece to this tick, at the dialled tempo. */
      function ticksToSec(tk) {
        const seg = tempoMap[tempoIndexAt(tk)];
        return (seg.sec + (tk - seg.tick) * (60 / (seg.bpm * Tone.Transport.PPQ))) / tempoRate();
      }

      /** The tick a given number of seconds into the piece. The inverse of ticksToSec. */
      function secToTicks(sec) {
        const at100 = Math.max(0, Number(sec) || 0) * tempoRate();
        let lo = 0, hi = tempoMap.length - 1, i = 0;
        while (lo <= hi) {
          const mid = (lo + hi) >> 1;
          if (tempoMap[mid].sec <= at100 + 1e-9) { i = mid; lo = mid + 1; } else hi = mid - 1;
        }
        const seg = tempoMap[i];
        return Math.round(seg.tick + (at100 - seg.sec) * ((seg.bpm * Tone.Transport.PPQ) / 60));
      }

      // Apply each tempo change as the transport reaches it. A seek past a
      // change skips its event, so applyBpm() sets the right tempo directly
      // whenever the position moves by any other means.
      function scheduleTempoChanges() {
        tempoEventIds.forEach(id => Tone.Transport.clear(id));
        tempoEventIds = [];
        for (let i = 1; i < tempoMap.length; i++) {
          const seg = tempoMap[i];
          tempoEventIds.push(Tone.Transport.schedule(time => {
            Tone.Transport.bpm.setValueAtTime(seg.bpm * tempoRate(), time);
          }, `${seg.tick}i`));
        }
      }

      // Build the played-bar <-> printed-measure translation from song.repeats.
      // Called once barStarts (and so totalMeasures) is known.
      //
      // The list is checked against the file before it is trusted: the printed
      // measures plus every extra pass must come to exactly the number of bars
      // in the MIDI. A list that does not reconcile means the two drifted apart
      // — someone re-exported the MIDI, or mis-read a repeat sign — and a
      // silently wrong measure number is worse than no translation at all, so
      // that case logs and falls back to straight-through numbering.
      function buildMeasureMap() {
        // A pickup is played but not numbered: the page calls the bar AFTER it
        // measure 1. Without this the readout sat one measure ahead of the
        // page for the whole piece (members feedback, 2026-09-15).
        //
        // Checked against the file for the same reason the repeat list is: a
        // flag on the wrong score puts a wrong number on every bar, and a
        // silently wrong measure number is worse than none. The test is the one
        // an engraver would use — the pickup is shorter than the bar after it.
        // It stays a declared flag rather than a guess, because a piece can
        // genuinely open on a short bar that the page DOES number.
        pickupBars = song.pickup ? 1 : 0;
        if (pickupBars && !(totalMeasures > 1
            && barStarts[1] - barStarts[0] < barStarts[2] - barStarts[1])) {
          console.warn(`[MIDI] ${song.title}: pickup is set, but the file's first bar is not shorter than the second. Numbering the first bar as measure 1.`);
          pickupBars = 0;
        }

        const identity = () => {
          printedOf = []; passOf = []; passesOf = [];
          firstPlayedOf = new Array(totalMeasures + 2).fill(-1);
          lastPlayedOf = new Array(totalMeasures + 2).fill(-1);
          repeatRestarts = new Set();
          for (let i = 0; i < totalMeasures; i++) {
            const pm = i + 1 - pickupBars; // 0 on the pickup bar
            printedOf.push(pm); passOf.push(1); passesOf.push(1);
            firstPlayedOf[pm] = i; lastPlayedOf[pm] = i;
          }
          printedTotal = totalMeasures - pickupBars;
        };

        const spans = (Array.isArray(song.repeats) ? song.repeats : [])
          .map(r => ({ from: Math.round(r.from), to: Math.round(r.to), times: Math.round(r.times) }))
          .sort((a, b) => a.from - b.from);
        if (!spans.length) { identity(); return; }

        // Bars the file plays over and above the printed count. A block of
        // (to - from + 1) bars heard `times` over contributes one extra copy
        // per repeat. Endings do not add any: each ending bar is printed once
        // and sounds once, it just sounds in a different place each pass.
        const extra = spans.reduce((n, r) => n + (r.to - r.from + 1) * (r.times - 1), 0);
        const printed = totalMeasures - extra - pickupBars;
        let bad = printed < 1 ? 'repeats account for the whole file' : '';
        let prevTo = 0;
        for (const r of spans) {
          const ends = Array.isArray(r.endings) ? r.endings : [];
          if (!(r.from >= 1 && r.to >= r.from && r.times >= 2)) bad = bad || `bad span ${r.from}-${r.to} x${r.times}`;
          else if (r.from <= prevTo) bad = bad || `span ${r.from}-${r.to} overlaps the one before it`;
          else if (r.to > printed) bad = bad || `span ${r.from}-${r.to} runs past printed measure ${printed}`;
          else if (ends.length && ends.length !== r.times) bad = bad || `span ${r.from}-${r.to} has ${ends.length} endings for ${r.times} passes`;
          else if (ends.some((e, k) => e !== r.to + 1 + k)) bad = bad || `endings of span ${r.from}-${r.to} must be the bars straight after it`;
          else if (ends.length && ends[ends.length - 1] > printed) bad = bad || `endings of span ${r.from}-${r.to} run past printed measure ${printed}`;
          // The ending bars belong to this span, so the next one starts after them.
          prevTo = ends.length ? ends[ends.length - 1] : r.to;
        }
        if (bad) {
          console.warn(`[MIDI] ${song.title}: ignoring the repeat map (${bad}). Measure numbers follow the audio, not the page.`);
          identity(); return;
        }

        const byFrom = new Map(spans.map(r => [r.from, r]));
        printedOf = []; passOf = []; passesOf = [];
        firstPlayedOf = new Array(printed + 2).fill(-1);
        lastPlayedOf = new Array(printed + 2).fill(-1);
        repeatRestarts = new Set();
        // The pickup leads, unnumbered, and no repeat sign can reach it.
        for (let i = 0; i < pickupBars; i++) {
          printedOf.push(0); passOf.push(1); passesOf.push(1);
          firstPlayedOf[0] = i; lastPlayedOf[0] = i;
        }
        for (let m = 1; m <= printed; ) {
          const r = byFrom.get(m);
          const to = r ? r.to : m;
          const times = r ? r.times : 1;
          const ends = r && Array.isArray(r.endings) ? r.endings : [];
          const put = (pm, pass) => {
            const i = printedOf.length;
            printedOf.push(pm); passOf.push(pass); passesOf.push(times);
            if (firstPlayedOf[pm] < 0) firstPlayedOf[pm] = i;
            lastPlayedOf[pm] = i;
          };
          for (let pass = 1; pass <= times; pass++) {
            if (pass > 1) repeatRestarts.add(printedOf.length);
            for (let pm = m; pm <= to; pm++) put(pm, pass);
            // First- and second-time bars: this pass's ending sounds here,
            // between the passes, not after both of them.
            if (ends.length) put(ends[pass - 1], pass);
          }
          m = (ends.length ? ends[ends.length - 1] : to) + 1;
        }
        if (printedOf.length !== totalMeasures) {
          console.warn(`[MIDI] ${song.title}: repeat map expands to ${printedOf.length} bars but the MIDI holds ${totalMeasures}. Measure numbers follow the audio, not the page.`);
          identity(); return;
        }
        printedTotal = printed;
      }

      // The number a singer reads off the page, for a 0-based played bar index.
      // 0 means the pickup bar, which the page does not number, so this cannot
      // use `||` to fall back: 0 is a real answer, not a missing one.
      const printedAt = i => {
        const m = printedOf[Math.max(0, Math.min(printedOf.length - 1, i))];
        return m === undefined ? i + 1 : m;
      };
      // First and last played bar of a printed measure, clamped into the song.
      // The floor is 0 on a score with a pickup and 1 on every other.
      function firstPlayed(m) {
        const mm = Math.max(1 - pickupBars, Math.min(Math.round(m), printedTotal));
        return firstPlayedOf[mm] >= 0 ? firstPlayedOf[mm] : 0;
      }
      function lastPlayed(m) {
        const mm = Math.max(1 - pickupBars, Math.min(Math.round(m), printedTotal));
        return lastPlayedOf[mm] >= 0 ? lastPlayedOf[mm] : totalMeasures - 1;
      }
      const ORDINALS = ['', '1st', '2nd', '3rd', '4th', '5th', '6th', '7th', '8th'];
      const ordinal = k => ORDINALS[k] || `${k}th`;

      // 0-based index of the measure containing the given Tone tick.
      function measureAt(tk) {
        let lo = 0, hi = totalMeasures - 1, ans = 0;
        while (lo <= hi) {
          const mid = (lo + hi) >> 1;
          if (barStarts[mid] <= tk) { ans = mid; lo = mid + 1; } else hi = mid - 1;
        }
        return ans;
      }
      // Length of the given 1-based measure, in quarter-note beats.
      function barQuarters(measureNum) {
        const i = Math.max(0, Math.min(totalMeasures - 1, measureNum - 1));
        return Math.max(1e-6, (barStarts[i + 1] - barStarts[i]) / Tone.Transport.PPQ);
      }

      // Quarter-note beat inside the printed bar, 1-based. It counts from the
      // bar line in barStarts, not from Tone.Transport.position: the Transport
      // holds one bar length for the whole song, so the 3/2 bars of In the
      // Bleak Midwinter put its own count two beats out from there on.
      function beatAt(tk) {
        const mi = Math.min(totalMeasures - 1, measureAt(tk));
        return Math.floor(Math.max(0, tk - barStarts[mi]) / Tone.Transport.PPQ) + 1;
      }
      // "m. 113 · 2", or "pickup · 1" on the bar the page does not number.
      // The readout beside the progress bar and the loop bar both print this,
      // so a singer reads one kind of address in both places.
      const measureBeat = tk => {
        const m = printedAt(Math.min(totalMeasures - 1, measureAt(tk)));
        return `${m < 1 ? 'pickup' : `m. ${m}`} · ${beatAt(tk)}`;
      };

      // Every position a loop edge is allowed to take. A beat, not a bar line:
      // a singer loops from the pickup, or from a mid-bar entry, and the tenor
      // of this piece enters on beat 2 of m. 14. Snapping happens inside the
      // containing bar, so the 3/2 bar of six beats works and so does any odd
      // meter.
      //
      // Bar lines get no extra pull. Six pixels of a 996px track is 1.64 beats
      // on In the Bleak Midwinter, so a bar line that far away beat the nearer
      // beat and put m. 16 beat 3 out of reach. Any slack narrow enough to be
      // safe is under half a beat, where this already returns the bar line. A
      // coarse drag plus an exact typed box is the pair that works.
      function snapToBeat(tk) {
        const mi = Math.min(totalMeasures - 1, measureAt(tk));
        const into = Math.round((tk - barStarts[mi]) / Tone.Transport.PPQ) * Tone.Transport.PPQ;
        return Math.max(0, Math.min(barStarts[mi] + into, barStarts[mi + 1]));
      }
      // "10 · 3" for a loop box. The measure is the printed number, so it
      // matches the page and the readout beside the progress bar.
      //
      // A printed measure inside a repeat sounds more than once, so the number
      // alone does not say where in the audio you are. "118 · 1" names two bars
      // of Earth Seen From Above. Later passes therefore carry the pass too,
      // and the first one does not, which keeps the boxes quiet on the scores
      // that have no repeats at all.
      const mbText = tk => {
        const mi = Math.min(totalMeasures - 1, measureAt(tk));
        const pass = (passesOf[mi] || 1) > 1 && (passOf[mi] || 1) > 1
          ? ` (${ordinal(passOf[mi])})` : '';
        return `${printedAt(mi)} · ${beatAt(tk)}${pass}`;
      };
      // The played bar for a printed measure on a given pass. The bars of one
      // printed measure are not adjacent: the 2nd pass of m. 118 sits after the
      // 1st pass of m. 120, so this scans rather than offsets.
      function playedBarOnPass(m, pass) {
        for (let i = 0; i < printedOf.length; i++) {
          if (printedOf[i] === m && passOf[i] === pass) return i;
        }
        return -1;
      }
      // Reads "10 · 3", "10.3", "10 3", "m10 b3" and a bare "10", which means
      // beat 1, plus an optional pass in brackets: "118 · 1 (2nd)" or "118 (2)".
      // On a score with a pickup, "0" names that unnumbered first bar.
      // Without a pass, `last` picks the final pass rather than the first, the
      // same choice practiceMeasures makes for a loop's two ends.
      function mbToTicks(text, last) {
        const s = String(text);
        const wants = s.match(/\((\d+)/);
        const n = s.replace(/\([^)]*\)/g, '').match(/\d+/g);
        if (!n || !n.length) return null;
        const m = Math.max(1 - pickupBars, Math.min(Number(n[0]), printedTotal));
        let bar = -1;
        if (wants) bar = playedBarOnPass(m, Math.max(1, Number(wants[1])));
        if (bar < 0) bar = last ? lastPlayed(m) : firstPlayed(m);
        const beats = Math.max(1, Math.round((barStarts[bar + 1] - barStarts[bar]) / Tone.Transport.PPQ));
        const b = Math.max(1, Math.min(n.length > 1 ? Number(n[1]) : 1, beats));
        return { start: barStarts[bar] + (b - 1) * Tone.Transport.PPQ, bar };
      }

      // Bar lines on the scrub track. The numbered strip that used to sit under
      // it is gone: it never had room. Whatever density it picked, a narrow
      // panel ran the numbers together into "1 6 1116212631364146515661", and
      // the one number anyone actually wants is the measure you are on, which
      // the readout beside the track gives exactly.
      function buildMeasures() {
        ticksEl.innerHTML = '';
        // Nothing to explain on a score that plays straight through.
        if (legendEl) legendEl.hidden = repeatRestarts.size === 0;
        const majorEvery = totalMeasures > 40 ? 10 : (totalMeasures > 16 ? 5 : 2);
        for (let m = 1; m <= totalMeasures; m++) {
          const frac = barStarts[m - 1] / lastTickTone;
          const tk = document.createElement('div');
          tk.className = 'tk'
            + ((m - 1) % majorEvery === 0 ? ' major' : '')
            + (repeatRestarts.has(m - 1) ? ' repeat' : '');
          tk.style.left = (frac * 100) + '%';
          ticksEl.appendChild(tk);
        }
      }

      // Update each part's boxed "current note" readout to whatever is
      // sounding at the playhead. Divisi chords list top note first. During a
      // rest, show the part's NEXT note greyed out so singers see what's coming.
      function updateNowNotes() {
        if (!noteNowEls.length || !Tone) return;
        const curBeat = Tone.Transport.ticks / Tone.Transport.PPQ;
        vizParts.forEach((part, i) => {
          const el = noteNowEls[i];
          if (!el || !part) return;
          const active = [];
          let nextSb = Infinity;
          for (const n of part.notes) {
            if (n.sb <= curBeat + 1e-6) {
              if (curBeat < n.eb - 1e-6) active.push(n);
            } else if (n.sb < nextSb) nextSb = n.sb;
          }
          let pool = active, coming = false;
          if (!pool.length && nextSb < Infinity) {
            coming = true;
            pool = part.notes.filter(n => Math.abs(n.sb - nextSb) < 1e-6);
          }
          const sorted = pool.sort((a, b) => b.midi - a.midi);
          const uniq = [];
          for (const n of sorted) if (!uniq.some(u => u.nm === n.nm)) uniq.push(n);
          const picked = uniq.slice(0, 2);
          const names = picked.map(n => n.nm);
          const txt = names.join(' ') || '–';
          if (el.textContent !== txt) el.textContent = txt;
          // The readout is tappable — stash the pitches it is showing.
          el.dataset.midi = picked.map(n => n.midi).join(',');
          el.setAttribute('aria-label', names.length
            ? `Play ${names.join(' and ')} on ${el.dataset.part}`
            : `No note for ${el.dataset.part} here`);
          el.classList.toggle('is-coming', coming || !names.length);
          el.classList.toggle('is-multi', names.length > 1);
        });
      }

      // Sound whatever the note readout is currently showing, on that part's own
      // piano. Routed through the part's channel, so it comes out at the volume
      // that part is set to (and stays silent if you have it unchecked).
      async function previewNote(i) {
        const el = noteNowEls[i], sampler = samplers[i];
        if (!el || !sampler || !Tone) return;
        const midis = (el.dataset.midi || '').split(',').filter(Boolean).map(Number);
        if (!midis.length) return;
        try { await Tone.start(); } catch {}
        const at = Tone.now();
        midis.forEach(m => {
          sampler.triggerAttackRelease(Tone.Frequency(m, 'midi').toNote(), 1.4, at);
        });
        el.classList.add('is-sounding');
        setTimeout(() => el.classList.remove('is-sounding'), 260);
      }

      function drawWave() {
        if (!waveCanvases.length || !Tone) return;
        updateNowNotes();
        const curBeat = Tone.Transport.ticks / Tone.Transport.PPQ;
        const wStart = curBeat - WAVE_PLAYHEAD_FRAC * WINDOW_BEATS;
        waveCanvases.forEach((cv, i) => {
          // Robust width: offsetWidth can read 0 before layout settles (esp. Safari flex items)
          const W = Math.round(cv.clientWidth || cv.getBoundingClientRect().width ||
                               (cv.parentElement && cv.parentElement.clientWidth) || 0);
          if (W <= 0) return;
          const H = cv.height || 44;
          if (cv.width !== W) cv.width = W;
          if (cv.height !== H) cv.height = H;
          const ctx = cv.getContext('2d');
          // Always paint the dark lane background first — never leave a blank white canvas
          ctx.clearRect(0, 0, W, H);
          ctx.fillStyle = 'rgba(255,255,255,0.03)';
          ctx.fillRect(0, 0, W, H);
          const part = vizParts[i]; if (!part) return;
          const pxPerBeat = W / WINDOW_BEATS;
          // Measure / beat gridlines (measure lines brighter)
          const firstBeat = Math.ceil(wStart);
          for (let b = firstBeat; b < wStart + WINDOW_BEATS; b++) {
            const x = Math.round((b - wStart) * pxPerBeat);
            ctx.fillStyle = barStartBeats.has(b) ? 'rgba(255,255,255,0.16)' : 'rgba(255,255,255,0.05)';
            ctx.fillRect(x, 0, 1, H);
          }
          // Notes — color reflects enabled/focus state
          let noteColor = COLORS[i % COLORS.length];
          if (!enabled[i]) noteColor = 'rgba(170,170,170,0.22)';
          else if (focusedTrack !== null && i !== focusedTrack) {
            noteColor = focusMode === 'iso'
              ? 'rgba(170,170,170,0.22)'
              : noteColor.replace(/,\s*[\d.]+\)$/, ',0.25)');
          }
          ctx.fillStyle = noteColor;
          const span = Math.max(1, part.hi - part.lo);
          for (const n of part.notes) {
            const x0 = (n.sb - wStart) * pxPerBeat, x1 = (n.eb - wStart) * pxPerBeat;
            if (x1 < 0 || x0 > W) continue;
            const cx0 = Math.max(0, x0), cx1 = Math.min(W, x1);
            const yFrac = (n.midi - part.lo) / span;
            const y = Math.round((1 - yFrac) * (H - 8) + 4);
            ctx.fillRect(cx0, y - 2, Math.max(2, cx1 - cx0), 4);
          }
          // Playhead (shared beat column across all lanes — misalignment shows here)
          const px = Math.round(WAVE_PLAYHEAD_FRAC * W);
          ctx.fillStyle = 'rgba(255,255,255,0.6)';
          ctx.fillRect(px, 0, 1, H);
        });
        drawWords();
      }

      // Volume dial — a grip on the arc that you tap to, or drag around.
      // Keyboard-accessible (role=slider); wheel still nudges on desktop.
      // onInput fires on user changes; set() updates the visuals only (used
      // when solo/iso or reset drive the value).
      const KNOB_R = 13.5;               // grip of r=6.5 then lands on the viewBox edge
      const KNOB_SPAN = 270, KNOB_START = -135;  // gap at the bottom
      function makeKnob(label, initialPct, onInput, onRender) {
        const NS = 'http://www.w3.org/2000/svg';
        const root = document.createElement('div');
        root.className = 'pp-knob';
        root.setAttribute('role', 'slider');
        root.tabIndex = 0;
        root.setAttribute('aria-label', `Volume for ${label}`);
        root.setAttribute('aria-valuemin', '0');
        root.setAttribute('aria-valuemax', '100');
        const svg = document.createElementNS(NS, 'svg');
        svg.setAttribute('viewBox', '0 0 40 40'); svg.setAttribute('class', 'pp-knob-svg');
        svg.setAttribute('aria-hidden', 'true');
        const C = 2 * Math.PI * KNOB_R, ARC = 0.75 * C;
        const circle = (cls, r) => {
          const c = document.createElementNS(NS, 'circle');
          c.setAttribute('cx', '20'); c.setAttribute('cy', '20');
          c.setAttribute('r', String(r)); c.setAttribute('class', cls);
          return c;
        };
        const wedge = document.createElementNS(NS, 'path');
        wedge.setAttribute('class', 'pp-knob-wedge');
        const track = circle('pp-knob-track', KNOB_R), fill = circle('pp-knob-fill', KNOB_R);
        track.setAttribute('stroke-dasharray', `${ARC} ${C}`);
        const halo = circle('pp-knob-halo', 8.5), thumb = circle('pp-knob-thumb', 6.5);
        svg.append(wedge, track, fill, halo, thumb);
        root.append(svg);

        // Angles run clockwise from straight up, so 0% sits at -135 and 100% at +135.
        const pointAt = (deg, radius) => {
          const rad = deg * Math.PI / 180;
          return [20 + radius * Math.sin(rad), 20 - radius * Math.cos(rad)];
        };

        let value = initialPct;
        const render = () => {
          const frac = value / 100;
          const deg = KNOB_START + frac * KNOB_SPAN;
          fill.setAttribute('stroke-dasharray', `${frac * ARC} ${C}`);
          if (frac <= 0.001) {
            wedge.setAttribute('d', '');
          } else {
            const WR = KNOB_R - 1.8;
            const a = pointAt(KNOB_START, WR), b = pointAt(deg, WR);
            const large = frac * KNOB_SPAN > 180 ? 1 : 0;
            wedge.setAttribute('d',
              `M 20 20 L ${a[0].toFixed(3)} ${a[1].toFixed(3)} ` +
              `A ${WR} ${WR} 0 ${large} 1 ${b[0].toFixed(3)} ${b[1].toFixed(3)} Z`);
          }
          const t = pointAt(deg, KNOB_R);
          thumb.setAttribute('cx', t[0]); thumb.setAttribute('cy', t[1]);
          halo.setAttribute('cx', t[0]); halo.setAttribute('cy', t[1]);
          root.setAttribute('aria-valuenow', String(Math.round(value)));
          root.setAttribute('aria-valuetext', `${Math.round(value)}%`);
          if (onRender) onRender(Math.round(value));
        };
        const set = pct => { value = Math.max(0, Math.min(100, pct)); render(); };
        const commit = pct => { set(pct); onInput(Math.round(value)); };
        const disabled = () => root.classList.contains('is-disabled');

        // Read the pointer as an angle, not as a vertical distance — that is
        // what the grip promises. The 90-degree dead zone at the bottom splits
        // at straight down, so dragging off either end holds at that end
        // instead of wrapping full round to the opposite one.
        const valueAt = e => {
          const b = root.getBoundingClientRect();
          const dx = e.clientX - (b.left + b.width / 2);
          const dy = e.clientY - (b.top + b.height / 2);
          const deg = Math.atan2(dx, -dy) * 180 / Math.PI;
          if (deg > 135) return 100;
          if (deg < -135) return 0;
          return ((deg - KNOB_START) / KNOB_SPAN) * 100;
        };

        let dragging = false;
        root.addEventListener('pointerdown', e => {
          if (disabled()) return;
          dragging = true;
          root.classList.add('is-dragging');
          e.preventDefault();
          // Land the tap before asking for pointer capture: capture can throw,
          // and a tap that only registers when capture succeeds is a tap that
          // silently does nothing — the exact complaint this change is fixing.
          commit(snapVol(Math.round(valueAt(e))));
          try { root.setPointerCapture(e.pointerId); } catch {}
        });
        root.addEventListener('pointermove', e => {
          if (!dragging) return;
          commit(snapVol(Math.round(valueAt(e))));
        });
        const endDrag = e => {
          if (!dragging) return;
          dragging = false; root.classList.remove('is-dragging');
          try { root.releasePointerCapture(e.pointerId); } catch {}
        };
        root.addEventListener('pointerup', endDrag);
        root.addEventListener('pointercancel', endDrag);
        root.addEventListener('wheel', e => {
          if (disabled()) return;
          e.preventDefault(); commit(Math.round(value) + (e.deltaY < 0 ? 2 : -2));
        }, { passive: false });
        root.addEventListener('keydown', e => {
          if (disabled()) return;
          let v = value, handled = true;
          if (e.key === 'ArrowUp' || e.key === 'ArrowRight') v += 5;
          else if (e.key === 'ArrowDown' || e.key === 'ArrowLeft') v -= 5;
          else if (e.key === 'PageUp') v += 25;
          else if (e.key === 'PageDown') v -= 25;
          else if (e.key === 'Home') v = 0;
          else if (e.key === 'End') v = 100;
          else handled = false;
          if (handled) { e.preventDefault(); commit(v); }
        });
        set(initialPct);
        return {
          root, set,
          setDisabled(b) { root.classList.toggle('is-disabled', b); root.tabIndex = b ? -1 : 0; },
          setMuted(b) { root.classList.toggle('is-muted', b); },
          get value() { return value; },
        };
      }

      // One unified channel row per voice part: name · its scrolling note lane ·
      // Solo/Isolate · volume knob. The note lane is the visual (no separate
      // level bar), so each part is listed exactly once.
      function buildTracks() {
        tracksEl.innerHTML = '';
        focusBtns = []; isoBtns = []; trackRows = [];
        knobs = []; checkboxEls = []; waveCanvases = []; noteNowEls = [];
        song.parts.forEach((p, i) => {
          const color = COLORS[i % COLORS.length];
          const [r, g, b] = parseRgba(color);
          const row = document.createElement('div'); row.className = 'pp-chan';
          row.style.setProperty('--trk', `rgba(${r},${g},${b},0.95)`);

          const lbl = document.createElement('label'); lbl.className = 'pp-chan-name'; lbl.htmlFor = `${prefix}-cb-${i}`;
          const cb = document.createElement('input'); cb.type = 'checkbox'; cb.id = `${prefix}-cb-${i}`; cb.checked = true;
          const name = document.createElement('span'); name.className = 'pp-track-name'; name.textContent = p.label;
          lbl.append(cb, name);

          // Boxed live "current note" readout — sits just left of the lane.
          // Voice parts only: accompaniment chords don't fit in the box and
          // aren't what singers follow, so those rows get an invisible
          // placeholder instead (keeps every lane's playhead column aligned).
          const noteBox = document.createElement('span'); noteBox.className = 'pp-note-box';
          if (/piano|accomp|organ|instrument|orchestra/i.test(p.label)) {
            noteBox.classList.add('is-off');
            noteBox.setAttribute('aria-hidden', 'true');
            noteNowEls.push(null);
          } else {
            noteBox.textContent = '–';
            noteBox.dataset.part = p.label;
            // Tapping the readout sounds the note, so you can hear your entry
            // before it arrives instead of guessing at it.
            noteBox.classList.add('is-playable');
            noteBox.setAttribute('role', 'button');
            noteBox.tabIndex = 0;
            noteBox.title = `Play this note (${p.label})`;
            noteBox.setAttribute('aria-label', `No note for ${p.label} here`);
            const idx = i;
            noteBox.addEventListener('click', () => previewNote(idx));
            noteBox.addEventListener('keydown', e => {
              if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); previewNote(idx); }
            });
            noteNowEls.push(noteBox);
          }

          // The note lane — the part's notes scroll here; doubles as the visual
          // that used to be a redundant second row + level bar.
          const cv = document.createElement('canvas'); cv.className = 'pp-lane'; cv.height = 44;
          cv.setAttribute('aria-hidden', 'true');
          waveCanvases.push(cv);

          // Buttons live outside the <label> — iOS Safari fires a second
          // synthetic click on the label after a button tap inside it,
          // toggling the checkbox.
          const solo = document.createElement('button'); solo.type = 'button'; solo.className = 'pp-focus-btn';
          // The word where there is room, a single letter where there is not.
          // The narrow layouts put these beside the part name on one line, and
          // "Solo" plus "Isolate" cost more width than the name itself. Both
          // spellings are decoration to a screen reader: the button's real
          // name is its aria-label.
          solo.innerHTML = '<span class="pp-btn-long">Solo</span><span class="pp-btn-short" aria-hidden="true">S</span>';
          solo.setAttribute('aria-label', `Emphasize ${p.label}`);
          solo.title = 'Emphasize this part (others at 18%)';
          solo.addEventListener('click', e => { e.preventDefault(); setFocus(i, 'solo'); });
          const iso = document.createElement('button'); iso.type = 'button'; iso.className = 'pp-iso-btn';
          iso.innerHTML = '<span class="pp-btn-long">Isolate</span><span class="pp-btn-short" aria-hidden="true">I</span>';
          iso.setAttribute('aria-label', `Isolate ${p.label}`);
          iso.title = 'Isolate this part (others muted)';
          iso.addEventListener('click', e => { e.preventDefault(); setFocus(i, 'iso'); });
          const btns = document.createElement('span'); btns.className = 'pp-chan-btns'; btns.append(solo, iso);

          // No number beside the dial. The dial already shows the level as a
          // filled arc, so the percent was a second copy of one fact, and it
          // cost ~40px on every voice row — the width a phone needed to put
          // the row on one line. The value is still spoken: the dial carries
          // it in aria-valuenow.
          const knob = makeKnob(p.label, 80, v => {
            levels[i] = v / 100;
            applyGains();
          });

          cb.addEventListener('change', () => {
            enabled[i] = cb.checked;
            applyGains();
            knob.setMuted(!cb.checked);
            row.classList.toggle('pp-chan-off', !cb.checked);
            drawWave();
          });

          const volWrap = document.createElement('div'); volWrap.className = 'pp-chan-vol';
          volWrap.append(knob.root);
          // Solo/Isolate + volume share a wrapper: display:contents on wide
          // screens (lays out as before), its own second line on narrow ones
          const ctrls = document.createElement('div'); ctrls.className = 'pp-chan-ctrls';
          ctrls.append(btns, volWrap);
          // Controls cluster on the left (name · Solo/Isolate · knob), then the
          // current-note box (voice parts), then the note lane fills the right
          row.append(lbl, ctrls, noteBox, cv);
          tracksEl.appendChild(row);
          focusBtns.push(solo); isoBtns.push(iso); trackRows.push(row);
          knobs.push(knob); checkboxEls.push(cb);
        });
        sizeNameRail();
      }

      /**
       * Set the name rail to the widest part name as the browser actually
       * draws it.
       *
       * The CSS estimate multiplies a character count by `ch`, the width of
       * "0". That under-measures proportional text — "Soprano 1" needs more
       * than nine of them — so the name wrapped to two lines while "Tenor" ran
       * up against the Solo button. Measuring costs one layout at start-up and
       * is right for any font, any zoom and any label.
       *
       * The cap is the point of the old 20-character clamp: a long
       * accompaniment name like "Organ (Pedals)" still wraps inside its row
       * rather than eating the width the note lane needs.
       */
      function sizeNameRail() {
        const sample = tracksEl.querySelector('.pp-chan-name .pp-track-name');
        if (!sample || !panel) return;
        const cs = getComputedStyle(sample);
        const probe = document.createElement('span');
        probe.style.position = 'absolute';
        probe.style.visibility = 'hidden';
        probe.style.whiteSpace = 'nowrap';
        probe.style.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize}/${cs.lineHeight} ${cs.fontFamily}`;
        probe.style.letterSpacing = cs.letterSpacing;
        document.body.appendChild(probe);
        let widest = 0;
        for (const p of song.parts) {
          probe.textContent = p.label;
          widest = Math.max(widest, probe.getBoundingClientRect().width);
        }
        probe.remove();
        if (!widest) return;
        // 20 characters at roughly 0.62em apiece, the same ceiling the old
        // character clamp set. 26px covers the checkbox, its gap and a hair.
        const cap = 20 * parseFloat(cs.fontSize) * 0.62;
        panel.style.setProperty('--pp-name-w', `${Math.ceil(Math.min(widest, cap)) + 26}px`);
      }

      // Per-part gain after mutes, solo and isolate. applyGains() drives the
      // speakers and renderMix() drives the exported file, so both call this and
      // the file always matches what the singer just heard.
      //
      // SOLO AND ISOLATE KEEP THE LOUDNESS OF THE FULL MIX
      //
      // Singers reported on 2026-09-27 that Solo made everything much quieter.
      // It did. Solo used to set the chosen part to 1.0 and the others to 18%
      // of their level, and parts that are not in lockstep add as power, so on
      // a nine-part score (8 voices and piano at the default 0.8) the whole mix
      // fell about 7.6 dB, and about 4 dB on a four-part score. The soloed part
      // itself only rose 2 dB, from 0.8 to 1.0. Isolate fell the same way.
      //
      // The focused part now gets the level that makes the loudness match the
      // full mix it replaced. The others still sit at 18% for Solo and at 0 for
      // Isolate, so the part stands further out than before and nothing gets
      // quieter. See focusGain for the limits.
      //
      // HOW LOUD A MIX IS, FROM ITS NOTES
      //
      // Matching the knob settings alone was not enough. Measured on 2026-09-27
      // with tests/solo-loudness.spec.ts, that left Hineh Ma Tov's Soprano 1
      // 5.5 dB under the full mix and Ring Out, Wild Bells' sopranos 6 dB under,
      // for two reasons a knob cannot see:
      //
      //   Register. Every part plays the same Salamander piano, and its upper
      //   samples put out far less sound: a full-length C5 has about half the
      //   energy of a C3. src/lib/piano-sample-energy.json holds each sample's
      //   energy over time, measured by scripts/measure-piano-sample-energy.mjs.
      //
      //   Doubling. Two parts on the same pitch at the same moment play the same
      //   sample, so the waveforms are identical and their amplitudes add, which
      //   is twice the energy of two different notes. Hineh Ma Tov doubles
      //   constantly, which made its full mix louder than a power sum said.
      //
      // So loudnessOf groups the notes of every part by (start tick, pitch). In
      // a group, amplitudes add for as long as the shortest note lasts, and each
      // longer note's tail adds by power. Groups add to one another by power.
      const DUCKED = 0.18;
      function currentGains() {
        const base = song.parts.map((_, i) => (enabled[i] ? (levels[i] ?? 0.8) : 0));
        return gainsWithFocus(base, focusedTrack, focusMode);
      }

      function gainsWithFocus(base, track, mode) {
        if (track === null) return base;
        const out = base.map((v, i) => (i === track ? v : mode === 'iso' ? 0 : v * DUCKED));
        // A focused part that is switched off stays off, as it always did.
        if (base[track] > 0) out[track] = focusGain(base, out, track);
        return out;
      }

      // Never below 1.0, so no part is ever quieter soloed than it was before
      // this change. Never above FOCUS_MAX, so a part with almost no notes in
      // it is not pushed to a level that clips; the spec measures the peaks.
      const FOCUS_MAX = 4.0;

      // The gain g for the focused part that makes the predicted loudness of
      // this mix equal the full mix's. With every other gain fixed, one group's
      // energy is a quadratic in g, so the whole mix is A·g² + 2B·g + C, and g
      // is its positive root.
      function focusGain(base, out, track) {
        const model = loudnessOf();
        if (!model) return 1.0;
        // Over the loop when one is set, because that is what the singer is
        // hearing; over the whole piece otherwise. Balancing the whole piece
        // while a loop played left Ring Out, Wild Bells' sopranos 3.6 dB under
        // in mm. 40-56, and measuring the loop brought that to 0.9 dB.
        const [lo, hi] = loopEnabled && loopEndTk > loopStartTk ? [loopStartTk, loopEndTk] : [-Infinity, Infinity];
        const full = model.energy(base, lo, hi);
        let A = 0, B = 0, C = 0;
        for (const grp of model.groups) {
          if (grp.at < lo || grp.at >= hi) continue;
          let a = 0, tailF = 0, b = 0, tailO = 0;
          for (const n of grp.notes) {
            if (n.part === track) { a += n.vel; tailF += n.vel * n.vel * n.tail; }
            else { const amp = out[n.part] * n.vel; b += amp; tailO += amp * amp * n.tail; }
          }
          A += a * a * grp.e0 + tailF;
          B += a * b * grp.e0;
          C += b * b * grp.e0 + tailO;
        }
        if (!(A > 0)) return 1.0;
        const disc = B * B - A * (C - full);
        const g = disc > 0 ? (-B + Math.sqrt(disc)) / A : 1.0;
        return Math.min(FOCUS_MAX, Math.max(1.0, g));
      }

      const SAMPLE_MIDIS = Object.keys(PIANO_ENERGY.energy).map(Number).sort((x, y) => x - y);
      const RELEASE_SEC = 0.1;   // Tone.Sampler's default release
      // Energy of one note at velocity 1: the sample Tone.Sampler would pick
      // (the nearest one), over as long as the note sounds.
      function noteEnergy(midi, sec) {
        let near = SAMPLE_MIDIS[0];
        for (const m of SAMPLE_MIDIS) if (Math.abs(m - midi) < Math.abs(near - midi)) near = m;
        const cum = PIANO_ENERGY.energy[near];
        const t = Math.max(0, sec + RELEASE_SEC) / PIANO_ENERGY.step;   // cum[k] is at k + 1 steps
        if (t <= 1) return cum[0] * t;
        const k = Math.floor(t) - 1;
        if (k >= cum.length - 1) return cum[cum.length - 1];
        return cum[k] + (cum[k + 1] - cum[k]) * (t - 1 - k);
      }

      // Built once per piece. focusGain reads it over the current loop or the
      // whole piece. Null until the MIDI has loaded, and focusGain then falls
      // back to 1.0.
      let loudnessModel = null;
      function loudnessOf() {
        if (loudnessModel) return loudnessModel;
        if (!midiData.length) return null;
        const byKey = new Map();
        midiData.forEach((m, part) => m.tracks.forEach(tr => tr.notes.forEach(n => {
          const key = `${n.ticks}:${n.midi}`;
          if (!byKey.has(key)) byKey.set(key, []);
          byKey.get(key).push({ part, vel: n.velocity, midi: n.midi, sec: n.duration, tick: n.ticks, ppq: m.header.ppq });
        })));
        const groups = [...byKey.values()].map(list => {
          const e0 = noteEnergy(list[0].midi, Math.min(...list.map(n => n.sec)));
          // Start in the player's own ticks, for measuring over a loop.
          const at = (list[0].tick / list[0].ppq) * Tone.Transport.PPQ;
          return { e0, at, notes: list.map(n => ({ part: n.part, vel: n.vel, tail: noteEnergy(n.midi, n.sec) - e0 })) };
        });
        const energy = (gains, fromTk = -Infinity, toTk = Infinity) => groups.reduce((sum, grp) => {
          if (grp.at < fromTk || grp.at >= toTk) return sum;
          let amp = 0, tail = 0;
          for (const n of grp.notes) { const a = gains[n.part] * n.vel; amp += a; tail += a * a * n.tail; }
          return sum + amp * amp * grp.e0 + tail;
        }, 0);
        loudnessModel = { groups, energy };
        return loudnessModel;
      }

      function applyGains() {
        const gains = currentGains();
        channels.forEach((ch, i) => {
          ch.volume.value = gains[i] <= 0 ? -Infinity : Tone.gainToDb(gains[i]);
        });
      }

      function syncFocusUI() {
        const focused = focusedTrack !== null;
        focusBtns.forEach((b, j) => b.classList.toggle('is-focused', focusedTrack === j && focusMode === 'solo'));
        isoBtns.forEach((b, j) => b.classList.toggle('is-focused', focusedTrack === j && focusMode === 'iso'));
        trackRows.forEach((r, j) => r.classList.toggle('pp-dimmed', focused && focusedTrack !== j));
        knobs.forEach((knob, i) => {
          const origLevel = savedLevels[i] ?? levels[i] ?? 0.8;
          let displayPct;
          if (!focused) displayPct = Math.round((levels[i] ?? 0.8) * 100);
          else if (i === focusedTrack) displayPct = 100;
          else displayPct = focusMode === 'iso' ? 0 : Math.round(origLevel * 18);
          knob.set(displayPct);
          knob.setDisabled(focused && i !== focusedTrack);
        });
      }

      function setFocus(trackIdx, mode) {
        if (focusedTrack === trackIdx && focusMode === mode) { clearFocus(); return; }
        if (focusedTrack === null) savedLevels = levels.slice();
        focusedTrack = trackIdx; focusMode = mode;
        syncFocusUI(); applyGains(); drawWave();
      }

      function clearFocus() {
        focusedTrack = null; focusMode = null; savedLevels = [];
        syncFocusUI(); applyGains(); drawWave();
      }

      function updatePlayIcon() {
        playBtn.classList.toggle('is-playing', playing);
        miniPlay.classList.toggle('is-playing', playing);
      }

      function draw() {
        const frac = Math.min(1, Tone.Transport.ticks / lastTickTone);
        fillEl.style.width = (frac * 100) + '%';
        headEl.style.left = (frac * 100) + '%';
        const mi = Math.min(totalMeasures - 1, measureAt(Tone.Transport.ticks));
        const m = printedAt(mi);
        const beat = beatAt(Tone.Transport.ticks);
        const label = measureBeat(Tone.Transport.ticks);
        // On a repeated block, say which time through this is. It goes on its
        // own line so the measure number keeps its size.
        const passes = passesOf[mi] || 1;
        const pass = passes > 1 ? `${ordinal(passOf[mi])} of ${passes}` : '';
        measureEl.textContent = label;
        if (pass) {
          const tag = document.createElement('span');
          tag.className = 'pp-pass';
          tag.textContent = pass;
          measureEl.appendChild(tag);
        }
        const spoken = m < 1 ? `Pickup, beat ${beat}` : `Measure ${m}, beat ${beat}`;
        measureEl.setAttribute('aria-label',
          pass ? `${spoken}, ${pass} times through` : spoken);
        miniMeasure.textContent = pass ? `${label} (${pass})` : label;
        trackEl.setAttribute('aria-valuenow', Math.round(frac * 100));
        // Both ends come from the tempo map. Tone's own tick-to-second
        // conversion uses whatever tempo is running now, which reads the whole
        // of Ring Out, Wild Bells at its seven-bar opening tempo.
        timeEl.textContent = `${fmt(ticksToSec(Tone.Transport.ticks))} / ${fmt(ticksToSec(lastTickTone))}`;
        drawWave();
        updateFollow();
        updateWords(m);
      }

      // ---- Score view + following dot (driven by measure/beat, so tempo-independent) ----
      async function loadSync() {
        if (!song.syncXml) return;
        try {
          const r = await fetch(song.syncXml);
          if (!r.ok) return;
          const doc = new DOMParser().parseFromString(await r.text(), 'application/xml');
          xmlDpi = parseInt(doc.querySelector('dpi')?.textContent || '150', 10);
          systemsById = {};
          doc.querySelectorAll('system').forEach(s => {
            systemsById[s.getAttribute('id')] = {
              page: +s.getAttribute('page'),
              y0: +s.getAttribute('y0'), y1: +s.getAttribute('y1'),
            };
          });
          syncNotes = Array.from(doc.querySelectorAll('note')).map(n => ({
            measure: +n.getAttribute('measure'),
            beat: parseFloat(n.getAttribute('beat')) || 1,
            page: +n.getAttribute('page'),
            x: +n.getAttribute('x_pos'),
            sys: n.getAttribute('system_id'),
          })).filter(n => n.x >= 0).sort((a, b) => (a.measure - b.measure) || (a.beat - b.beat));
          // pos = measure number + fraction of the way through that measure
          // (uses the actual bar length, which can vary with meter changes).
          // The sync XML is keyed to the printed score, so a bar length has to
          // be looked up through the same translation the readout uses.
          syncNotes.forEach(n => { n.pos = n.measure + (n.beat - 1) / barQuarters(firstPlayed(n.measure) + 1); });
        } catch (e) { console.warn('[MIDI] sync XML failed', e); }
      }

      // ---- Score-follow from the library's measure map ----------------
      // /members/follow/<id>.json (built by scripts/build-score-follow.ts from
      // the score reader's output) says, for every printed measure number,
      // which PDF page it is on and where on that page, as fractions of the
      // page; and carries the words with a measure and a beat each.
      //
      // The map is trusted only when it describes the same piece as the MIDI:
      // the same run of printed measures. A reader that dropped a bar produces
      // a map whose numbers drift from the page, and a box on the wrong bar is
      // worse than no box. Same policy as the repeat-map check above: fall
      // back, and say why in the console.
      async function loadFollow() {
        if (!song.follow) return;
        try {
          const r = await fetch(song.follow, { headers: { accept: 'application/json' } });
          // The gate answers an expired session with the login page, not JSON.
          if (!r.ok || !/json/.test(r.headers.get('content-type') || '')) return;
          const map = await r.json();
          if (!map || !map.measures) return;
          const lowest = 1 - pickupBars;
          const count = printedTotal - lowest + 1;
          if (map.measureCount !== count || map.firstMeasure !== lowest) {
            followOff = `the score map holds measures ${map.firstMeasure}–${map.lastMeasure} (${map.measureCount}) ` +
              `and the MIDI ${lowest}–${printedTotal} (${count})`;
            if (!followPreview) {
              console.warn(`[MIDI] ${song.title}: ${followOff}. Score follow is off; fix the score in /scores and rebuild the map.`);
              return;
            }
            console.warn(`[MIDI] ${song.title}: ${followOff}. Preview: following it anyway.`);
          }
          followMap = map.measures;
          followPages = map.pages || null;
          // The words: every voice's syllables laid over one another. The
          // reader drops syllables, so the map says how many measures have
          // any words at all; under six in ten, the strip would show a word
          // here and there and mislead more than it helps, so it stays off.
          const ly = map.lyrics;
          const syllables = ly && (ly.merged || (ly.parts && ly.parts[ly.defaultPart ?? 0]?.syllables)) || [];
          const coverage = ly ? (ly.coverage ?? 1) : 0;
          const wantWords = song.words || followPreview;
          if (wantWords && syllables.length && coverage < 0.6 && !followPreview) {
            console.info(`[MIDI] ${song.title}: words are in ${Math.round(coverage * 100)}% of the measures; the words strip stays off.`);
          }
          if (wantWords && syllables.length && (coverage >= 0.6 || followPreview)) {
            // One line per measure, joined the way the page prints them: a
            // hyphen after a syllable that carries on ("Ma-ry's"), a space
            // after a whole word.
            wordsByMeasure = new Map();
            for (const s of syllables) {
              const cont = s.syllabic === 'begin' || s.syllabic === 'middle';
              wordsByMeasure.set(s.m, (wordsByMeasure.get(s.m) || '') + s.text + (cont ? '-' : ' '));
            }
            for (const [k, v] of wordsByMeasure) wordsByMeasure.set(k, v.replace(/\s+/g, ' ').trim());
            // Place every syllable on the played timeline. A printed measure
            // that sounds twice (a repeat) gets its words twice; the pickup
            // bar is printed measure 0, as everywhere else in the player.
            const byM = new Map();
            for (const s of syllables) (byM.get(s.m) ?? byM.set(s.m, []).get(s.m)).push(s);
            wordEvents = [];
            for (let i = 0; i < totalMeasures; i++) {
              const list = byM.get(printedAt(i));
              if (!list) continue;
              for (const s of list) {
                const cont = s.syllabic === 'begin' || s.syllabic === 'middle';
                wordEvents.push({ beat: barStarts[i] / Tone.Transport.PPQ + (s.beat - 1), text: s.text + (cont ? '-' : '') });
              }
            }
            wordEvents.sort((a, b) => a.beat - b.beat);
          }
        } catch (e) { console.warn('[MIDI] follow map failed', e); }
      }

      // The box for the bar that is sounding, and how far through it we are.
      // A bar split over a system break has two boxes: the first half of the
      // bar lights the first, the second half the second.
      function currentBox() {
        if (!followMap || !Tone) return null;
        const tk = Tone.Transport.ticks;
        const mi = measureAt(tk);
        const m = printedAt(mi);
        const boxes = followMap[m];
        if (!boxes || !boxes.length) return null;
        const frac = Math.max(0, Math.min(1, (tk - barStarts[mi]) / Math.max(1, barStarts[mi + 1] - barStarts[mi])));
        const k = Math.min(boxes.length - 1, Math.floor(frac * boxes.length));
        return { m, page: boxes[k].pdfPage, box: boxes[k], frac: frac * boxes.length - k };
      }

      function positionBox() {
        if (!boxEl) return;
        const cur = currentBox();
        // A page whose staves the map could not sort into systems is marked
        // doubtful: the page still turns, but no box is drawn there.
        if (!followOn || !cur || cur.box.doubt || cur.box.y0 === null || (cur.page + 1) !== displayedPage) {
          boxEl.style.display = 'none';
          partBands.forEach(d => { d.style.display = 'none'; });
          renderSystemLoopBtn();
          return;
        }
        const W = sheetCanvas.clientWidth, H = sheetCanvas.clientHeight;
        if (!W || !H) { boxEl.style.display = 'none'; return; }
        const b = cur.box;
        boxEl.style.left = (b.x0 * W) + 'px';
        boxEl.style.top = (b.y0 * H) + 'px';
        boxEl.style.width = Math.max(4, (b.x1 - b.x0) * W) + 'px';
        boxEl.style.height = Math.max(4, (b.y1 - b.y0) * H) + 'px';
        if (beatEl) beatEl.style.left = (cur.frac * 100) + '%';
        // Keep measuring even when the box is hidden. The page still turns and
        // the system still centres, and "Loop this line" still knows which bars
        // it would loop — a singer who dislikes the moving mark did not ask to
        // lose the rest of the follow.
        boxEl.style.display = boxOn ? 'block' : 'none';
        if (bandOn) positionPartBands(cur, W, H);
        else partBands.forEach(d => { d.style.display = 'none'; });
        // When the music moves to another system, bring that system to the
        // middle of the screen. A page is taller than a phone, and the box
        // used to slide off the bottom while the singer was still looking
        // at the top (Howie, 2026-09-16). Once per system, so a singer who
        // scrolls away to read ahead is not dragged back every frame.
        const key = `${cur.page}/${b.system}`;
        if (key !== boxSystemKey) {
          boxSystemKey = key;
          centreBox(b, H);
        }
        renderSystemLoopBtn();
      }

      // ---- "Loop this line": drill the row of music on the screen ---------
      // The map holds the first and last printed measure of every system, so
      // the box already names a passage. This makes it the loop, without the
      // singer punching two presses or typing two measure numbers. Row 16 of
      // docs/UserFlow.md.
      //
      // The range is THIS pass of the system, not every pass of it. A system
      // inside a repeated block sounds twice, and firstPlayed/lastPlayed — the
      // rule a typed range and a rehearsal link follow — would stretch the
      // loop from the first pass of the row to the last and carry the whole
      // repeat in between. That is twenty bars where the singer asked for
      // four. So the walk starts at the playhead and stops where the printed
      // numbers stop climbing, which is exactly where a repeat jumps back.
      function systemLoopRange() {
        if (!loaded || !followOn || !followPages || !Tone) return null;
        const cur = currentBox();
        if (!cur) return null;
        const pg = followPages[cur.page];
        const sys = pg && pg.systems && pg.systems[cur.box.system];
        if (!sys || typeof sys.first !== 'number' || typeof sys.last !== 'number') return null;
        const mi = Math.min(totalMeasures - 1, measureAt(Tone.Transport.ticks));
        const inSys = i => i >= 0 && i < totalMeasures
          && printedAt(i) >= sys.first && printedAt(i) <= sys.last;
        if (!inSys(mi)) return null;
        let a = mi, b = mi;
        while (inSys(a - 1) && printedAt(a - 1) <= printedAt(a)) a--;
        while (inSys(b + 1) && printedAt(b + 1) >= printedAt(b)) b++;
        return { a, b, page: cur.page, first: printedAt(a), last: printedAt(b) };
      }

      // A loop is this row when both of its edges are the row's own bar lines.
      const loopIsRange = r =>
        loopEnabled && loopStartTk === barStarts[r.a] && loopEndTk === barStarts[r.b + 1];

      // The label names the measures, not the system, because the measures are
      // what the page prints and what the director says in the hall. The
      // pickup bar has no number, so it is named in words.
      // "mm." is in a span of its own because a 390px phone has room for the
      // numbers but not for the abbreviation: the bar also carries the page
      // counter, the follow switch, "My part" and the X, and a third line of
      // sticky bar is score the phone stops showing. The spoken label below
      // says "measure 19 to measure 22" either way.
      function loopSysText(r, running) {
        const verb = running ? 'Looping' : 'Loop';
        if (r.first === r.last) {
          return r.first < 1 ? `${verb} the pickup` : `${verb} <span class="pp-mm">m. </span>${r.first}`;
        }
        if (r.first < 1) return `${verb} the pickup to <span class="pp-mm">m. </span>${r.last}`;
        return `${verb} <span class="pp-mm">mm. </span>${r.first}\u2013${r.last}`;
      }

      // The button is only on the screen while the row it names is, so it can
      // never loop music the singer cannot see: no map, follow switched off, a
      // system the map is unsure of, or a page turn still in flight all take
      // it away again.
      function renderSystemLoopBtn() {
        if (!loopSysBtn) return;
        const r = systemLoopRange();
        if (!r || (r.page + 1) !== displayedPage) {
          loopSysBtn.style.display = 'none';
          return;
        }
        const running = loopIsRange(r);
        loopSysBtn.style.display = 'inline-block';
        loopSysBtn.innerHTML = loopSysText(r, running);
        loopSysBtn.classList.toggle('is-active', running);
        loopSysBtn.setAttribute('aria-pressed', String(running));
        loopSysBtn.setAttribute('aria-label', running
          ? `Stop looping ${r.first < 1 ? 'the pickup' : `measure ${r.first}`} to measure ${r.last}`
          : `Loop ${r.first < 1 ? 'the pickup' : `measure ${r.first}`} to measure ${r.last}`);
        loopSysBtn.title = running
          ? 'Press again to let the music carry on'
          : 'Repeat these measures until you press it again';
      }

      // ---- "My part": pick out the singer's staff inside the box ----------
      // The map gives each system's staff rows. What each staff IS comes from
      // the anchors file for the scores labelled system by system (Ring Out),
      // and from the season list's layouts by staff count for the rest. A
      // system with no labels for its staff count gets the whole-system box
      // and no band, which is right rather than a guess.
      function staffLabelsFor(sys) {
        if (!sys || !sys.staves) return null;
        if (sys.labels && sys.labels.length === sys.staves.length) return sys.labels;
        const lay = song.staves && song.staves[sys.staves.length];
        return Array.isArray(lay) && lay.length === sys.staves.length ? lay : null;
      }
      function partOptionsAvailable() {
        if (!followMap || !followPages) return false;
        if (song.staves && Object.keys(song.staves).length) return true;
        return followPages.some(p => p.systems.some(sy => sy.labels));
      }
      function buildPartPicker() {
        if (!partWrap || !partSel) return;
        const voices = voiceParts(song.parts);
        if (!partOptionsAvailable() || !voices.length) { partWrap.style.display = 'none'; return; }
        partSel.innerHTML = '';
        const none = document.createElement('option');
        none.value = ''; none.textContent = 'none';
        partSel.appendChild(none);
        for (const p of voices) {
          const o = document.createElement('option');
          o.value = p.label; o.textContent = p.label;
          partSel.appendChild(o);
        }
        // Remembered across songs: the exact label when this song has it,
        // else the first part of the same family ("Alto" remembered, this
        // song has "Alto 1" and "Alto 2": Alto 1).
        let saved = null;
        try { saved = localStorage.getItem(MY_PART_KEY); } catch {}
        let pick = '';
        if (saved) {
          if (voices.some(p => p.label === saved)) pick = saved;
          else {
            const fam = partTokens(saved).slice(-1)[0];
            const same = voices.find(p => partTokens(p.label).slice(-1)[0] === fam);
            if (same) pick = same.label;
          }
        }
        partSel.value = pick;
        myPart = pick || null;
        partWrap.style.display = '';
        partSel.addEventListener('change', () => {
          myPart = partSel.value || null;
          try {
            if (myPart) localStorage.setItem(MY_PART_KEY, myPart);
            else localStorage.removeItem(MY_PART_KEY);
          } catch {}
          // Repaint, not just reposition: the overlay takes the colour of the
          // part now chosen, matching that part's channel row.
          applyScoreOptions();
        });
      }
      // ---- The options panel ---------------------------------------------
      if (scoreOptsBtn && scoreOptsEl) {
        scoreOptsBtn.addEventListener('click', () => {
          const open = scoreOptsEl.hidden;
          scoreOptsEl.hidden = !open;
          scoreOptsBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      }
      if (optBoxEl) {
        optBoxEl.addEventListener('change', () => {
          boxOn = optBoxEl.checked;
          writePref(BOX_KEY, boxOn ? '1' : '0');
          applyScoreOptions();
        });
      }
      if (optBandEl) {
        optBandEl.addEventListener('change', () => {
          bandOn = optBandEl.checked;
          writePref(BAND_KEY, bandOn ? '1' : '0');
          applyScoreOptions();
        });
      }
      if (optAlphaEl) {
        // 'input', so the score answers while the slider is still moving and a
        // singer can settle on a strength by eye instead of by guessing.
        optAlphaEl.addEventListener('input', () => {
          const n = parseInt(optAlphaEl.value, 10);
          overlayAlpha = Number.isFinite(n) ? n : 100;
          if (optAlphaOut) optAlphaOut.textContent = `${overlayAlpha}%`;
          if (sheetSection) sheetSection.style.setProperty('--pp-ov-a', String(overlayAlpha / 100));
        });
        optAlphaEl.addEventListener('change', () => writePref(ALPHA_KEY, String(overlayAlpha)));
      }
      applyScoreOptions();

      // Draw one band per staff the singer's part sings from, inside the
      // current measure box. Bands are made on demand and hidden when unused.
      function positionPartBands(cur, W, H) {
        const wrap = sheetCanvas.parentElement;
        const sys = followPages && followPages.find(p => p.pdfPage === cur.page)?.systems?.[cur.box.system];
        const labels = myPart ? staffLabelsFor(sys) : null;
        const idx = labels ? stavesFor(myPart, labels) : [];
        while (partBands.length < idx.length) {
          const d = document.createElement('div');
          d.className = 'pp-follow-part';
          wrap.appendChild(d);
          partBands.push(d);
        }
        partBands.forEach((d, k) => {
          if (k >= idx.length) { d.style.display = 'none'; return; }
          const [t, b] = sys.staves[idx[k]];
          const h = b - t;
          // Half a staff above for the notes over the top line, a staff below
          // for the words; never past the system's own box.
          const y0 = Math.max(cur.box.y0, t - h * 0.5), y1 = Math.min(cur.box.y1, b + h * 1.0);
          d.style.left = (cur.box.x0 * W) + 'px';
          d.style.width = Math.max(4, (cur.box.x1 - cur.box.x0) * W) + 'px';
          d.style.top = (y0 * H) + 'px';
          d.style.height = Math.max(4, (y1 - y0) * H) + 'px';
          d.style.display = 'block';
        });
      }

      function centreBox(b, H) {
        // From the map's numbers, not the box's rectangle: the box slides to
        // its new place over 120 ms, and reading it now would centre where
        // it was, not where it is going.
        const canvas = sheetCanvas.getBoundingClientRect();
        if (!canvas.height) return;
        const middle = canvas.top + ((b.y0 + b.y1) / 2) * H;
        const target = window.scrollY + middle - window.innerHeight / 2;
        const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: Math.max(0, target), behavior: smooth ? 'smooth' : 'auto' });
      }

      // The words of the bar that is sounding, shown while the score is
      // hidden. Rebuilt only when the bar changes; draw() runs every frame.
      // Off until a singer asks for it. The words are an aid for the few who
      // want them, not a thing every singer has to look past, and the choice
      // carries across songs because a singer who wants words wants them on
      // the next piece too. localStorage throws in a private window, so a
      // failure to remember means the button simply starts off again.
      const WORDS_KEY = 'ss:practice-words';
      let wordsOn = (() => {
        try { return localStorage.getItem(WORDS_KEY) === '1'; } catch { return false; }
      })();

      // Where the note lanes start, so the words line up under the music
      // rather than under the part names.
      function alignWordsToLanes() {
        if (!wordsEl || !tracksEl) return;
        const lane = tracksEl.querySelector('.pp-lane');
        if (lane && lane.offsetParent) {
          const r = lane.getBoundingClientRect(), t = tracksEl.getBoundingClientRect();
          wordsEl.style.setProperty('--pp-lane-x', `${Math.round(Math.max(0, r.left - t.left))}px`);
          wordsEl.style.setProperty('--pp-lane-w', `${Math.round(r.width)}px`);
        } else {
          wordsEl.style.setProperty('--pp-lane-x', '0px');
          wordsEl.style.setProperty('--pp-lane-w', '100%');
        }
        drawWords();
      }

      // The words lane: the same 16-beat window and 20% playhead as the note
      // lanes, so a syllable sits under the notes that carry it. Two
      // baselines, because at forty pixels a beat "Christ-" and "child" would
      // otherwise print over each other; a syllable that would overlap the one
      // before it drops to the lower line. The syllable being sung is gold and
      // larger; the ones already sung fade.
      function drawWords() {
        if (!wordsLane || !Tone || !wordsEl || wordsEl.style.display === 'none') return;
        const W = Math.round(wordsLane.clientWidth || wordsLane.getBoundingClientRect().width || 0);
        if (W <= 0) return;
        const dpr = Math.min(2, window.devicePixelRatio || 1);
        const H = 56;
        if (wordsLane.width !== W * dpr) wordsLane.width = W * dpr;
        if (wordsLane.height !== H * dpr) wordsLane.height = H * dpr;
        const ctx = wordsLane.getContext('2d');
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, W, H);
        const curBeat = Tone.Transport.ticks / Tone.Transport.PPQ;
        const wStart = curBeat - WAVE_PLAYHEAD_FRAC * WINDOW_BEATS;
        const pxPerBeat = W / WINDOW_BEATS;
        for (let b = Math.ceil(wStart); b < wStart + WINDOW_BEATS; b++) {
          const x = Math.round((b - wStart) * pxPerBeat);
          ctx.fillStyle = barStartBeats.has(b) ? 'rgba(255,255,255,0.16)' : 'rgba(255,255,255,0.05)';
          ctx.fillRect(x, 0, 1, H);
        }
        // The syllable being sung: the last one that has started.
        let curIdx = -1;
        for (let k = 0; k < wordEvents.length; k++) { if (wordEvents[k].beat <= curBeat + 1e-6) curIdx = k; else break; }
        const rows = [18 + 4, 42 + 4];      // baselines
        const lastRight = [-Infinity, -Infinity];
        ctx.textBaseline = 'alphabetic';
        for (let k = 0; k < wordEvents.length; k++) {
          const ev = wordEvents[k];
          const x = (ev.beat - wStart) * pxPerBeat;
          if (x > W + 80) break;
          const current = k === curIdx;
          ctx.font = current ? '700 19px system-ui, sans-serif' : '600 16px system-ui, sans-serif';
          const w = ctx.measureText(ev.text).width;
          if (x + w < 0) continue;
          const row = x >= lastRight[0] + 6 ? 0 : (x >= lastRight[1] + 6 ? 1 : 0);
          lastRight[row] = x + w;
          ctx.fillStyle = current ? 'rgb(254,240,138)' : (k < curIdx ? 'rgba(161,161,170,0.75)' : 'rgba(228,228,231,0.92)');
          ctx.fillText(ev.text, x + 2, rows[row]);
        }
        ctx.fillStyle = 'rgba(255,255,255,0.6)';
        ctx.fillRect(Math.round(WAVE_PLAYHEAD_FRAC * W), 0, 1, H);
      }

      function renderWordsToggle() {
        if (!wordsToggle) return;
        const have = !!wordsByMeasure;
        wordsToggle.style.display = have ? '' : 'none';
        wordsToggle.classList.toggle('is-active', have && wordsOn);
        wordsToggle.setAttribute('aria-pressed', String(have && wordsOn));
      }

      if (wordsToggle) {
        wordsToggle.addEventListener('click', () => {
          wordsOn = !wordsOn;
          try { localStorage.setItem(WORDS_KEY, wordsOn ? '1' : '0'); } catch {}
          renderWordsToggle();
          lastWordsKey = null;
          alignWordsToLanes();
          updateWords(printedAt(measureAt(Tone ? Tone.Transport.ticks : 0)));
        });
      }

      function updateWords(m) {
        if (!wordsEl) return;
        const show = wordsOn && !!wordsByMeasure
          && (!sheetSection || sheetSection.style.display === 'none');
        const was = wordsEl.style.display !== 'none';
        wordsEl.style.display = show ? '' : 'none';
        if (!show) { lastWordsKey = null; return; }
        // Re-measured on the bar change and when the lane first shows, rather
        // than every frame: the lanes also disappear when the score sidebar
        // opens, which is not a window resize. The lane itself redraws from
        // drawWave every frame the music moves.
        if (lastWordsKey !== m || !was) { lastWordsKey = m; alignWordsToLanes(); }
      }

      function currentNote() {
        if (!syncNotes.length || !Tone) return null;
        const tk = Tone.Transport.ticks;
        const mi = measureAt(tk);
        const posValue = printedAt(mi) + (tk - barStarts[mi]) / Math.max(1, barStarts[mi + 1] - barStarts[mi]);
        let lo = 0, hi = syncNotes.length - 1, ans = -1;
        while (lo <= hi) {
          const mid = (lo + hi) >> 1;
          if (syncNotes[mid].pos <= posValue + 1e-6) { ans = mid; lo = mid + 1; } else hi = mid - 1;
        }
        return ans >= 0 ? syncNotes[ans] : syncNotes[0];
      }

      function positionDot() {
        const cur = currentNote();
        if (!followOn || !cur || (cur.page + 1) !== displayedPage) { dotEl.style.display = 'none'; return; }
        const factor = (72 / xmlDpi) * renderScale;
        const sys = systemsById[cur.sys] || { y0: 0, y1: 0 };
        dotEl.style.left = (cur.x * factor) + 'px';
        dotEl.style.top = (((sys.y0 + sys.y1) / 2) * factor) + 'px';
        dotEl.style.display = 'block';
      }

      function updateFollow() {
        if (!song.sheetPdf || !sheetSection || sheetSection.style.display === 'none') return;
        if (!followOn) return;
        const cur = followMap ? currentBox() : currentNote();
        if (!cur) return;
        const want = cur.page + 1;
        if (want !== displayedPage && !pdfRendering) renderPage(want);
        else if (followMap) positionBox();
        else positionDot();
      }

      async function ensurePdfJs() {
        if (window.pdfjsLib) return;
        await new Promise((res, rej) => {
          const s = document.createElement('script');
          s.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
          s.onload = res; s.onerror = rej; document.head.appendChild(s);
        });
        window.pdfjsLib.GlobalWorkerOptions.workerSrc =
          'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      }

      async function renderPage(num) {
        if (pdfRendering) {
          const n = pdfDoc ? Math.max(1, Math.min(pdfDoc.numPages, num)) : num;
          queuedPage = n; targetPage = n;
          return;
        }
        // Claim the lock synchronously. It used to be set only after the awaits
        // below, so three quick taps all cleared the guard before any of them
        // set it and then raced each other on one canvas — the reason a fast
        // page turn appeared to do nothing.
        pdfRendering = true; dotEl.style.display = 'none';
        if (boxEl) boxEl.style.display = 'none';
        partBands.forEach(d => { d.style.display = 'none'; });
        boxSystemKey = null;
        try {
          await ensurePdfJs();
          if (!pdfDoc) {
            if (sheetLoading) { sheetLoading.textContent = 'Loading score…'; sheetLoading.classList.remove('hidden'); }
            // Fetch the whole file and parse from bytes — pdf.js range-request
            // streaming can misreport numPages on some servers/PDFs.
            try {
              const resp = await fetch(song.sheetPdf);
              if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
              pdfDoc = await window.pdfjsLib.getDocument({ data: await resp.arrayBuffer() }).promise;
            }
            catch (e) { if (sheetLoading) sheetLoading.textContent = 'Could not load score.'; return; }
            if (sheetLoading) sheetLoading.classList.add('hidden');
          }
          num = Math.max(1, Math.min(pdfDoc.numPages, num));
          targetPage = num;
          const page = await pdfDoc.getPage(num);
          const wrap = sheetCanvas.parentElement;
          const maxW = Math.max(200, (wrap.clientWidth || 600) - 4);
          const vp0 = page.getViewport({ scale: 1 });
          // renderScale stays the CSS scale — positionDot() maps score
          // coordinates to CSS pixels with it, so it must not pick up the
          // device-pixel factor below.
          renderScale = maxW / vp0.width;
          // Render at the display's real pixel density. Every page was being
          // rasterised at one bitmap pixel per CSS pixel, so on a 2x screen the
          // browser upscaled it and the staves came out soft — half the reason
          // the music was hard to read was sharpness, not size. Capped at 2 so a
          // 3x phone does not allocate a needlessly huge canvas.
          const dpr = Math.min(2, window.devicePixelRatio || 1);
          const vp = page.getViewport({ scale: renderScale * dpr });
          sheetCanvas.width = Math.round(vp.width);
          sheetCanvas.height = Math.round(vp.height);
          // CSS width:100% scales the denser bitmap back down to maxW.
          await page.render({ canvasContext: sheetCanvas.getContext('2d'), viewport: vp }).promise;

          const turned = displayedPage !== -1 && displayedPage !== num;
          displayedPage = num;
          if (sheetPageInfo) sheetPageInfo.textContent = `Page ${num} / ${pdfDoc.numPages}`;
          if (sheetPrev) sheetPrev.disabled = num <= 1;
          if (sheetNext) sheetNext.disabled = num >= pdfDoc.numPages;
          syncArrows();
          // Turning a page from halfway down leaves you looking at the middle of
          // the next one; bring its top back into view.
          // With a measure map the box centres its own system a moment
          // later, so the page-top scroll would only fight it.
          if (turned && !(followMap && followOn)) {
            const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            sheetSection.scrollIntoView({
              behavior: smooth ? 'smooth' : 'auto', block: 'start',
            });
          }
        } finally {
          pdfRendering = false;
          if (queuedPage !== null) {
            const next = queuedPage; queuedPage = null;
            if (next !== displayedPage) { displayedPage = -1; renderPage(next); }
          }
        }
        positionDot();
        positionBox();
        // A seek that landed while this render held the lock was skipped by
        // updateFollow(). Look again now, so the page the music is on comes
        // up without waiting for the next frame of playback.
        if (queuedPage === null && !pdfRendering) updateFollow();
      }

      if (sheetToggle) {
        sheetToggle.addEventListener('click', async () => {
          const open = sheetSection.style.display === 'none';
          sheetSection.style.display = open ? '' : 'none';
          sheetToggle.textContent = open ? '📄 Hide Score' : '📄 Score';
          sheetToggle.setAttribute('aria-expanded', String(open));
          // Two-column mode: controls become a sticky sidebar beside the score
          if (open) {
            innerEl.classList.add('pp-score-open');
            requestAnimationFrame(syncMiniStrip);
            setTimeout(syncMiniStrip, 250);
            if (resourceList) resourceList.classList.remove('overflow-hidden');
          } else {
            innerEl.classList.remove('pp-score-open');
            if (resourceList) resourceList.classList.add('overflow-hidden');
          }
          if (open) {
            const cur = followMap ? currentBox() : currentNote();
            const target = cur ? cur.page + 1 : Math.max(1, displayedPage);
            displayedPage = -1; // force a re-render at the new layout width
            await renderPage(target);
          }
          // The words strip shows only while the score is hidden.
          if (Tone) updateWords(printedAt(measureAt(Tone.Transport.ticks)));
          requestAnimationFrame(() => drawWave());
        });
        if (sheetClose) sheetClose.addEventListener('click', () => sheetToggle.click());
        sheetPrev.addEventListener('click', () => { followOn = false; if (followChk) followChk.checked = false; renderSystemLoopBtn(); renderPage(targetPage - 1); });
        sheetNext.addEventListener('click', () => { followOn = false; if (followChk) followChk.checked = false; renderSystemLoopBtn(); renderPage(targetPage + 1); });
        if (followChk) followChk.addEventListener('change', () => {
          followOn = followChk.checked;
          if (followOn) updateFollow(); else renderSystemLoopBtn();
        });
      }

      function tick() {
        draw();
        if (!loopEnabled && Tone.Transport.ticks >= lastTickTone) { stopPlayback(); return; }
        raf = requestAnimationFrame(tick);
      }

      // ---- Keeping the audio awake ------------------------------------
      // A browser parks the audio context out from under a player: Safari when
      // another app takes the audio session, when the machine sleeps or when
      // the tab sits in the background, Chrome under its own autoplay rules.
      // The Transport then runs on a clock nobody can hear, and because the
      // Transport is driven BY that clock it stops moving too, so the player
      // shows a frozen measure readout, a button that still reads as playing,
      // and silence. unlockAudio() at module scope is the resume.

      // Say when the sound is asleep, rather than leaving the frozen readout to
      // explain itself.
      //
      // "interrupted" is Safari's own state. It is not in the AudioContext spec
      // and nothing generic checks for it, and it is the one a singer cannot
      // click their way out of: WebKit hands the state back on a fresh context
      // too, so reloading the page does not clear it and only quitting Safari
      // does. A member hit exactly that on 2026-09-15 — the sound stopped, the
      // reload did nothing, restarting Safari brought it back. We cannot fix
      // that from here, so the least we can do is name it.
      function watchAudioState() {
        const ctx = Tone && Tone.getContext ? Tone.getContext() : null;
        if (!ctx || !audioAlert) return;
        const paint = () => {
          const st = ctx.state;
          if (st === 'running') { audioAlert.hidden = true; return; }
          // Stop claiming to play. The button went on showing pause while the
          // readout sat still and nothing came out, so the singer's first
          // press only paused a player that had already stopped, and it took a
          // second press to get any sound. Telling the truth here makes one
          // press enough.
          if (playing) pausePlayback();
          audioAlert.textContent = st === 'interrupted'
            ? 'Safari has put this page\u2019s sound to sleep. Quit Safari and open it again to get it back. Reloading this page will not do it.'
            : 'The sound is asleep. Press play to wake it up.';
          audioAlert.hidden = false;
        };
        // Tone forwards the context's own statechange, so this catches the
        // browser parking it as well as our own resume.
        ctx.on('statechange', paint);
        paint();
      }

      function play() {
        if (!loaded) return;
        unlockAudio();
        Tone.Transport.start();
        playing = true; updatePlayIcon();
        raf = requestAnimationFrame(tick);
      }
      function pausePlayback() {
        if (!Tone) return;
        Tone.Transport.pause();
        samplers.forEach(s => s.releaseAll());
        playing = false; updatePlayIcon();
        if (raf) { cancelAnimationFrame(raf); raf = null; }
      }
      // Reset means back to the top of what you are working on, and with a
      // loop set that is the top of the LOOP, not bar 1 of the piece. Landing
      // on bar 1 sent a singer looping mm. 8-12 through eleven bars they did
      // not ask for before the loop caught, which reads as the loop being
      // broken: "I cannot get to the loop measures without starting the piece
      // from the beginning each time" (members feedback, 2026-09-15).
      //
      // Same rule the two skips below already follow — a loop is a fence.
      function stopPlayback() {
        if (!Tone) return;
        Tone.Transport.stop(); // resets position to 0
        samplers.forEach(s => s.releaseAll());
        playing = false; updatePlayIcon();
        if (raf) { cancelAnimationFrame(raf); raf = null; }
        if (loopEnabled && loopEndTk > loopStartTk) Tone.Transport.ticks = loopStartTk;
        applyBpm(); // the tempo where the playhead now is, opening or loop start
        draw();
      }

      function seekTicks(tk) {
        if (!loaded) return;
        Tone.Transport.ticks = Math.max(0, Math.min(Math.round(tk), lastTickTone));
        applyBpm();
        draw();
      }

      playBtn.addEventListener('click', () => { playing ? pausePlayback() : play(); });
      registerSpaceToPlay({ isOpen: () => !panel.hidden, playButton: playBtn });
      stopBtn.addEventListener('click', () => stopPlayback());
      // Both skips go through the tempo map: fifteen seconds of a fast
      // section is many more bars than fifteen seconds of a slow one.
      //
      // A loop is a fence, so neither skip crosses it. Fifteen seconds
      // forward from near the end of a four-bar loop otherwise lands in music
      // the singer did not ask to hear, and the transport then plays on to
      // the loop end before it jumps back, so the loop looks broken. Both
      // ends land on the loop's start: forward, because reaching the end of
      // a loop means starting it again, and back, because there is nothing
      // before the start to reach.
      const fenceToLoop = tk =>
        (loopEnabled && loopEndTk > loopStartTk && (tk >= loopEndTk || tk < loopStartTk))
          ? loopStartTk : tk;
      const skipBy = secs => {
        if (!loaded) return;
        seekTicks(fenceToLoop(secToTicks(ticksToSec(Tone.Transport.ticks) + secs)));
      };
      skipBackBtn.addEventListener('click', () => skipBy(-15));
      skipFwdBtn.addEventListener('click', () => skipBy(15));

      // Roll the wheel over the measure readout to move a bar at a time. The
      // 15s skips are for covering ground and the progress bar is for jumping;
      // neither lands on a bar line, which is what a singer wants when they are
      // working a passage. It moves whole bars, so it always lands on beat 1.
      function seekMeasures(delta) {
        if (!loaded) return;
        const mi = Math.min(totalMeasures - 1, measureAt(Tone.Transport.ticks));
        const to = Math.max(0, Math.min(totalMeasures - 1, mi + delta));
        seekTicks(fenceToLoop(barStarts[to]));
      }
      // A mouse notch sends about 100 and a trackpad sends a stream of small
      // deltas, so the wheel is accumulated to a threshold rather than read per
      // event, and one event never moves more than a bar. Flipping direction
      // clears the running total, or a reversal waits out the leftovers.
      function wheelScrub(el) {
        let acc = 0;
        el.addEventListener('wheel', e => {
          if (!loaded) return;
          e.preventDefault();
          const d = e.deltaY || e.deltaX;
          if (!d) return;
          if (acc && Math.sign(d) !== Math.sign(acc)) acc = 0;
          acc += d;
          if (Math.abs(acc) < 60) return;
          acc = 0;
          seekMeasures(d > 0 ? 1 : -1);
        }, { passive: false });
      }
      wheelScrub(measureEl);
      wheelScrub(miniMeasure);

      // Set when a loop marker has just been pressed or dragged. The markers
      // are children of the track, and their mousedown calls stopPropagation,
      // but `click` is a separate event that bubbles anyway: releasing a marker
      // therefore also seeks the playhead to the pixel under the pointer. That
      // used to be invisible, because the drag put the loop start at that same
      // raw pixel. Now the loop start snaps to a beat and the click does not,
      // so the playhead landed a beat short of the loop it had just set.
      let swallowTrackClick = false;
      trackEl.addEventListener('click', e => {
        if (!loaded) return;
        if (swallowTrackClick) { swallowTrackClick = false; return; }
        const frac = (e.clientX - trackEl.getBoundingClientRect().left) / trackEl.offsetWidth;
        seekTicks(Math.max(0, Math.min(1, frac)) * lastTickTone);
      });

      // ---- A-B loop (stored in ticks, so it survives tempo changes) ----
      // ticksToSec and secToTicks live with the tempo map above.
      // A loop has to be at least a second of music long. Measured at the
      // opening tempo, which is close enough for a guard rail and does not
      // move when the loop is dragged into a faster section.
      // One beat, now that every loop edge is a beat. The rule used to be one
      // second at the OPENING tempo, which is the wrong length everywhere the
      // tempo changes.
      const minGapTk = () => Tone.Transport.PPQ;

      function applyLoopToTransport() {
        if (!Tone || !loaded) return;
        // A soloed part is balanced against the loop, so a new loop needs a new
        // level for it.
        if (focusedTrack !== null) applyGains();
        if (loopTempoId !== null) { Tone.Transport.clear(loopTempoId); loopTempoId = null; }
        if (loopEnabled && loopEndTk > loopStartTk) {
          Tone.Transport.setLoopPoints(`${loopStartTk}i`, `${loopEndTk}i`);
          Tone.Transport.loop = true;
          // A loop that spans a tempo change comes back round to a bar that
          // belongs to the earlier tempo, and the change inside the loop has
          // already fired. Re-apply the tempo of the loop's first bar on every
          // pass, so the second time through sounds like the first.
          const seg = tempoMap[tempoIndexAt(loopStartTk)];
          loopTempoId = Tone.Transport.schedule(time => {
            Tone.Transport.bpm.setValueAtTime(seg.bpm * tempoRate(), time);
          }, `${loopStartTk}i`);
        } else {
          Tone.Transport.loop = false;
        }
      }

      // The printed address of a loop edge, in the shortest spelling that is
      // still exact. A punched-in loop has both edges on bar lines, where the
      // beat is always 1 and printing it is noise: the box says "33". An edge
      // a drag or a typed "33 · 2" left inside a bar keeps its beat, and a bar
      // inside a repeat keeps its pass. So the boxes stay quiet on the common
      // case without losing anything on the exact one.
      const edgeText = (tk, onBarLine) =>
        onBarLine ? mbText(tk).replace(/ · \d+/, '') : mbText(tk);

      // Same rule, spoken rather than boxed: "m. 33", or "m. 33 · 2".
      const loopAddress = tk => {
        const mi = Math.min(totalMeasures - 1, measureAt(tk));
        const m = printedAt(mi);
        const head = m < 1 ? 'the pickup' : `m. ${m}`;
        return tk === barStarts[mi] ? head : `${head} · ${beatAt(tk)}`;
      };

      // Write both loop boxes from the loop itself.
      //
      // Without `force`, neither write touches a box the singer is typing in:
      // updateLoopMarkers runs on every frame of a marker drag, and rewriting
      // under the cursor would fight the typing. The cost of that guard was
      // that a box kept whatever was typed into it — "12" stayed "12" instead
      // of settling to "12 · 3" — because nothing else ever rewrote it. So a
      // commit forces the write; see the handlers below.
      //
      // The end box is INCLUSIVE. It names the last measure the loop plays, so
      // "33 → 40" plays all of m. 40. loopEndTk is where the bar after it
      // begins, so step back a tick to name that measure.
      function writeLoopBoxes(force) {
        const sMi = Math.min(totalMeasures - 1, measureAt(loopStartTk));
        const eTk = Math.max(loopStartTk, loopEndTk - 1);
        const eMi = Math.min(totalMeasures - 1, measureAt(eTk));
        if (force || document.activeElement !== loopStartEl) {
          loopStartEl.value = edgeText(loopStartTk, loopStartTk === barStarts[sMi]);
        }
        if (force || document.activeElement !== loopEndEl) {
          loopEndEl.value = edgeText(eTk, loopEndTk === barStarts[eMi + 1]);
        }
        // "118 (2nd)" does not fit a box sized for "118", and most scores
        // never show a pass at all, so the width follows the value.
        loopStartEl.classList.toggle('has-pass', loopStartEl.value.includes('('));
        loopEndEl.classList.toggle('has-pass', loopEndEl.value.includes('('));
      }

      function updateLoopMarkers() {
        const startPct = (loopStartTk / lastTickTone) * 100;
        const endPct = (loopEndTk / lastTickTone) * 100;
        loopStartMk.style.left = `${startPct}%`;
        loopEndMk.style.left = `${endPct}%`;
        loopRegion.style.left = `${startPct}%`;
        loopRegion.style.width = `${endPct - startPct}%`;
        // The boxes carry printed measures and beats, not bars of the file and
        // not seconds. Seconds were the fault: fmt floors to the whole second
        // and parseTime read that back, so every trip through a box walked the
        // loop earlier and there was no typing your way back to a bar line.
        writeLoopBoxes(false);
        if (loopMeasuresEl) {
          // How long the passage is, in the two units a singer checks it in:
          // measures, because that is what they asked for, and time, because
          // that is how long they will be in there.
          //
          // Printed measures, not bars of the file. A loop over mm. 113-128 of
          // a score with a 3x block inside it is sixteen measures and far more
          // than sixteen bars of audio; sixteen is the number the director
          // said. Printed numbers run backwards across a repeat jump, so a
          // loop that straddles one floors at a single measure rather than
          // reporting a negative count.
          const printedOfTk = tk => printedAt(Math.min(totalMeasures - 1, measureAt(tk)));
          const bars = Math.max(1,
            printedOfTk(Math.max(loopStartTk, loopEndTk - 1)) - printedOfTk(loopStartTk) + 1);
          loopMeasuresEl.textContent =
            `${bars} bar${bars === 1 ? '' : 's'} · ${fmt(ticksToSec(loopEndTk) - ticksToSec(loopStartTk))}`;
        }
        updateStepButtons();
      }

      // A step is refused rather than clamped, so a press that would shrink the
      // loop past one beat or run off either end of the piece does nothing and
      // the button shows itself as spent.
      function canStep(edge, delta) {
        if (!loaded || !loopEnabled) return false;
        if (edge === 'start') {
          const mi = Math.min(totalMeasures - 1, measureAt(loopStartTk));
          const from = (delta < 0 && loopStartTk > barStarts[mi]) ? mi + 1 : mi;
          const want = from + delta;
          if (want < 0 || want > totalMeasures - 1) return false;
          return barStarts[want] <= loopEndTk - minGapTk();
        }
        const me = Math.min(totalMeasures - 1, measureAt(Math.max(loopStartTk, loopEndTk - 1)));
        const want = me + 1 + delta;
        if (want < 1 || want > totalMeasures) return false;
        return barStarts[want] >= loopStartTk + minGapTk();
      }

      function updateStepButtons() {
        for (const b of stepBtns) b.disabled = !canStep(b.dataset.edge, Number(b.dataset.delta));
      }

      // One press moves one bar of the file. The edges are ticks, so this works
      // out which bar an edge sits in, moves that, and writes the bar line back
      // — which also straightens an edge a drag left mid-bar.
      function stepEdge(edge, delta) {
        if (!canStep(edge, delta)) return;
        if (edge === 'start') {
          const mi = Math.min(totalMeasures - 1, measureAt(loopStartTk));
          // A start left mid-bar steps back to its own bar line first. That is
          // what "one measure earlier" means from where the singer sees it.
          const from = (delta < 0 && loopStartTk > barStarts[mi]) ? mi + 1 : mi;
          loopStartTk = barStarts[from + delta];
        } else {
          const me = Math.min(totalMeasures - 1, measureAt(Math.max(loopStartTk, loopEndTk - 1)));
          loopEndTk = barStarts[me + 1 + delta];
        }
        updateLoopMarkers(); writeLoopBoxes(true); applyLoopToTransport();
        const at = Tone.Transport.ticks;
        if (at < loopStartTk || at >= loopEndTk) seekTicks(loopStartTk);
      }

      // The loop button has three meanings and this paints all three: neutral
      // "press me where the passage starts", green "I am holding a start",
      // gold "a loop is running". The button itself never turns a loop off —
      // it always starts a new one — so the off switch is in the bar below.

      // Point at a marker for a while, then stop. A hint that never stops is
      // decoration: .practice-btn.is-spotlight settled that argument in this
      // file when it gave the new-song shimmer a 20s life. Eight seconds is
      // long enough to be seen over the music and short enough not to nag.
      // Pass 0 to hold it until something clears it — that is the armed start,
      // whose own state is the timer.
      const HINT_MS = 8000;
      let hintTimers = new WeakMap();
      function hintMarker(mk, ms) {
        if (!mk) return;
        clearTimeout(hintTimers.get(mk));
        mk.classList.add('is-hint');
        if (ms) hintTimers.set(mk, setTimeout(() => mk.classList.remove('is-hint'), ms));
      }
      function clearHint(mk) {
        if (!mk) return;
        clearTimeout(hintTimers.get(mk));
        mk.classList.remove('is-hint');
      }

      function renderLoopUI() {
        const running = loopEnabled && loopEndTk > loopStartTk;
        loopBtn.classList.toggle('is-armed', punchArmed);
        loopBtn.classList.toggle('is-active', running);
        // One word, at every width. The bar underneath carries the rest of
        // the sentence ("Loop starts at m. 21. Press again where it ends."),
        // so the button only has to say which press this is.
        const label = punchArmed ? 'End' : 'Loop';
        if (loopLabel) loopLabel.textContent = label;
        // The visible label stays short enough for the row it lives in. The
        // spoken one can afford the word that matters while a loop is already
        // running: this press starts a NEW one, it does not switch the old one
        // off. "Loop off" below does that.
        loopBtn.setAttribute('aria-label',
          punchArmed ? 'Loop ends here'
            : (running ? 'Start a new loop from here' : 'Loop from here'));
        loopBtn.title = punchArmed
          ? 'Press where the passage ends'
          : (running
            ? 'Start a new loop: press where it begins, then again where it ends'
            : 'Press where the passage starts, then again where it ends');

        loopBar.style.display = (punchArmed || running) ? 'flex' : 'none';
        loopArmedEl.style.display = punchArmed ? 'flex' : 'none';
        loopStepsEl.style.display = running ? 'flex' : 'none';
        if (punchArmed) {
          loopArmedText.innerHTML =
            `Loop starts at <b>${loopAddress(loopStartTk)}</b>. Press again where it ends.`;
        }
        // The start marker stands on its own while armed, so the singer can see
        // the fence they just planted before the second press closes it.
        loopStartMk.style.display = (punchArmed || running) ? 'block' : 'none';
        loopEndMk.style.display = running ? 'block' : 'none';
        loopRegion.style.display = running ? 'block' : 'none';
        // While armed, the green marker is the answer to "which one moves?".
        // It needs no timer: the armed state ends when the singer answers.
        if (punchArmed) hintMarker(loopStartMk, 0); else clearHint(loopStartMk);
        if (!running) clearHint(loopEndMk);
        updateStepButtons();
        // The score bar's "Loop mm. 19-22" wears the same state, so every way
        // of ending a loop — "Loop off", Cancel, a new punch — lets go of the
        // gold up there too.
        renderSystemLoopBtn();
      }

      // Punch the loop in while the music runs. Press once where the rough
      // patch starts, once more where it ends, and the loop begins there and
      // then. Both presses land on the bar line of the bar you are in, because
      // a singer names a passage in whole bars and a loop that starts halfway
      // through one comes back in on an upbeat.
      //
      // The old control turned itself on with a loop nobody chose: the playhead
      // plus thirty seconds. Nothing repeats here until both ends are named.
      const barLineAt = tk => barStarts[Math.min(totalMeasures - 1, measureAt(tk))];

      loopBtn.addEventListener('click', () => {
        if (!loaded) return;
        const here = barLineAt(Tone.Transport.ticks);
        let closedJustNow = false;
        if (!punchArmed) {
          // Whether or not a loop is already running, this press marks the
          // start of a new one. The old loop stops so the music can reach the
          // passage the singer is about to mark.
          punchArmed = true;
          loopEnabled = false;
          loopStartTk = here;
          loopEndTk = loopStartTk;   // inert: every loop test wants end > start
          // Two presses of one button is quick once you know it and invisible
          // until you do, so the press that STARTS a loop explains itself —
          // every time, until the singer says not to. The mark is taken first,
          // so the press is never spent on reading, and the music pauses,
          // because it would otherwise run past the end of the passage while
          // the card is up.
          if (!loopHowToDismissed()) {
            if (playing) pausePlayback();
            openLoopHowTo(loopAddress(loopStartTk));
          }
        } else {
          // Second press. Marking backwards is a slip, not an error, so the
          // two presses are sorted rather than refused. Both ends are already
          // bar lines, so the loop runs to the line after the bar it ends in,
          // and two presses inside one bar give a one-bar loop.
          const a = Math.min(loopStartTk, here), b = Math.max(loopStartTk, here);
          loopStartTk = a;
          loopEndTk = Math.min(lastTickTone, barStarts[Math.min(totalMeasures, measureAt(b) + 1)]);
          punchArmed = false;
          loopEnabled = true;
          closedJustNow = true;
        }
        updateLoopMarkers();
        renderLoopUI();
        applyLoopToTransport();
        // Handed over: the start is settled, and the end is the edge most
        // likely to be a measure out. Same device, pointed at the other one.
        if (closedJustNow) hintMarker(loopEndMk, HINT_MS);
        if (loopEnabled) seekTicks(loopStartTk);
      });

      // Ends the loop, and cancels a start that is still waiting for its end.
      function loopOff() {
        punchArmed = false;
        loopEnabled = false;
        renderLoopUI();
        applyLoopToTransport();
      }
      // One press loops the row of music on the screen; a second lets it go.
      // A toggle, rather than sending the singer to find "Loop off" in the bar
      // below the score, because the button that made the loop is the one
      // under their thumb.
      //
      // It starts the music if the music is stopped. The button exists to
      // drill this row now, and a press that makes no sound reads as a press
      // that did nothing.
      if (loopSysBtn) loopSysBtn.addEventListener('click', () => {
        const r = systemLoopRange();
        if (!r) return;
        if (loopIsRange(r)) { loopOff(); return; }
        loopStartTk = barStarts[r.a];
        loopEndTk = Math.min(lastTickTone, barStarts[r.b + 1]);
        punchArmed = false;
        loopEnabled = true;
        updateLoopMarkers(); writeLoopBoxes(true); renderLoopUI(); applyLoopToTransport();
        const at = Tone.Transport.ticks;
        if (at < loopStartTk || at >= loopEndTk) seekTicks(loopStartTk);
        if (!playing) play();
      });

      if (loopOffBtn) loopOffBtn.addEventListener('click', loopOff);
      if (loopCancelBtn) loopCancelBtn.addEventListener('click', loopOff);
      // The card can be dismissed for good, so there has to be a way back to
      // it. This is that way, and it opens the card cold: nothing is marked.
      if (loopHelpBtn) loopHelpBtn.addEventListener('click', () => openLoopHowTo(null));

      // Press-and-hold repeats, because the steppers are also the way to a
      // measure far from the playhead. First repeat after 400 ms, then eight a
      // second, which crosses a 60-bar piece in about eight seconds.
      for (const btn of stepBtns) {
        const edge = btn.dataset.edge, delta = Number(btn.dataset.delta);
        let holdTimer = null, repeatTimer = null;
        const stop = () => {
          clearTimeout(holdTimer); clearInterval(repeatTimer);
          holdTimer = repeatTimer = null;
        };
        btn.addEventListener('click', () => stepEdge(edge, delta));
        btn.addEventListener('pointerdown', () => {
          stop();
          holdTimer = setTimeout(() => {
            repeatTimer = setInterval(() => {
              if (!canStep(edge, delta)) { stop(); return; }
              stepEdge(edge, delta);
            }, 125);
          }, 400);
        });
        for (const ev of ['pointerup', 'pointerleave', 'pointercancel', 'blur']) {
          btn.addEventListener(ev, stop);
        }
      }

      // Entry point for the rehearsal schedule's practice links: open this row,
      // and loop one measure range when the schedule gave one. Mark writes the numbers off the printed
      // score ("Earth Seen From Above, mm 113 - 128"), so they are translated
      // to bars of the file first. The loop runs from the first time measure
      // `from` sounds to the last time measure `to` sounds, so every repeat in
      // between is inside the loop — that is the passage as the choir sings it.
      async function practiceMeasures(from, to) {
        // First statement, before any await, or the tap is already over by the
        // time the MIDI arrives. AudioPractice's practiceMeasures has always
        // opened this way; this one did not.
        unlockAudio();
        await openPlayer();
        if (!loaded) return;
        // Called with no range when the schedule named the piece but no
        // measures. Open the row and leave it alone: no loop, and no playing,
        // because a singer who pressed a bare title asked to see the piece, not
        // to be played at.
        if (from == null || to == null || !Number.isFinite(from) || !Number.isFinite(to)) return;
        // The floor is 0 on a score with a pickup and 1 everywhere else, the
        // same floor firstPlayed uses. The schedule sends 0 for "to m 32",
        // meaning from the very start, and on a pickup score that has to
        // include the pickup. It used to floor at 1, which started the loop on
        // the second bar of the file.
        const a = Math.max(1 - pickupBars, Math.min(Math.round(from), printedTotal));
        const b = Math.max(a, Math.min(Math.round(to), printedTotal));
        loopStartTk = barStarts[firstPlayed(a)];
        loopEndTk = barStarts[lastPlayed(b) + 1];
        punchArmed = false;
        loopEnabled = true;
        updateLoopMarkers();
        renderLoopUI();
        applyLoopToTransport();
        seekTicks(loopStartTk);
        if (!playing) play();
      }
      practiceJumps[prefix] = practiceMeasures;

      // For tests/solo-loudness.spec.ts: render this row's current loop under
      // any set of gains, to measure loudness and peaks as samples instead of
      // by ear. Nothing on the page calls it.
      ((window as any).__ssMixProbes ||= {})[prefix] = {
        parts: () => song.parts.map(p => p.label),
        levels: () => song.parts.map((_, i) => (enabled[i] ? (levels[i] ?? 0.8) : 0)),
        predict: (gains, inLoop = false) => {
          const m = loudnessOf();
          if (!m) return null;
          return inLoop ? m.energy(gains, loopStartTk, loopEndTk) : m.energy(gains);
        },
        gainsWithFocus,
        render: gains => renderMix(() => {}, gains),
      };

      // Metronome volume. The click used to be all-or-nothing at a fixed -8 dB,
      // which is either drowned out or deafening depending on the piece. The
      // ramp is linear in decibels and lands 80% — the same default the voice
      // parts use — on that original -8 dB, so nothing sounds different until
      // somebody actually moves it. 0% goes properly silent, not just quiet.
      const metroVolDb = pct => (pct <= 0 ? -Infinity : (pct / 100) * 40 - 40);
      const applyMetroVol = () => {
        if (metroSynth) metroSynth.volume.value = metroVolDb(metroLevel);
      };
      const metroKnob = makeKnob('metronome', metroLevel, v => {
        metroLevel = v;
        applyMetroVol();
      });
      metroKnob.root.classList.add('pp-knob-sm');
      metroKnob.root.title = 'Metronome volume';
      metroKnob.setMuted(true);
      metroVolEl.appendChild(metroKnob.root);

      metroBtn.addEventListener('click', () => {
        metronomeOn = !metronomeOn;
        metroBtn.classList.toggle('is-active', metronomeOn);
        metroBtn.setAttribute('aria-pressed', String(metronomeOn));
        // Dim the dial while the metronome is off, the same way an unchecked
        // voice part dims its own.
        metroKnob.setMuted(!metronomeOn);
      });

      // A change on a box is an explicit commit, so the box settles into the
      // player's own spelling there and then: type "12" and it reads "12 · 3".
      //
      // Clicking away already settled it, because change fires after focus has
      // gone and the guard in writeLoopBoxes lets it through. Enter did not:
      // it fires change and leaves focus in the box, so the guard held and the
      // box kept the bare "12". Hence the forced write.
      // Either box also takes the whole passage at once: "33-40", "33 – 40",
      // "mm. 33 to 40". That is the escape hatch for a measure too far from
      // the playhead to step to, and it is how the director says it. The two
      // ends follow the same rule the rehearsal links use — from the first
      // time m. 33 sounds to the last time m. 40 does — so a typed range and
      // a link give the same loop on a score with repeats.
      const RANGE_RE = /^\s*(?:mm?\.?\s*)?(\d+)\s*(?:-|–|—|to|through|thru)\s*(\d+)\s*$/i;
      function applyTypedRange(text) {
        const m = String(text).match(RANGE_RE);
        if (!m) return false;
        const a = Math.max(1, Math.min(Number(m[1]), printedTotal));
        const b = Math.max(a, Math.min(Number(m[2]), printedTotal));
        loopStartTk = barStarts[firstPlayed(a)];
        loopEndTk = barStarts[lastPlayed(b) + 1];
        punchArmed = false;
        loopEnabled = true;
        return true;
      }

      loopStartEl.addEventListener('change', () => {
        if (!loaded) return;
        if (!applyTypedRange(loopStartEl.value)) {
          const hit = mbToTicks(loopStartEl.value, false);
          if (hit) loopStartTk = Math.max(0, Math.min(hit.start, loopEndTk - minGapTk()));
        }
        updateLoopMarkers(); writeLoopBoxes(true); renderLoopUI();
        applyLoopToTransport(); seekTicks(loopStartTk);
      });
      loopEndEl.addEventListener('change', () => {
        if (!loaded) return;
        if (applyTypedRange(loopEndEl.value)) {
          updateLoopMarkers(); writeLoopBoxes(true); renderLoopUI();
          applyLoopToTransport(); seekTicks(loopStartTk);
          return;
        }
        // Inclusive: the loop ends AFTER the beat the singer named, so typing
        // 16 · 6 plays the whole of a 3/2 measure 16.
        const hit = mbToTicks(loopEndEl.value, true);
        if (hit) {
          const end = Math.min(hit.start + Tone.Transport.PPQ, barStarts[hit.bar + 1]);
          loopEndTk = Math.max(loopStartTk + minGapTk(), Math.min(end, lastTickTone));
        }
        updateLoopMarkers(); writeLoopBoxes(true); renderLoopUI(); applyLoopToTransport();
      });

      // The arrow keys do what the − and + beside each box do, which is what
      // a number field does everywhere else.
      for (const [box, edge] of [[loopStartEl, 'start'], [loopEndEl, 'end']]) {
        box.addEventListener('keydown', e => {
          if (e.key !== 'ArrowUp' && e.key !== 'ArrowDown') return;
          e.preventDefault();
          stepEdge(edge, e.key === 'ArrowUp' ? 1 : -1);
        });
      }

      // A marker drag can move the loop while a box still has focus: the
      // marker's mousedown calls preventDefault, so clicking it does not blur
      // the box the singer was last in. writeLoopBoxes skips that box on every
      // frame, correctly, and no change event ever follows to settle it, so it
      // sat there naming a loop edge that had moved. Blur is the one moment
      // that case reaches.
      for (const box of [loopStartEl, loopEndEl]) {
        box.addEventListener('blur', () => { if (loaded) writeLoopBoxes(true); });
      }

      function initMarkerDrag(marker, onUpdate, onDragEnd) {
        let dragging = false;
        // Where inside the marker the pointer went down. Without it the first
        // mousemove writes the position straight from the cursor, so the marker
        // teleports to the pointer: press a marker and let go without moving
        // and it has already shifted, and a drag out and back never returns.
        let grab = 0;
        const trackTicks = x => {
          const r = trackEl.getBoundingClientRect();
          return Math.round(Math.max(0, Math.min(1, (x - grab - r.left) / r.width)) * lastTickTone);
        };
        const finish = () => {
          if (!dragging) return;
          dragging = false; marker.classList.remove('dragging');
          // The click that follows this mouseup still reaches the track, and
          // seeking there would undo the position onDragEnd is about to set.
          swallowTrackClick = true;
          if (onDragEnd) onDragEnd();
        };
        const begin = (e, clientX) => {
          e.preventDefault(); e.stopPropagation();
          const m = marker.getBoundingClientRect();
          grab = clientX - (m.left + m.width / 2);
          dragging = true; marker.classList.add('dragging');
        };
        marker.addEventListener('mousedown', e => begin(e, e.clientX));
        document.addEventListener('mousemove', e => { if (dragging) onUpdate(trackTicks(e.clientX)); });
        document.addEventListener('mouseup', finish);
        marker.addEventListener('touchstart', e => begin(e, e.touches[0].clientX), { passive: false });
        document.addEventListener('touchmove', e => {
          if (!dragging) return;
          e.preventDefault();
          onUpdate(trackTicks(e.touches[0].clientX));
        }, { passive: false });
        document.addEventListener('touchend', finish);
      }
      // Touching a marker is the answer the hint was asking for.
      for (const mk of [loopStartMk, loopEndMk]) {
        mk.addEventListener('pointerdown', () => clearHint(mk));
      }
      initMarkerDrag(loopStartMk, tk => {
        // While the button is armed there is no end yet, so the usual "stay a
        // beat clear of the end" ceiling would drag the start backwards a beat
        // per frame. Armed, the start is free and the inert end follows it.
        const ceiling = punchArmed ? lastTickTone : loopEndTk - minGapTk();
        loopStartTk = Math.max(0, Math.min(snapToBeat(tk), ceiling));
        if (punchArmed) loopEndTk = loopStartTk;
        updateLoopMarkers(); renderLoopUI(); applyLoopToTransport();
      }, () => seekTicks(loopStartTk));
      initMarkerDrag(loopEndMk, tk => {
        loopEndTk = Math.max(loopStartTk + minGapTk(), Math.min(snapToBeat(tk), lastTickTone));
        updateLoopMarkers(); applyLoopToTransport();
      });

      // ---- Tempo, saloon egg, and the reset-everything button ----
      function applyBpm() {
        // The tempo where the playhead is now, not the tempo of the first bar.
        // Called on every seek as well as on every change of the dial, because
        // a seek jumps over the scheduled tempo changes without firing them.
        // rampTo (not a hard .value= jump) avoids the audible glitch/retrigger
        // Tone.js can produce when the Transport's tempo changes mid-playback.
        if (!Tone) return;
        const seg = tempoMap[tempoIndexAt(Tone.Transport.ticks)];
        Tone.Transport.bpm.rampTo(seg.bpm * tempoRate(), 0.05);
      }

      function eggOff() {
        if (!eggActive) return;
        eggActive = false;
        eggBtn.classList.remove('is-active');
        applyBpm();
      }

      eggBtn.addEventListener('click', () => {
        if (!loaded) return;
        eggActive = !eggActive;
        eggBtn.classList.toggle('is-active', eggActive);
        applyBpm();
      });

      tempoSteps.querySelectorAll('.pp-tempo-step').forEach(b => {
        b.addEventListener('click', () => {
          rate = parseFloat(b.dataset.rate);
          eggOff();
          tempoSteps.querySelectorAll('.pp-tempo-step').forEach(x => x.classList.toggle('is-active', x === b));
          if (Tone) { applyBpm(); draw(); }
        });
      });

      tempoResetBtn.addEventListener('click', () => {
        if (!loaded) return;
        rate = 1; eggOff();
        tempoSteps.querySelectorAll('.pp-tempo-step').forEach(x =>
          x.classList.toggle('is-active', parseFloat(x.dataset.rate) === 1));
        applyBpm();
        clearFocus();
        // Reset all track volumes and enabled state to defaults
        knobs.forEach((knob, i) => {
          knob.setDisabled(false); knob.setMuted(false); knob.set(80);
          levels[i] = 0.8;
        });
        checkboxEls.forEach((cb, i) => { cb.checked = true; enabled[i] = true; });
        metroLevel = 80; metroKnob.set(80); applyMetroVol();
        trackRows.forEach(row => row.classList.remove('pp-chan-off'));
        applyGains();
        draw();
      });

      // ---- "Save this mix": render the current settings to an MP3 ----
      // Every note here is made in the browser by a Tone.js Sampler, so the same
      // graph can be rebuilt inside an OfflineAudioContext. Nothing is captured
      // from the speakers; the file is a fresh render of the same notes at the
      // same settings. Speed depends on the tab staying in the foreground — see
      // the note on the progress poller below.

      // lamejs accepts 32/44.1/48 kHz only, and some Macs run their audio card
      // at 96 kHz. Render at a fixed 44.1 kHz so every machine produces the same
      // file; the browser resamples the piano samples on the way in.
      const EXPORT_RATE = 44100;
      const EXPORT_KBPS = 128;   // ~1 MB per minute — a 4-minute mix is ~4 MB
      const EXPORT_TAIL = 2.5;   // seconds of ring-out, so the last chord is not cut off

      // Progress line under the transport. Nodes are made once and then updated,
      // so a progress tick does not rebuild the DOM 200 times.
      let exportBarFill = null, exportTextEl = null, exportBarEl = null, exportSpinEl = null, exportCloseEl = null;
      let exportClearTimer = null;
      // busy = show the spinner. pct = null leaves the bar hidden, which is the
      // honest state while a phase reports no progress.
      function setExportStatus(text, pct, cls, busy) {
        clearTimeout(exportClearTimer);
        exportStatus.hidden = false;
        exportStatus.className = 'pp-export-status' + (cls ? ' ' + cls : '');
        if (!exportTextEl) {
          exportSpinEl = document.createElement('span');
          exportSpinEl.className = 'note-spin';
          exportSpinEl.setAttribute('aria-hidden', 'true');
          exportSpinEl.textContent = '🎵';
          exportTextEl = document.createElement('span');
          const bar = document.createElement('div');
          bar.className = 'pp-export-bar';
          exportBarFill = document.createElement('i');
          bar.appendChild(exportBarFill);
          exportCloseEl = document.createElement('button');
          exportCloseEl.type = 'button';
          exportCloseEl.className = 'pp-export-close';
          exportCloseEl.setAttribute('aria-label', 'Dismiss this message');
          exportCloseEl.textContent = '\u00d7';
          exportCloseEl.addEventListener('click', () => {
            clearTimeout(exportClearTimer);
            exportStatus.hidden = true;
          });
          exportStatus.append(exportSpinEl, exportTextEl, bar, exportCloseEl);
          exportBarEl = bar;
        }
        exportSpinEl.hidden = !busy;
        // Offer the X once the work stops. Nothing to dismiss while it is running.
        exportCloseEl.hidden = !!busy;
        exportTextEl.textContent = text;
        exportBarEl.style.display = pct == null ? 'none' : '';
        if (pct != null) exportBarFill.style.width = `${Math.round(pct * 100)}%`;
        // A finished message has said its piece; it should not sit there all evening.
        if (cls === 'is-done') exportClearTimer = setTimeout(() => { exportStatus.hidden = true; }, 12000);
      }

      // How long this device takes to render one second of audio, learned from the
      // last export and kept per browser. Until there is a measurement there is no
      // estimate, so the first export shows elapsed time only rather than a guess.
      const RATE_KEY = 'ss-practice-render-rate';
      function readRenderRate() {
        const v = parseFloat(localStorage.getItem(RATE_KEY) || '');
        return Number.isFinite(v) && v > 0 ? v : null;
      }
      function writeRenderRate(msPerAudioSec) {
        const old = readRenderRate();
        // Smooth it, so one busy moment on the machine does not skew every estimate.
        const next = old ? old * 0.6 + msPerAudioSec * 0.4 : msPerAudioSec;
        try { localStorage.setItem(RATE_KEY, String(next)); } catch {}
      }

      // Filename says what is in the file: song, focused part, tempo, measures.
      function exportFilename() {
        const slug = t => String(t || '').replace(/[^a-z0-9]+/gi, '-').replace(/^-+|-+$/g, '');
        const bits = [slug(song.title) || 'practice-mix'];
        if (focusedTrack !== null) bits.push(slug(song.parts[focusedTrack].label));
        const effRate = eggActive ? 0.5 : rate;
        if (effRate !== 1) bits.push(`${Math.round(effRate * 100)}pct`);
        if (loopEnabled && loopEndTk > loopStartTk) {
          bits.push(`m${printedAt(measureAt(loopStartTk))}-${printedAt(measureAt(loopEndTk - 1))}`);
        }
        return bits.join('-').slice(0, 90) + '.mp3';
      }

      async function renderMix(onProgress, gains = currentGains()) {
        const effRate = eggActive ? 0.5 : rate;
        const useLoop = loopEnabled && loopEndTk > loopStartTk;
        const startTk = useLoop ? loopStartTk : 0;
        const endTk = useLoop ? loopEndTk : lastTickTone;
        // Length of the excerpt, from the tempo map rather than from the live
        // transport, so a tempo ramp still in flight cannot skew the render.
        // The map also means a piece that changes tempo is measured section by
        // section instead of all at its opening speed.
        const startSec = ticksToSec(startTk);
        const totalSec = ticksToSec(endTk) - startSec + EXPORT_TAIL;
        // The offline transport runs at 192 ticks to the quarter note, which is
        // what the note events below are written in.
        const EXPORT_PPQ = 192;
        const exTick = tk => Math.round((tk / Tone.Transport.PPQ) * EXPORT_PPQ);

        // Tone renders in two phases. First it walks an offline clock to fire every
        // scheduled note, which is quick. Then startRendering() does the actual DSP,
        // which is the slow part and reports nothing at all. An earlier version of
        // this bar tracked the offline clock, so it raced to 100% and then sat there
        // through the whole real wait. Report elapsed wall time against a measured
        // estimate instead, and hand back the render time so the estimate improves.
        //
        // The clock phase also yields to the page once per rendered second. Chrome
        // clamps a background tab's timers to 1 Hz, which alone drags that phase down
        // to real time. Hence "keep this page open".
        const started = performance.now();
        const poll = setInterval(() => onProgress(performance.now() - started, totalSec), 200);
        let piano;
        try {
          piano = await sharedPiano(Tone, PIANO_URLS, PIANO_BASE);
        } catch (err) {
          clearInterval(poll);
          throw err;
        }

        const render = Tone.Offline(async (ctx) => {
          const transport = ctx.transport;
          transport.PPQ = EXPORT_PPQ;
          transport.timeSignature = beatsPerBar;
          // Start at the tempo covering the first exported tick, then hand the
          // offline transport the same tempo changes the live one gets.
          transport.bpm.value = tempoMap[tempoIndexAt(startTk)].bpm * effRate;
          for (let i = 1; i < tempoMap.length; i++) {
            const seg = tempoMap[i];
            if (seg.tick <= startTk) continue;
            transport.schedule(time => {
              transport.bpm.setValueAtTime(seg.bpm * effRate, time);
            }, `${exTick(seg.tick)}i`);
          }

          midiData.forEach((midi, i) => {
            if (gains[i] <= 0) return;   // a muted part costs nothing to render
            const ch = new Tone.Channel({ volume: Tone.gainToDb(gains[i]) }).toDestination();
            // The page's one decoded piano, not a fresh decode per part.
            const sampler = new Tone.Sampler({ urls: piano }).connect(ch);
            const ppq = midi.header.ppq;
            const events = [];
            midi.tracks.forEach(tr => tr.notes.forEach(n => {
              const tTone = Math.round(n.ticks / ppq * 192);
              const dTone = Math.max(1, Math.round(n.durationTicks / ppq * 192));
              events.push([`${tTone}i`, { name: n.name, dur: `${dTone}i`, vel: n.velocity }]);
            }));
            new Tone.Part((time, ev) => {
              sampler.triggerAttackRelease(ev.name, ev.dur, time, ev.vel);
            }, events).start(0);
          });

          if (metronomeOn && metroLevel > 0) {
            const ms = new Tone.MembraneSynth({
              pitchDecay: 0.008, octaves: 2,
              envelope: { attack: 0.001, decay: 0.15, sustain: 0 },
            }).toDestination();
            ms.volume.value = metroVolDb(metroLevel);
            new Tone.Loop((time) => {
              const isDownbeat = parseInt(transport.position.toString().split(':')[1], 10) === 0;
              ms.triggerAttackRelease(isDownbeat ? 'C5' : 'C4', '32n', time, isDownbeat ? 1 : 0.6);
            }, '4n').start(0);
          }

          await Tone.loaded();          // piano samples, already in the browser cache
          // Offset in ticks, not seconds: a seconds offset is converted with
          // whatever tempo is set at the time, which lands in the wrong place
          // in a piece that changes tempo before the excerpt starts.
          transport.start(0, `${exTick(startTk)}i`); // a loop exports as a trimmed excerpt
        }, totalSec, 2, EXPORT_RATE);

        try {
          const audio = (await render).get();
          writeRenderRate((performance.now() - started) / totalSec);
          return audio;
        } finally {
          clearInterval(poll);
        }
      }

      const toPcm = v => { const c = v < -1 ? -1 : v > 1 ? 1 : v; return c < 0 ? c * 0x8000 : c * 0x7fff; };

      async function encodeMp3(audio, onProgress) {
        const { Mp3Encoder } = await import('@breezystack/lamejs');
        const stereo = audio.numberOfChannels > 1;
        const enc = new Mp3Encoder(2, audio.sampleRate, EXPORT_KBPS);
        const L = audio.getChannelData(0);
        const R = stereo ? audio.getChannelData(1) : L;
        const BLOCK = 1152;                 // one MP3 frame
        const li = new Int16Array(BLOCK), ri = new Int16Array(BLOCK);
        const parts = [];
        for (let off = 0, block = 0; off < L.length; off += BLOCK, block++) {
          const n = Math.min(BLOCK, L.length - off);
          for (let j = 0; j < n; j++) { li[j] = toPcm(L[off + j]); ri[j] = toPcm(R[off + j]); }
          const chunk = n === BLOCK
            ? enc.encodeBuffer(li, ri)
            : enc.encodeBuffer(li.subarray(0, n), ri.subarray(0, n));
          if (chunk.length) parts.push(new Uint8Array(chunk));
          // Hand the main thread back every ~5 seconds of audio so the progress
          // bar paints and the page keeps answering taps on a phone.
          if (block % 200 === 199) {
            onProgress(off / L.length);
            await new Promise(r => setTimeout(r, 0));
          }
        }
        const tail = enc.flush();
        if (tail.length) parts.push(new Uint8Array(tail));
        return new Blob(parts, { type: 'audio/mpeg' });
      }

      exportBtn.addEventListener('click', async () => {
        if (!loaded || exportBtn.disabled) return;
        // Tone.Offline swaps the global context while it renders, and the live
        // draw loop reads Tone.Transport off that same global. Stop the music
        // first or the playhead reads the offline transport and jumps around.
        if (playing) pausePlayback();

        if (currentGains().every(g => g <= 0) && !(metronomeOn && metroLevel > 0)) {
          setExportStatus('Turn up at least one part before you save.', null, 'is-error');
          return;
        }

        exportBtn.disabled = true;
        try {
          // The estimate covers the render only; the MP3 step has its own real bar.
          const rate = readRenderRate();
          setExportStatus('Rendering the piano… keep this page open.', rate ? 0 : null, null, true);
          const audio = await renderMix((elapsedMs, audioSec) => {
            const tail = ' Keep this page open.';
            if (!rate) {
              // No measurement from this device yet, so promise nothing.
              setExportStatus(`Rendering the piano… ${fmt(elapsedMs / 1000)} so far.` + tail, null, null, true);
              return;
            }
            const estMs = rate * audioSec;
            const leftMs = estMs - elapsedMs;
            // Cap at 95%: an estimate that sits at 100% is the frozen bar again.
            // Once the estimate runs out, stop counting rather than showing "0:00 left".
            const word = leftMs > 1000 ? `about ${fmt(leftMs / 1000)} left.` : 'nearly done.';
            setExportStatus(`Rendering the piano… ${word}` + tail,
              Math.min(0.95, elapsedMs / estMs), null, true);
          });
          setExportStatus('Making the MP3…', 0, null, true);
          const blob = await encodeMp3(audio, pct => setExportStatus('Making the MP3…', pct, null, true));

          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = exportFilename();
          document.body.appendChild(a);
          a.click();
          a.remove();
          setTimeout(() => URL.revokeObjectURL(url), 60000);

          const mb = (blob.size / 1048576).toFixed(1);
          setExportStatus(`Saved ${a.download} (${mb} MB). Look in your Downloads.`, null, 'is-done', false);
        } catch (e) {
          console.error('[practice-player] export failed', e);
          setExportStatus('The save failed. Reload the page and try again.', null, 'is-error', false);
        } finally {
          exportBtn.disabled = false;
        }
      });
    }

  document.querySelectorAll('.midi-practice').forEach((el) => {
    const node = el as HTMLElement;
    const cfg = node.dataset.midiConfig;
    const prefix = node.dataset.prefix;
    if (!cfg || !prefix) return;
    makeMidiPlayer(prefix, JSON.parse(cfg));
  });
</script>
