---
// One song row for the rehearsal list, matching the spring2026 format: title +
// composer + Sheet Music (PDF), with an inline "Practice" toggle that expands a
// per-part MIDI player (piano soundfont, measure-labeled timeline, pitch lanes).
// The player factory + CSS are emitted here too (Astro dedupes them to one copy).
interface Part { file: string; label: string }
interface Repeat { from: number; to: number; times: number }
interface Props {
  title: string;
  composer?: string;
  desc?: string;
  pdf?: string | null;
  youtube?: string;
  /** Our own learning page, shown where the YouTube button goes. See Score.guide. */
  guide?: { href: string; label: string };
  prefix: string;
  basePath: string;
  parts: Part[];
  sheetPdf?: string;
  syncXml?: string;
  /** Repeated blocks of the printed score, in printed measure numbers,
   *  including first- and second-time bars. See MidiRepeat in
   *  src/lib/season-repertoire.ts. */
  repeats?: Repeat[];
  /** True when the MIDI's first bar is a pickup the printed score does not
   *  number. See MidiConfig in src/lib/season-repertoire.ts. */
  pickup?: boolean;
  /** Playback tempo in quarter notes per minute, when the MIDI file disagrees
   *  with the page. See MidiConfig in src/lib/season-repertoire.ts. */
  bpm?: number;
  /** Meter and tempo as the page prints them, for the status line. */
  scoreTempo?: string;
  /** The score's row in the music library. With it the player fetches the
   *  measure map at /members/follow/<id>.json and follows the score: it turns
   *  the page and boxes the measure that is sounding. See MidiConfig. */
  scoreId?: number;
  /** Show the words of the playing measure while the score is hidden. Opt-in
   *  per score, because the words are the reader's OCR. See MidiConfig. */
  words?: boolean;
  /** What each staff of a system is, by staff count, so "My part" can pick
   *  out the singer's staff inside the measure box. See MidiConfig. */
  staves?: Record<number, string[]>;
}
const { title, composer, desc, pdf, youtube, guide, prefix, basePath, parts, sheetPdf, syncXml, repeats, pickup, bpm, scoreTempo, scoreId, words, staves } = Astro.props;
const follow = scoreId ? `/members/follow/${scoreId}.json` : undefined;
const config = JSON.stringify({ basePath, parts, sheetPdf, syncXml, follow, words: !!words, staves, repeats, pickup, bpm, scoreTempo, title });
// The part-name rail is a fixed width so every row's controls line up, but a
// width that fits "Chorus II Soprano" wastes half a rail on "Alto 1". Size it
// per song instead — and to the longest VOICE name, not the longest of all:
// one "Piano (Right Hand)" would otherwise set the rail for six short voice
// parts. An accompaniment name longer than the rail wraps to a second line,
// which the row has room for either way. Same test the note box uses.
const ACCOMPANIMENT = /piano|accomp|organ|instrument|orchestra/i;
const voiceLabels = parts.filter(p => !ACCOMPANIMENT.test(p.label)).map(p => p.label);
// One <template> serves every player on the page. Astro renders this component
// once per score, so the first instance of a request emits it and the rest skip
// it. Astro.locals is per-request, so a second page load gets its own copy.
const ppLocals = Astro.locals as Record<string, unknown>;
const emitPanelTemplate = !ppLocals.__ppPanelTemplate;
ppLocals.__ppPanelTemplate = true;

const longestPartName = Math.min(20, Math.max(8, ...(voiceLabels.length ? voiceLabels : parts.map(p => p.label)).map(l => l.length)));
// Panel markup is emitted as a static string (IDs are wired at runtime).
// Emitted ONCE per page as a <template>, not once per player.
//
// The markup is ~16 KB and identical for every score apart from the id prefix.
// /members renders fourteen players, so fourteen inline copies were 225 KB of
// a 327 KB page — 69% of it — and all of it was hidden until a singer opened
// one (measured 2026-09-19, while hunting Fast Origin Transfer). The page is
// behind the gate, so the CDN can never hold it: every singer paid for those
// bytes on every visit.
//
// `__PP__` stands in for the prefix and hydratePanel() stamps it out at
// runtime. Keep this string free of any other interpolation: a second variable
// would make the copies differ and the whole saving disappears. The assertion
// in this file's frontmatter enforces that.
const PANEL_MARKUP = `          <div class="rounded-xl ring-1 ring-white/10 bg-black/40 p-4 md:p-5">
            <div id="__PP__-loading" class="flex items-center gap-2 text-base text-zinc-300 mb-2">
              <span class="note-spin" aria-hidden="true">🎵</span>
              <span id="__PP__-loading-text">Loading…</span>
            </div>
            <p id="__PP__-audio-alert" class="pp-audio-alert" role="alert" hidden></p>

            <div id="__PP__-transport" class="hidden flex flex-col gap-2 mb-4">
              <div class="pp-deck">
                <div class="pp-deck-row">
                  <div class="pp-transport-btns">
                    <button id="__PP__-play" class="pp-ctrl-btn pp-play-btn" aria-label="Play">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="pp-icon-play w-5 h-5 shrink-0"><path d="M6.3 2.84A1.5 1.5 0 0 0 4 4.11v11.78a1.5 1.5 0 0 0 2.3 1.27l9.344-5.891a1.5 1.5 0 0 0 0-2.538L6.3 2.841Z"/></svg>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="pp-icon-pause w-5 h-5 shrink-0"><path d="M5.75 3a.75.75 0 0 0-.75.75v12.5c0 .414.336.75.75.75h1.5a.75.75 0 0 0 .75-.75V3.75A.75.75 0 0 0 7.25 3h-1.5ZM12.75 3a.75.75 0 0 0-.75.75v12.5c0 .414.336.75.75.75h1.5a.75.75 0 0 0 .75-.75V3.75a.75.75 0 0 0-.75-.75h-1.5Z"/></svg>
                    </button>
                    <button id="__PP__-skip-back" class="pp-icon-btn" aria-label="Back 15 seconds" title="Back 15s"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="w-4 h-4 shrink-0"><path d="M7.712 4.818A1.5 1.5 0 0 1 10 6.095v2.972c.104-.13.234-.248.389-.343l6.323-3.906A1.5 1.5 0 0 1 19 6.095v7.81a1.5 1.5 0 0 1-2.288 1.276l-6.323-3.905a1.505 1.505 0 0 1-.389-.344v2.973a1.5 1.5 0 0 1-2.288 1.276l-6.323-3.905a1.5 1.5 0 0 1 0-2.552l6.323-3.906Z"/></svg><span>15s</span></button>
                    <button id="__PP__-skip-fwd" class="pp-icon-btn" aria-label="Forward 15 seconds" title="Forward 15s"><span>15s</span><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="w-4 h-4 shrink-0"><path d="M3.288 4.818A1.5 1.5 0 0 0 1 6.095v7.81a1.5 1.5 0 0 0 2.288 1.276l6.323-3.905c.155-.096.285-.213.389-.344v2.973a1.5 1.5 0 0 0 2.288 1.276l6.323-3.905a1.5 1.5 0 0 0 0-2.552l-6.323-3.906A1.5 1.5 0 0 0 10 6.095v2.972a1.506 1.506 0 0 0-.389-.343L3.288 4.818Z"/></svg></button>
                    <button id="__PP__-loop" class="pp-icon-btn pp-punch-btn" aria-label="Loop from here" title="Press where the passage starts, then again where it ends">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="w-4 h-4 shrink-0"><path fill-rule="evenodd" d="M10 4.5c1.215 0 2.417.055 3.604.162a.68.68 0 0 1 .615.597c.124 1.038.208 2.088.25 3.15l-1.689-1.69a.75.75 0 0 0-1.06 1.061l2.999 3a.75.75 0 0 0 1.06 0l3.001-3a.75.75 0 1 0-1.06-1.06l-1.748 1.747a41.31 41.31 0 0 0-.264-3.386 2.18 2.18 0 0 0-1.97-1.913 41.512 41.512 0 0 0-7.477 0 2.18 2.18 0 0 0-1.969 1.913 41.16 41.16 0 0 0-.16 1.61.75.75 0 1 0 1.495.12c.041-.52.093-1.038.154-1.552a.68.68 0 0 1 .615-.597A40.012 40.012 0 0 1 10 4.5ZM5.281 9.22a.75.75 0 0 0-1.06 0l-3.001 3a.75.75 0 1 0 1.06 1.06l1.748-1.747c.042 1.141.13 2.27.264 3.386a2.18 2.18 0 0 0 1.97 1.913 41.533 41.533 0 0 0 7.477 0 2.18 2.18 0 0 0 1.969-1.913c.064-.534.117-1.071.16-1.61a.75.75 0 1 0-1.495-.12c-.041.52-.093 1.037-.154 1.552a.68.68 0 0 1-.615.597 40.013 40.013 0 0 1-7.208 0 .68.68 0 0 1-.615-.597 39.785 39.785 0 0 1-.25-3.15l1.689 1.69a.75.75 0 0 0 1.06-1.061l-2.999-3Z" clip-rule="evenodd"/></svg>
                      <span id="__PP__-loop-label" class="pp-btn-word">Loop</span>
                    </button>
                  </div>
                  <button id="__PP__-stop" class="pp-ctrl-btn pp-reset-btn" aria-label="Reset to start">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="w-4 h-4 shrink-0"><path fill-rule="evenodd" d="M15.312 11.424a5.5 5.5 0 0 1-9.201 2.466l-.312-.311h2.433a.75.75 0 0 0 0-1.5H3.989a.75.75 0 0 0-.75.75v4.242a.75.75 0 0 0 1.5 0v-2.43l.31.31a7 7 0 0 0 11.712-3.138.75.75 0 0 0-1.449-.39Zm1.23-3.723a.75.75 0 0 0 .219-.53V2.929a.75.75 0 0 0-1.5 0V5.36l-.31-.31A7 7 0 0 0 3.239 8.188a.75.75 0 1 0 1.448.389A5.5 5.5 0 0 1 13.89 6.11l.311.31h-2.432a.75.75 0 0 0 0 1.5h4.243a.75.75 0 0 0 .53-.219Z" clip-rule="evenodd"/></svg>
                    <span class="pp-btn-word">Reset</span>
                  </button>
                </div>
                <div class="pp-deck-row pp-deck-row-2">
                <div class="pp-metro-group">
                  <button id="__PP__-metronome" class="pp-metronome-btn" aria-label="Toggle metronome" aria-pressed="false" title="Metronome">
                    <span>Metronome</span>
                  </button>
                  <div id="__PP__-metro-vol" class="pp-metro-vol"></div>
                </div>
                <div class="pp-tempo-group">
                  <div class="pp-tempo-widget">
                  <span class="pp-tempo-label">Tempo</span>
                  <div class="pp-tempo-controls">
                    <div id="__PP__-tempo-steps" class="pp-tempo-steps" role="group" aria-label="Tempo">
                      <button class="pp-tempo-step" data-rate="0.50" aria-label="50 percent">50<span class="pp-step-pct">%</span></button>
                      <button class="pp-tempo-step" data-rate="0.60" aria-label="60 percent">60<span class="pp-step-pct">%</span></button>
                      <button class="pp-tempo-step" data-rate="0.70" aria-label="70 percent">70<span class="pp-step-pct">%</span></button>
                      <button class="pp-tempo-step" data-rate="0.80" aria-label="80 percent">80<span class="pp-step-pct">%</span></button>
                      <button class="pp-tempo-step" data-rate="0.90" aria-label="90 percent">90<span class="pp-step-pct">%</span></button>
                      <button class="pp-tempo-step is-active" data-rate="1.00" aria-label="100 percent">100<span class="pp-step-pct">%</span></button>
                    </div>
                    <button id="__PP__-tempo-reset" class="pp-tempo-reset-btn" title="Reset tempo and volumes">↺</button>
                  </div>
                  </div>
                </div>
                <button id="__PP__-sheet-toggle" class="pp-sheet-toggle-btn" style="display:none" aria-expanded="false">📄 Score</button>
                <button id="__PP__-export" class="pp-export-btn" title="Save these settings as an MP3 file">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="w-4 h-4 shrink-0"><path d="M10.75 2.75a.75.75 0 0 0-1.5 0v8.614L6.295 8.235a.75.75 0 1 0-1.09 1.03l4.25 4.5a.75.75 0 0 0 1.09 0l4.25-4.5a.75.75 0 0 0-1.09-1.03l-2.955 3.129V2.75Z"/><path d="M3.5 12.75a.75.75 0 0 0-1.5 0v2.5A2.75 2.75 0 0 0 4.75 18h10.5A2.75 2.75 0 0 0 18 15.25v-2.5a.75.75 0 0 0-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5Z"/></svg>
                  <span>Download Mix</span>
                </button>
                </div>
              </div>
              <p id="__PP__-export-status" class="pp-export-status" role="status" hidden></p>

              <div class="flex items-center gap-2">
                <span id="__PP__-time" class="pp-time-readout tabular-nums">0:00 / 0:00</span>
                <div class="flex-1 min-w-0">
                  <div id="__PP__-progress-track" class="pp-progress-track" role="progressbar" aria-label="Playback position by measure" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                    <div id="__PP__-loop-region" class="pp-loop-region" style="display:none"></div>
                    <div id="__PP__-measures" class="pp-measure-ticks" aria-hidden="true"></div>
                    <div id="__PP__-progress-fill" class="pp-progress-fill"></div>
                    <div id="__PP__-head" class="pp-head"></div>
                    <div id="__PP__-loop-start-mk" class="pp-loop-marker pp-loop-mk-start" style="display:none" title="Drag to set loop start" aria-hidden="true"></div>
                    <div id="__PP__-loop-end-mk" class="pp-loop-marker pp-loop-mk-end" style="display:none" title="Drag to set loop end" aria-hidden="true"></div>
                  </div>
                </div>
                <span id="__PP__-measure" class="pp-measure-readout text-base font-semibold tabular-nums text-yellow-200 text-right" title="Roll the mouse wheel here to move a measure at a time">m. —</span>
              </div>

              <div class="pp-info-row">
                <div class="pp-info-left">
                  <p id="__PP__-status" class="pp-status"></p>
                </div>
                <div id="__PP__-loop-bar" class="pp-loop-bar" style="display:none">
                  <span id="__PP__-loop-armed" class="pp-loop-armed" style="display:none">
                    <span class="pp-loop-pip" aria-hidden="true"></span>
                    <span id="__PP__-loop-armed-text" role="status">Loop starts here</span>
                    <button id="__PP__-loop-cancel" class="pp-loop-off-btn">Cancel</button>
                  </span>
                  <span id="__PP__-loop-steps" class="pp-loop-steps" style="display:none">
                    <span class="pp-edge">
                      <span class="pp-edge-label">from m.</span>
                      <span class="pp-stepper">
                        <button class="pp-step-btn" data-edge="start" data-delta="-1" aria-label="Loop start one measure earlier">&#8722;</button>
                        <input id="__PP__-loop-start" type="text" class="pp-step-val pp-time-start" value="1" aria-label="Loop start measure" title="Type a measure (33), a measure and beat (33 &#183; 2), or a whole range (33-40)">
                        <button class="pp-step-btn" data-edge="start" data-delta="1" aria-label="Loop start one measure later">+</button>
                      </span>
                    </span>
                    <span class="pp-edge">
                      <span class="pp-edge-label">to m.</span>
                      <span class="pp-stepper">
                        <button class="pp-step-btn" data-edge="end" data-delta="-1" aria-label="Loop end one measure earlier">&#8722;</button>
                        <input id="__PP__-loop-end" type="text" class="pp-step-val pp-time-end" value="1" aria-label="Loop end measure, inclusive" title="The last measure the loop plays">
                        <button class="pp-step-btn" data-edge="end" data-delta="1" aria-label="Loop end one measure later">+</button>
                      </span>
                    </span>
                    <span class="pp-loop-summary">
                      <span id="__PP__-loop-measures" class="pp-loop-clock">1 bar</span>
                      <button id="__PP__-loop-help" class="pp-loop-help-btn" aria-label="How looping works" title="How looping works">?</button>
                      <button id="__PP__-loop-off" class="pp-loop-off-btn">Loop off</button>
                    </span>
                  </span>
                </div>
                <div class="pp-info-right">
                  <span id="__PP__-legend" class="pp-legend" hidden>
                    <span class="pp-legend-mark" aria-hidden="true"></span>
                    <span>a repeat starts over here</span>
                  </span>
                  <button id="__PP__-words-toggle" class="pp-words-btn" style="display:none" aria-pressed="false" title="Show the words of the bar that is playing">Words</button>
                  <button id="__PP__-egg" class="pp-egg-btn" title="Saloon mode" aria-label="Play slowed down">🤠</button>
                </div>
              </div>
              <div id="__PP__-waveview" class="pp-waveview"></div>
            </div>

            <div id="__PP__-tracks" class="hidden pp-mixer"></div>

            <!-- The words sit UNDER the parts, the way they sit under a staff
                 on the printed page. Above the mixer they were the first thing
                 in the panel, about 340px left of the notes they belong to, so
                 the eye went to them and then had to travel back to the music.
                 The left padding is measured from the note lanes at runtime. -->
            <div id="__PP__-words" class="pp-words" style="display:none" aria-label="The words, scrolling with the music">
              <canvas id="__PP__-words-lane" class="pp-words-lane" height="56" aria-hidden="true"></canvas>
            </div>

            <div id="__PP__-sheet-section" class="pp-sheet-section" style="display:none">
              <div class="pp-sheet-nav">
                <button id="__PP__-sheet-prev" class="pp-sheet-btn">← Prev</button>
                <span id="__PP__-sheet-page" class="pp-sheet-page-info">Page 1 / 1</span>
                <button id="__PP__-sheet-next" class="pp-sheet-btn">Next →</button>
                <label class="pp-follow-toggle"><input id="__PP__-follow" type="checkbox" checked> <span class="pp-follow-words">Follow<span class="pp-follow-rest"> the music</span></span></label>
                <label class="pp-part-pick" id="__PP__-part-wrap" style="display:none">My part <select id="__PP__-part"></select></label>
                <button id="__PP__-loop-system" class="pp-sheet-loop-btn" type="button" style="display:none" aria-pressed="false">Loop this line</button>
                <button id="__PP__-score-opts-btn" class="pp-score-opts-btn" type="button" aria-expanded="false" aria-controls="__PP__-score-opts" title="Choose what the score shows">Options</button>
                <button id="__PP__-sheet-close" class="pp-sheet-close" type="button" aria-label="Close the score" title="Close the score">&#215;</button>
              </div>
              <!-- The marks the score draws on top of the music. A singer told
                   us the moving bar highlight "jumps" and distracts, so it is
                   off until asked for, and everything here is remembered on
                   this device. Its own row under the nav rather than more
                   buttons in it: that row already carries seven controls and
                   an eighth wrapped on an iPad. -->
              <div id="__PP__-score-opts" class="pp-score-opts" hidden>
                <label class="pp-score-opt">
                  <input id="__PP__-opt-box" type="checkbox">
                  <span>Highlight the bar being sung</span>
                </label>
                <label class="pp-score-opt">
                  <input id="__PP__-opt-band" type="checkbox" checked>
                  <span>Highlight my part</span>
                </label>
                <label class="pp-score-opt pp-score-opt-range">
                  <span id="__PP__-opt-alpha-label">Strength</span>
                  <input id="__PP__-opt-alpha" type="range" min="25" max="150" step="5" value="100"
                         aria-labelledby="__PP__-opt-alpha-label">
                  <output id="__PP__-opt-alpha-out">100%</output>
                </label>
              </div>
              <div class="pp-sheet-canvas-wrap">
                <canvas id="__PP__-sheet-canvas" class="pp-sheet-canvas"></canvas>
                <div id="__PP__-dot" class="pp-follow-dot" style="display:none"></div>
                <div id="__PP__-follow-box" class="pp-follow-box" style="display:none" aria-hidden="true"><div class="pp-follow-beat"></div></div>
                <div id="__PP__-sheet-loading" class="pp-sheet-loading hidden">Loading score…</div>
              </div>
            </div>
          </div>`;
---

<li class="midi-practice flex flex-col" data-prefix={prefix} data-midi-config={config}>
  <!-- The title and composer get the full card width, and the buttons take the
       line under them, until the card is 1280px wide. An iPad is 768-1194px in
       either orientation, and at those widths three buttons on the right left
       the title a narrow column that broke a long song name across two lines. -->
  <div class="flex flex-col gap-2 xl:flex-row xl:items-center xl:justify-between">
    <div class="song-meta flex-1">
      <div class="song-titleblock">
        <p class="song-title font-medium">{title}</p>
        {composer && <p class="song-translation">{composer}</p>}
      </div>
      {desc && <p class="song-desc">{desc}</p>}
    </div>
    <div class="flex flex-wrap gap-2 md:gap-3 items-center">
      {pdf ? (
        <a
          aria-label={`Download ${title} sheet music PDF — opens in new tab`}
          href={pdf}
          target="_blank"
          rel="noopener noreferrer"
          class="action-btn pdf-btn"
        >🎵 <span class="hidden sm:inline">Sheet Music (PDF)</span><span class="inline sm:hidden">PDF</span></a>
      ) : (
        <span class="text-xs text-zinc-400 italic self-center">PDF coming soon</span>
      )}
      {youtube && (
        <a
          aria-label={`Watch a reference recording of ${title} on YouTube — opens in new tab`}
          href={youtube}
          target="_blank"
          rel="noopener noreferrer"
          class="action-btn yt-btn"
        >▶️ <span>YouTube</span></a>
      )}
      {guide && (
        <a
          aria-label={`${title}: ${guide.label} guide`}
          href={guide.href}
          class="action-btn guide-btn"
        >🗣️ <span>{guide.label}</span></a>
      )}
      <button
        id={`${prefix}-toggle`}
        class="action-btn practice-btn"
        aria-expanded="false"
        aria-controls={`${prefix}-panel`}
      >🎹 <span class="hidden sm:inline">Practice</span><span class="pp-chevron ml-1" aria-hidden="true">▾</span></button>
    </div>
  </div>
  <div id={`${prefix}-panel`} hidden class="px-3 pb-3 md:px-4 md:pb-4"
       style={`--pp-name-ch: ${longestPartName}`} />
  {emitPanelTemplate && (
    <script id="pp-panel-template" type="text/html" set:html={PANEL_MARKUP} />
  )}
</li>

<style is:global>
    /* --- Song list rows (ported from spring2026, scoped to the rehearsal list) --- */
    .resource-list > li { @apply px-3 md:px-4 py-2 md:py-3 transition-colors; }
    .resource-list > li:nth-child(odd) { @apply bg-white/[0.04]; }
    .resource-list > li:hover,
    .resource-list > li:focus-within { @apply bg-white/[0.12]; }
    .resource-list > li:hover .action-btn,
    .resource-list > li:focus-within .action-btn { @apply ring-white/20; }
    /* Single-column: the title/composer block runs to the buttons before
       wrapping. (A .song-desc, when present, simply stacks beneath.) */
    .resource-list .song-meta {
      @apply min-w-0;
      display: grid; gap: 0.15rem 1rem; grid-template-columns: 1fr; align-items: center;
    }
    /* Title and composer sit on one line, so each row stays short. The
       composer drops below the title only when the title fills the width. */
    .resource-list .song-titleblock {
      @apply min-w-0;
      display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 0.55rem;
    }
    .resource-list .song-translation::before {
      content: "\00b7"; margin-right: 0.55rem; @apply text-zinc-400;
    }
    .resource-list .song-title { @apply text-lg md:text-2xl font-semibold text-zinc-100 leading-snug; }
    .resource-list .song-translation { @apply text-sm md:text-base italic text-zinc-300 leading-snug; }
    .resource-list .song-desc { @apply text-sm md:text-lg text-zinc-200 font-medium leading-relaxed; max-width: 48ch; }
    .resource-list .action-btn {
      @apply inline-flex items-center gap-2 rounded-md px-4 text-base md:text-lg leading-none ring-1 ring-white/10 bg-white/5 text-zinc-100 font-medium transition-transform duration-150 ease-out;
      height: 2.75rem; box-sizing: border-box;
    }
    .resource-list .action-btn:hover,
    .resource-list .action-btn:focus-visible { transform: scale(1.03); }
    .resource-list .action-btn:active { transform: scale(0.98); }
    .resource-list .action-btn:hover { @apply bg-sky-500/20 ring-sky-400/60 text-white; }
    .resource-list .pdf-btn { @apply bg-transparent ring-1 ring-white/15 text-white font-semibold px-2.5 py-1.5 rounded-md; }
    .resource-list .pdf-btn:hover { @apply bg-sky-500/20 ring-sky-400/60 text-white no-underline; }
    .resource-list .yt-btn { @apply bg-transparent ring-1 ring-white/15 text-white font-semibold px-2.5 py-1.5 rounded-md; }
    .resource-list .yt-btn:hover { @apply bg-red-500/20 ring-red-400/60 text-white no-underline; }
    .resource-list .guide-btn { @apply bg-transparent ring-1 ring-white/15 text-white font-semibold px-2.5 py-1.5 rounded-md; }
    .resource-list .guide-btn:hover { @apply bg-yellow-500/15 ring-yellow-400/60 text-white no-underline; }
    @media (prefers-reduced-motion: reduce) {
      .resource-list .action-btn { transition: none; }
      .resource-list .action-btn:hover,
      .resource-list .action-btn:active { transform: none; }
    }

    /* Practice player — inline in Temporal row */
    .practice-btn[aria-expanded="true"] {
      @apply ring-white/30 bg-white/10;
    }
    /* One-time "look here" shimmer for a newly-added practice track. A page
       script adds/removes .is-spotlight after ~20s so this fades away instead
       of becoming a permanent design element. */
    .practice-btn.is-spotlight {
      position: relative;
      overflow: hidden;
      color: #fde68a;
      background-color: rgba(250, 204, 21, 0.16);
      box-shadow: inset 0 0 14px rgba(250, 204, 21, 0.22), 0 0 0 1px rgba(250, 204, 21, 0.5);
    }
    .practice-btn.is-spotlight::after {
      content: "";
      position: absolute;
      top: 0;
      left: -60%;
      width: 40%;
      height: 100%;
      pointer-events: none;
      background: linear-gradient(120deg, rgba(255, 255, 230, 0) 0%, rgba(255, 255, 230, 0.6) 50%, rgba(255, 255, 230, 0) 100%);
      transform: skewX(-20deg);
      animation: practice-btn-sheen 2.6s ease-in-out infinite;
    }
    @keyframes practice-btn-sheen {
      0% { left: -60%; }
      55% { left: 130%; }
      100% { left: 130%; }
    }
    @media (prefers-reduced-motion: reduce) {
      .practice-btn.is-spotlight::after { animation: none; display: none; }
    }
    /* The row whose player is open gets a gold edge and a lifted background, so
       it's obvious at a glance which song you clicked Practice on. */
    .resource-list > li.is-practicing,
    .resource-list > li.is-practicing:hover {
      @apply bg-yellow-500/[0.07];
      box-shadow: inset 3px 0 0 0 rgba(250,204,21,0.85);
    }
    /* Tape-deck transport buttons — tactile, raised, and they press down when hit */
    .pp-ctrl-btn, .pp-icon-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 7px;
      border-radius: 9px; cursor: pointer; font-weight: 600; color: #e6e8ec;
      background: linear-gradient(180deg, #34383f 0%, #23262c 100%);
      border: 1px solid rgba(0,0,0,0.5);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.09), 0 2px 3px rgba(0,0,0,0.45);
      transition: background 0.1s, box-shadow 0.08s, transform 0.06s, color 0.1s;
    }
    .pp-ctrl-btn { padding: 9px 14px; font-size: 0.95rem; min-height: var(--pp-btn-h, 42px); line-height: 1; }
    .pp-ctrl-btn:hover, .pp-icon-btn:hover {
      background: linear-gradient(180deg, #3c414a 0%, #282c33 100%); color: #fff;
    }
    .pp-ctrl-btn:active, .pp-icon-btn:active {
      transform: translateY(1px);
      box-shadow: inset 0 2px 5px rgba(0,0,0,0.55);
    }
    .pp-ctrl-btn.pp-play-btn {
      min-width: 5.5rem; color: #04250f;
      background: linear-gradient(180deg, #34d17f 0%, #1f9d5b 100%);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.3), 0 2px 4px rgba(0,0,0,0.45);
    }
    .pp-ctrl-btn.pp-play-btn:hover {
      color: #04250f; background: linear-gradient(180deg, #3ee08b 0%, #22a862 100%);
    }
    .pp-ctrl-btn.pp-play-btn.is-playing {
      color: #3a2a00; background: linear-gradient(180deg, #f7c948 0%, #e0a800 100%);
    }
    @media (max-width: 639px) {
      .pp-ctrl-btn { padding: 8px 10px; font-size: 0.85rem; }
      .pp-ctrl-btn.pp-play-btn { min-width: 3rem; }
      .pp-icon-btn { padding: 0 9px; font-size: 0.8rem; }
    }
    /* Show play icon when idle, pause icon when playing */
    .pp-play-btn .pp-icon-pause { display: none; }
    .pp-play-btn.is-playing .pp-icon-play { display: none; }
    .pp-play-btn.is-playing .pp-icon-pause { display: block; }

    /* The transport "deck" — a recessed bezel that groups the tape buttons into
       a clear player area, set into the panel like a hardware faceplate */
    /* Play, the two skips and Loop are what you touch while singing, so they
       sit together. Reset is the one you do not want to hit by accident, so it
       goes to the far right on its own.
       Two rows on a narrow screen, one row on a wide one. The rows are real
       boxes only where they are needed: the phone and the score sidebar. On a
       wide screen the wrappers go to display:contents and every control joins
       one flex line, so nothing wraps and Reset keeps the far right.
       --pp-btn-h is the one height every control in the deck answers to. The
       buttons each used to set their own, which is why Score and Download Mix
       sat shorter than the transport and the tempo box shorter still. Change
       it in one place per breakpoint, not in nine rules. */
    .pp-deck {
      --pp-btn-h: 42px;
      display: flex; flex-direction: column; align-items: stretch; gap: 8px;
      background: linear-gradient(180deg, rgba(0,0,0,0.34), rgba(0,0,0,0.22));
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 14px; padding: 12px 14px;
      box-shadow: inset 0 2px 6px rgba(0,0,0,0.45), 0 1px 0 rgba(255,255,255,0.04);
    }
    .pp-deck-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .pp-transport-btns { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    @media (min-width: 1280px) {
      /* One line, always. 1280 is where the page container stops narrowing;
         below it the deck is under 900px and nothing fits ten controls.
         The line is NOT made to fit by shaving padding. It is made to fit by
         letting ONE control give: the tempo stepper was the widest at 332px
         and is the only one whose meaning survives being narrow, so it shrinks
         and the other nine hold their size. A deck that fits by 1px wraps the
         moment a font renders wider; squeeze this one by another 120px and the
         tempo still swallows all of it. The score sidebar keeps its own
         stacked rows, because .pp-score-open wins on specificity. */
      .pp-deck { flex-direction: row; flex-wrap: nowrap; align-items: center; gap: 6px; }
      .pp-deck-row { display: contents; }
      .pp-ctrl-btn { padding: 9px 12px; }
      .pp-deck-row .pp-sheet-toggle-btn,
      .pp-deck-row .pp-export-btn { padding: 0 12px; }
      /* The play button reserved 5.5rem for a 20px icon. 4.5rem still makes it
         the widest control in the transport group. */
      .pp-ctrl-btn.pp-play-btn { min-width: 4.5rem; }
      /* Everything except the tempo holds its width. The flex items here are
         the ROW's children, not the deck's: the two row wrappers are
         display:contents and have no box of their own. Targeting .pp-deck > *
         misses every one of them, and Score, Download Mix and Reset shrink far
         enough to wrap their labels onto a second line. */
      .pp-deck-row > * { flex: 0 0 auto; }
      .pp-transport-btns { flex-wrap: nowrap; }
      /* Above 1536 the page container stops growing and the deck settles at
         1370px for 1105px of controls. All 265px of that slack used to pool in
         one place — the auto margin that pushes Reset to the right edge — so
         the other nine controls sat jammed against the left in a row that
         looked half empty. The gap widens and the two seams take a little
         more, which groups the row as it reads: transport · what the practice
         sounds like · what you take away · start over.
         Deliberately NOT applied below 1536, where the slack is zero and a
         wider gap would only clip the tempo again. */
      @media (min-width: 1536px) {
        .pp-deck { gap: 16px; }
        /* Three auto margins, not three fixed ones. Reset has always carried
           one to pin itself to the right edge, and an auto margin in a nowrap
           row is a slack sink: it swallows every spare pixel. That is why the
           row looked emptier the wider the screen got — one gap grew and the
           other nine controls stayed jammed together on the left.
           Flexbox splits free space equally between auto margins, so three of
           them make three even seams and the row fills edge to edge. It also
           tunes itself: below 1536 there is no slack, the autos contribute
           nothing, and the row is exactly as tight as it has to be. */
        .pp-deck-row .pp-metro-group { margin-left: auto; }
        .pp-deck-row .pp-sheet-toggle-btn { margin-left: auto; }
      }
      /* The tempo gives. Two things are needed and both are easy to get wrong.
         min-width:0 on every link in the chain, or the steps refuse to shrink
         and the deck spills out of the card, the same way it does in the
         sidebar. And the .pp-deck prefix on every one of these: the plain-class
         rules further down this file say flex-shrink:0, a media query adds no
         specificity of its own, and the later rule wins on source order — an
         unprefixed .pp-tempo-group here is simply ignored, with no error, and
         the deck overflows by 39px instead of the tempo giving way.
         The "%" goes first, as it already does on a phone and in the sidebar:
         six bare numbers under a TEMPO caption read the same, and each button
         keeps the percent in its aria-label. */
      .pp-deck .pp-tempo-group { flex: 0 1 auto; min-width: 0; }
      .pp-deck .pp-tempo-widget { flex: 0 1 auto; min-width: 0; }
      .pp-deck .pp-tempo-controls { padding: 3px 5px; }
      .pp-deck .pp-tempo-label { padding: 0 8px; font-size: 0.85rem; }
      .pp-deck .pp-tempo-controls { flex: 0 1 auto; min-width: 0; }
      .pp-deck .pp-tempo-steps { flex: 0 1 auto; min-width: 0; gap: 1px; }
      /* min-content, not 0: the step shrinks by giving up its side padding
         and stops at the width of its own digits. At 0 the digits wrap and the
         widget grows to 48px in a 42px row. */
      /* 4px, not 6. Moving the word "Tempo" inside the card cost ~26px of
         the stepper's width — the word's own padding plus the divider — and
         between 1280 and 1536 this row has NO spare width at all: it measures
         1114px used in 1114px available. The reset arrow was being clipped by
         the card's own overflow:hidden. Six steps giving up 2px a side each
         hands that width straight back. */
      .pp-deck .pp-tempo-step { flex: 0 1 auto; min-width: min-content; white-space: nowrap; padding: 4px 4px; }
      .pp-deck .pp-step-pct { display: none; }
    }
    /* Score and Download Mix carry a top margin for AudioPractice, which
       reuses them outside any deck. Inside the deck the row owns the spacing,
       and that margin was 12px of dead height. */
    .pp-deck-row .pp-sheet-toggle-btn,
    .pp-deck-row .pp-export-btn { margin-top: 0; }
    /* Reset is the one button here you do not want to hit by accident, so it
       sits apart from the rest, outlined rather than filled, in the same red
       the loop's end marker uses. */
    .pp-reset-btn {
      /* Last in the line wherever it lands, whatever the DOM order. */
      order: 9; margin-left: auto;
      background: transparent;
      border: 1px solid rgba(248,113,113,0.5);
      color: rgba(252,165,165,0.95);
      box-shadow: none;
    }
    .pp-reset-btn:hover {
      background: rgba(248,113,113,0.12);
      border-color: rgba(248,113,113,0.85);
      color: #fff;
    }
    .pp-reset-btn:active { box-shadow: inset 0 2px 5px rgba(0,0,0,0.4); }

    .pp-progress-track {
      position: relative;
      height: 32px; border-radius: 6px;
      background: rgba(255,255,255,0.07);
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08);
      cursor: pointer;
      overflow: hidden;
    }
    .pp-progress-canvas {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      display: block; pointer-events: none;
      z-index: 1;
    }
    .pp-progress-fill {
      position: absolute; top: 0; left: 0;
      height: 100%; width: 0%;
      background: rgba(255,255,255,0.07);
      z-index: 2; pointer-events: none;
    }

    /* Measure tick marks inside the progress track (MIDI beta) */
    .pp-measure-ticks { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
    .pp-measure-ticks .tk {
      position: absolute; top: 0; bottom: 0; width: 1px;
      background: rgba(255,255,255,0.12);
    }
    .pp-measure-ticks .tk.major { background: rgba(255,255,255,0.32); }
    /* Where the music jumps back to a repeat sign. NOT gold: the loop region
       behind it is gold, so a gold mark read as part of the loop and nobody
       could tell what it meant. Sky blue is the only strong colour left after
       gold (loop), green (loop start), red (loop end) and white (playhead). */
    .pp-measure-ticks .tk.repeat { background: rgba(125,211,252,0.9); width: 2px; }
    .pp-head {
      position: absolute; top: 0; bottom: 0; left: 0; width: 2px;
      background: rgba(255,255,255,0.92); z-index: 4; pointer-events: none;
      transform: translateX(-1px);
    }
    /* Numbered ruler below the progress track */
    /* Score-following dot (MIDI beta) */
    .pp-follow-dot {
      position: absolute; width: 14px; height: 14px; border-radius: 50%;
      background: rgba(248,113,113,0.92);
      box-shadow: 0 0 0 4px rgba(248,113,113,0.22);
      transform: translate(-50%, -50%); pointer-events: none; z-index: 5;
      transition: left 0.09s linear, top 0.14s ease;
    }
    .pp-follow-toggle {
      display: inline-flex; align-items: center; gap: 0.35rem; margin-left: auto;
      font-size: 0.85rem; color: rgba(255,255,255,0.72); cursor: pointer; user-select: none;
    }
    .pp-follow-toggle input { accent-color: rgba(248,113,113,0.9); }
    /* The measure that is sounding, boxed on the score. Gold, like the loop
       and the measure readout, and a whole bar tall: the map behind it knows
       barlines to the pixel but staves only to the system, and a box that
       covers the system is right for every voice at once. The thin line
       inside is the beat, driven by the MIDI clock. */
    /* Soft on purpose. The beat line is a wide, pale band and the box paler
       still: the timing is good to a fraction of a beat, not a pixel, and a
       hairline would claim a precision the map does not have (Howie,
       2026-09-16, after trying it on several songs). */
    /* Colour and strength come from two variables the script sets on the sheet
       section: --pp-ov-rgb is the singer's own part colour, taken from the same
       palette as their channel row, so the marks on the score match the lane
       they already read. --pp-ov-a scales every alpha together, so one slider
       moves the whole overlay without changing the balance between the box,
       its beat line and the part band. Gold is the fallback for "no part". */
    .pp-sheet-section { --pp-ov-rgb: 250,204,21; --pp-ov-a: 1; }
    .pp-follow-box {
      position: absolute; box-sizing: border-box;
      border: 2px solid rgba(var(--pp-ov-rgb), calc(0.38 * var(--pp-ov-a)));
      background: rgba(var(--pp-ov-rgb), calc(0.06 * var(--pp-ov-a)));
      border-radius: 6px; pointer-events: none; z-index: 5;
      transition: left 0.12s ease-out, top 0.12s ease-out, width 0.12s ease-out, height 0.12s ease-out;
    }
    .pp-follow-beat {
      position: absolute; top: 0; bottom: 0; width: 6px; left: 0;
      background: rgba(var(--pp-ov-rgb), calc(0.42 * var(--pp-ov-a))); transform: translateX(-3px);
    }
    @media (prefers-reduced-motion: reduce) { .pp-follow-box { transition: none; } }
    /* The words, for when the score is hidden: the bar that is sounding, big,
       with the bar before and the bar after around it in grey. */
    /* A display option rather than a transport control, so it lives on the
       info row with the legend and the egg. It is deliberately NOT in the deck:
       that row holds ten controls in exactly its own width between 1280 and
       1536, and an eleventh clipped the tempo stepper. */
    .pp-words-btn {
      padding: 2px 9px; border-radius: 5px; cursor: pointer; white-space: nowrap;
      font-size: 0.75rem; font-weight: 600;
      color: rgba(161,161,170,0.95); background: transparent;
      border: 1px solid rgba(255,255,255,0.16);
      transition: background 0.1s, color 0.1s, border-color 0.1s;
    }
    .pp-words-btn:hover { color: #fff; background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.35); }
    .pp-words-btn.is-active {
      color: #3a2a00; border-color: transparent;
      background: linear-gradient(180deg, #f7c948 0%, #e0a800 100%);
    }
    .pp-words-btn:focus-visible { outline: 2px solid rgba(250,204,21,0.75); outline-offset: 2px; }
    /* The words lane never shows beside the score, so its button has no
       business there either. */
    .pp-score-open .pp-words-btn { display: none; }

    /* The words scroll past the same playhead as the note lanes, one lane
       under the parts, so a syllable sits under the notes that carry it. The
       lane starts where the note lanes start (--pp-lane-x, measured at
       runtime) and is as wide as they are (--pp-lane-w), so its 20% playhead
       is their 20% playhead; wherever the lanes are hidden — a phone, the
       score sidebar — it takes the whole row. */
    .pp-words {
      margin: 0.5rem 0 0.2rem; padding: 0.35rem 0;
      padding-left: var(--pp-lane-x, 0px);
    }
    .pp-words-lane {
      display: block; height: 56px; width: var(--pp-lane-w, 100%); max-width: 100%;
      border-radius: 7px; background: rgba(0,0,0,0.28);
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.05);
    }

    /* === Mixer: one unified channel strip per voice part — name · scrolling
       note lane · Solo/Isolate · volume knob. Each part listed exactly once. === */
    /* The parts list does not scroll inside itself. It used to, with a
       max-height of 52svh (44svh on a phone), from when a nine-part score
       made the panel 1639px tall on an 844px phone. The rows have been
       compacted since, and the inner scroll did more harm than good: with
       overscroll-behavior: contain, the mouse wheel over the parts moved the
       list and never the page (Howie, 2026-09-29). The list is now as tall
       as its parts, and the page scrolls as usual. */
    /* Opening a player scrolls its card to the top of the screen, so leave a
       little air above it rather than butting it against the edge. */
    .resource-list > li { scroll-margin-top: 12px; }

    .pp-mixer {
      display: flex; flex-direction: column; gap: 5px; margin-top: 4px;
      padding: 2px 6px 2px 2px;
    }
    .pp-chan {
      display: flex; align-items: center; gap: 10px;
      padding: 5px 12px 5px 10px; border-radius: 12px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.07);
      border-left: 3px solid var(--trk, rgba(255,255,255,0.4));
      transition: background 0.12s, opacity 0.12s;
    }
    .pp-chan:hover { background: rgba(255,255,255,0.065); }
    .pp-chan.pp-chan-off { opacity: 0.5; }
    .pp-chan.pp-dimmed { opacity: 0.6; }

    /* Name rail — fixed width so every channel's controls line up, and so the
       part names form one column continuous with the pitch-lane labels above */
    .pp-chan-name {
      display: flex; align-items: center; gap: 8px;
      /* Sized to this song's longest part name (--pp-name-ch, set on the panel
         from the part list). A fixed width at 8.5rem read "Chorus II So...",
         which is not a part name; a fixed width wide enough for that wasted
         half a rail on "Alto 1". The 25px covers the checkbox and its gap. */
      /* --pp-name-w is measured from the real text once the rows exist; the
         ch calc is the estimate used until then. `ch` is the width of "0",
         which under-measures proportional text: at 9ch "Soprano 1" wrapped to
         two lines and "Tenor" sat against the Solo button (Howie, 2026-09-18). */
      width: var(--pp-name-w, calc(var(--pp-name-ch, 16) * 1.02ch + 25px));
      flex-shrink: 0;
      cursor: pointer; user-select: none;
      font-size: 1rem; color: rgba(255,255,255,0.92);
    }
    /* Wraps rather than truncates: the rail is cut to the voice parts, so an
       "Organ (Pedals)" takes two lines inside a row whose height is set by the
       44px dial beside it. A cut-off part name is not a part name. */
    .pp-chan-name .pp-track-name {
      font-weight: 500; line-height: 1.15; min-width: 0;
      /* Beats the shared .pp-track-name rule further down, which truncates with
         an ellipsis. In a rail cut to the voice parts, an accompaniment name
         has to wrap instead: "Piano (Right H..." is not a part name, and the
         row is 56px tall against two lines of 16. */
      white-space: normal; overflow: visible; text-overflow: clip;
    }
    .pp-chan-name input[type="checkbox"]:not(:checked) ~ .pp-track-name { color: rgba(255,255,255,0.4); }

    /* Boxed live readout of the note this part is singing right now — sits
       between the volume knob and the scrolling lane, so the eye can rest on
       it without the notes flowing underneath. Greyed (.is-coming) = the next
       note, shown while the part rests. .is-multi = divisi, two notes shown. */
    .pp-note-box {
      display: flex; align-items: center; justify-content: center;
      width: 3.4rem; height: 44px; flex-shrink: 0;
      border-radius: 8px; text-align: center;
      background: rgba(0,0,0,0.35);
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.16);
      color: var(--trk, rgba(255,255,255,0.85));
      font-weight: 700; font-size: 1.1rem; line-height: 1.1;
      font-variant-numeric: tabular-nums; overflow: hidden;
    }
    .pp-note-box.is-coming { color: rgba(255,255,255,0.4); }
    /* The readout doubles as a button, so it needs to look pressable. */
    .pp-note-box.is-playable {
      cursor: pointer; user-select: none; -webkit-user-select: none;
      transition: box-shadow 0.12s, background 0.12s, transform 0.06s;
    }
    .pp-note-box.is-playable:hover {
      background: rgba(255,255,255,0.08);
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.34);
    }
    .pp-note-box.is-playable:active { transform: scale(0.96); }
    .pp-note-box.is-playable:focus-visible {
      outline: 2px solid rgba(250,204,21,0.8); outline-offset: 2px;
    }
    .pp-note-box.is-sounding {
      background: color-mix(in srgb, var(--trk, #fff) 26%, transparent);
      box-shadow: inset 0 0 0 1px var(--trk, rgba(255,255,255,0.5));
    }
    @media (prefers-reduced-motion: reduce) {
      .pp-note-box.is-playable { transition: none; }
      .pp-note-box.is-playable:active { transform: none; }
    }
    .pp-note-box.is-multi { font-size: 0.8rem; }
    /* Accompaniment rows: invisible placeholder keeps the lanes aligned */
    .pp-note-box.is-off { visibility: hidden; }

    /* Custom outline-only checkbox */
    .pp-chan-name input[type="checkbox"] {
      appearance: none; -webkit-appearance: none;
      width: 17px; height: 17px; flex-shrink: 0;
      border: 1.5px solid rgba(255,255,255,0.28);
      border-radius: 3px; background: transparent;
      cursor: pointer; position: relative;
      transition: border-color 0.15s;
    }
    .pp-chan-name input[type="checkbox"]:checked { border-color: rgba(255,255,255,0.6); }
    .pp-chan-name input[type="checkbox"]:checked::before {
      content: '';
      position: absolute; left: 5px; top: 1px;
      width: 5px; height: 10px;
      border: 1.6px solid rgba(255,255,255,0.85);
      border-left: none; border-top: none;
      transform: rotate(45deg);
    }
    .pp-chan-name input[type="checkbox"]:focus-visible {
      outline: 2px solid rgba(250,204,21,0.7); outline-offset: 2px;
    }

    /* Solo / Isolate buttons — stacked and condensed, part of the left cluster */
    /* Side by side, not stacked. Stacking cost nothing in height while the
       dial was 56px tall, and costs a row of its own now that it is 44. */
    .pp-chan-btns { display: inline-flex; flex-direction: row; gap: 5px; flex-shrink: 0; }

    /* Wrapper around Solo/Isolate + volume: invisible on wide screens, becomes
       the channel's second line where the lane is hidden (narrow, score view) */
    .pp-chan-ctrls { display: contents; }

    /* Note lane — the part's scrolling notes; the row's main visual (replaces
       both the old separate pitch row and the redundant level bar) */
    .pp-lane {
      flex: 1; min-width: 40px; height: 44px; display: block;
      border-radius: 7px;
      background: rgba(0,0,0,0.28);
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.05);
    }
    .pp-chan-off .pp-lane,
    .pp-chan.pp-dimmed .pp-lane { opacity: 0.5; }

    /* Volume: rotary knob + % readout */
    .pp-chan-vol { display: inline-flex; align-items: center; gap: 8px; flex-shrink: 0; }
    /* The dial reads as a thing you take hold of: a hairline ring, the level
       shaded in behind it, and a grip in the part's own colour sitting on the
       arc at the current value. Tap the ring to jump; drag the grip around it.
       (The old version was a bare ring with a pointer line, which looked like
       something you turn but only answered a vertical swipe.) */
    .pp-knob {
      /* 44px, the same as the note box and the lane beside it, so no one part
         of the row decides how tall the row is. Still a full touch target. */
      position: relative; width: 44px; height: 44px; flex-shrink: 0;
      cursor: pointer; border-radius: 50%; touch-action: none; outline: none;
    }
    .pp-knob:focus-visible { box-shadow: 0 0 0 2px rgba(250,204,21,0.75); }
    .pp-knob.is-disabled { cursor: default; opacity: 0.4; }
    .pp-knob.is-muted { opacity: 0.5; }
    .pp-knob-svg { display: block; width: 100%; height: 100%; overflow: visible; }
    .pp-knob-track, .pp-knob-fill {
      transform: rotate(135deg); transform-origin: 20px 20px;
      stroke-linecap: round; stroke-width: 2.2; fill: none;
    }
    .pp-knob-track { stroke: rgba(255,255,255,0.14); }
    .pp-knob-fill { stroke: var(--trk, rgba(255,255,255,0.85)); transition: stroke-dasharray 0.05s linear; }
    /* Shaded sweep from silent up to the grip — gives the level a readable
       quantity instead of a hairline you have to squint at. */
    .pp-knob-wedge { fill: var(--trk, rgba(255,255,255,0.85)); opacity: 0.2; }
    /* Drawn wider than the track so it sits proud of it; the dark ring keeps
       it separate from the arc it shares a colour with. */
    .pp-knob-thumb {
      fill: var(--trk, rgba(255,255,255,0.85));
      stroke: rgba(0,0,0,0.75); stroke-width: 1.1;
      filter: drop-shadow(0 1px 2px rgba(0,0,0,0.8));
    }
    .pp-knob-halo { fill: var(--trk, rgba(255,255,255,0.85)); opacity: 0.22; }
    .pp-knob:hover .pp-knob-halo,
    .pp-knob.is-dragging .pp-knob-halo { opacity: 0.45; }
    @media (prefers-reduced-motion: reduce) {
      .pp-knob-fill { transition: none; }
    }

    /* Skip and loop icon buttons — share the tape-deck look above; just sized here */
    .pp-icon-btn { padding: 0 12px; font-size: 0.85rem; min-height: var(--pp-btn-h, 42px); line-height: 1; }
    .pp-icon-btn.is-active {
      color: #3a2a00;
      background: linear-gradient(180deg, #f7c948 0%, #e0a800 100%);
      box-shadow: inset 0 1px 3px rgba(0,0,0,0.4);
    }
    .pp-icon-btn.is-active:hover { color: #3a2a00; background: linear-gradient(180deg, #fbd35e 0%, #ecb200 100%); }

    /* The two words on the transport row.
       Tailwind's sm: keys off the VIEWPORT, which is the wrong question twice
       over: the score sidebar is 288px wide on a 1400px screen, and a phone is
       narrow at every breakpoint. So these carry their own classes and the
       rules below answer the right question in both places.
       A singer reported not finding the Loop button at all on a phone: it was
       an unlabelled icon, sitting beside a red Reset whose circular arrows
       read MORE like a loop than the loop's own icon did. Both wear a word
       now, at every width. */
    .pp-btn-long { display: none; }
    .pp-btn-short, .pp-btn-word { display: inline; }
    @media (min-width: 640px) {
      .pp-btn-long { display: inline; }
      .pp-btn-short { display: none; }
    }
    /* The sidebar is narrower than a phone, so it takes the short word too. */
    .pp-score-open .pp-btn-long { display: none; }
    .pp-score-open .pp-btn-short { display: inline; }
    /* Stacked, because 51px of a five-cell grid holds an icon over a word but
       not an icon beside one. Only these two: the skip buttons put their span
       on opposite sides of the icon, and stacking would flip one of them. */
    .pp-score-open .pp-punch-btn,
    .pp-score-open .pp-reset-btn {
      flex-direction: column; gap: 1px;
      height: var(--pp-btn-h, 36px); padding-top: 0; padding-bottom: 0;
    }
    .pp-score-open .pp-btn-short,
    .pp-score-open .pp-btn-word { font-size: 0.58rem; line-height: 1; }

    /* The loop button has three looks, because it has three meanings: neutral
       says "press me where the passage starts", green says "I am holding a
       start and waiting for the end", gold says "a loop is running". Colour
       carries the state on a phone, where the label is hidden and the word
       would not fit anyway. */
    .pp-punch-btn.is-armed {
      color: #bbf7d0;
      background: linear-gradient(180deg, #24402f 0%, #172a20 100%);
      border-color: rgba(74,222,128,0.65);
    }
    .pp-punch-btn.is-armed:hover {
      color: #fff; background: linear-gradient(180deg, #2c4c38 0%, #1d3428 100%);
    }
    /* Armed is the one state with a question hanging over it: the player is
       holding a start and waiting to be told where the passage ends. The
       shimmer is the same "look here" device .practice-btn.is-spotlight uses
       on a new song, and it needs no timer to stop being one — the state it
       lives in ends the moment the singer answers. */
    .pp-punch-btn.is-armed { position: relative; overflow: hidden; }
    .pp-punch-btn.is-armed::after {
      content: ""; position: absolute; top: 0; left: -60%;
      width: 40%; height: 100%; pointer-events: none;
      background: linear-gradient(120deg,
        rgba(187,247,208,0) 0%, rgba(187,247,208,0.45) 50%, rgba(187,247,208,0) 100%);
      transform: skewX(-20deg);
      animation: practice-btn-sheen 2.2s ease-in-out infinite;
    }

    /* Metronome toggle — a practice setting rather than a transport control, so
       it keeps the quieter outline-only idle state. It used to be a pill too,
       which just read as the one button somebody forgot to square off; the
       corner radius now matches the rest of the deck. */
    /* The toggle carries no border of its own: .pp-metro-group draws the card
       around the toggle AND the dial, and this button is the left compartment
       of it. Square corners, because the card's own corners are the round
       ones and the group clips them. */
    .pp-metronome-btn {
      display: inline-flex; align-items: center; gap: 7px;
      /* No height of its own: the card sets the height and this stretches to
         it. A min-height here adds the card's two border pixels on top and
         makes the card 2px taller than every button beside it. */
      padding: 0 14px; min-height: 0; border-radius: 0;
      font-weight: 600; font-size: 0.9rem; cursor: pointer;
      color: rgba(255,255,255,0.65);
      background: transparent;
      border: none;
      transition: background 0.1s, color 0.1s;
    }
    .pp-metronome-btn:hover { color: #fff; background: rgba(255,255,255,0.06); }
    .pp-metronome-btn.is-active {
      color: #3a2a00;
      background: linear-gradient(180deg, #f7c948 0%, #e0a800 100%);
      box-shadow: inset 0 1px 3px rgba(0,0,0,0.25);
    }
    .pp-metronome-btn.is-active:hover { color: #3a2a00; background: linear-gradient(180deg, #fbd35e 0%, #ecb200 100%); }
    @media (max-width: 639px) {
      .pp-metronome-btn { padding: 0 12px; font-size: 0.8rem; }
    }

    /* Loop region overlay and draggable markers on progress bar.
       Gold is reserved for the loop region — the played-progress fill is
       neutral white so the two don't read as one band. */
    .pp-loop-region {
      position: absolute; top: 0; bottom: 0; left: 0;
      background: rgba(250,204,21,0.22);
      pointer-events: none; z-index: 0;
    }
    .pp-loop-marker {
      position: absolute; top: 0; bottom: 0;
      width: 12px; transform: translateX(-50%);
      cursor: ew-resize; z-index: 3; touch-action: none;
      display: flex; align-items: stretch; justify-content: center;
    }
    .pp-loop-marker::before {
      content: ''; width: 2px; border-radius: 2px; flex-shrink: 0;
      transition: background 0.1s;
    }
    .pp-loop-marker::after {
      content: '';
      position: absolute; top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 9px; height: 9px; border-radius: 50%;
      border: 2px solid transparent;
      background: rgba(10,10,10,0.9);
      pointer-events: none; transition: border-color 0.1s;
    }
    /* A marker the singer is being pointed at. The ring grows out of the dot
       and fades, which reads as "this one moves" without moving it.
       Green while the loop waits for its end; red for a few seconds after the
       loop closes, because by then the end is the edge most likely to be a
       measure out. Both stop: a hint that never stops is just decoration, and
       .practice-btn.is-spotlight already set that rule in this file. */
    .pp-loop-marker.is-hint { z-index: 6; }
    .pp-loop-marker.is-hint::after { animation: pp-marker-pulse 1.5s ease-out infinite; }
    .pp-loop-mk-start.is-hint::after { --mk-glow: 74,222,128; }
    .pp-loop-mk-end.is-hint::after   { --mk-glow: 248,113,113; }
    @keyframes pp-marker-pulse {
      0%   { box-shadow: 0 0 0 0 rgba(var(--mk-glow), 0.55); }
      70%  { box-shadow: 0 0 0 9px rgba(var(--mk-glow), 0); }
      100% { box-shadow: 0 0 0 0 rgba(var(--mk-glow), 0); }
    }
    @media (prefers-reduced-motion: reduce) {
      .pp-punch-btn.is-armed::after { animation: none; display: none; }
      .pp-loop-marker.is-hint::after { animation: none; }
      /* The pointer still needs to land somewhere, so the hint becomes a
         steady ring rather than nothing at all. */
      .pp-loop-mk-start.is-hint::after { box-shadow: 0 0 0 4px rgba(74,222,128,0.35); }
      .pp-loop-mk-end.is-hint::after   { box-shadow: 0 0 0 4px rgba(248,113,113,0.35); }
    }

    /* Start marker: green */
    .pp-loop-mk-start::before { background: rgba(74,222,128,0.85); }
    .pp-loop-mk-start::after  { border-color: rgba(74,222,128,0.9); }
    .pp-loop-mk-start:hover::before, .pp-loop-mk-start.dragging::before { background: rgb(74,222,128); }
    .pp-loop-mk-start:hover::after,  .pp-loop-mk-start.dragging::after  { border-color: rgb(74,222,128); }
    /* End marker: red */
    .pp-loop-mk-end::before { background: rgba(248,113,113,0.85); }
    .pp-loop-mk-end::after  { border-color: rgba(248,113,113,0.9); }
    .pp-loop-mk-end:hover::before, .pp-loop-mk-end.dragging::before { background: rgb(248,113,113); }
    .pp-loop-mk-end:hover::after,  .pp-loop-mk-end.dragging::after  { border-color: rgb(248,113,113); }

    /* One line UNDER the progress bar: what the song is at the left, the loop
       section in the middle while the loop is on, and the saloon egg at the
       right. The loop controls had a row of their own below this one. They
       share this row now, which gives the music back a row of the screen. */
    /* Three columns, not a flex row with auto margins. Auto margins centre the
       loop between its NEIGHBOURS, so a score that shows the repeat legend
       pushed it right of the row's own middle. Equal 1fr columns on both sides
       put the middle column on the row's centre line whatever sits beside it.
       The price: the song text now has half the row less the loop, so a long
       one wraps to a second line sooner. */
    .pp-info-row {
      display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center; gap: 12px;
      min-height: 1.2rem;
    }
    .pp-info-left, .pp-info-right {
      display: flex; align-items: center; gap: 12px; flex-wrap: wrap; min-width: 0;
    }
    /* The legend rides in the RIGHT column, beside the egg. In the left column
       it shared the song text's half of the row, and on the one score that
       shows it the two together wrapped to a second line. */
    .pp-info-right { justify-content: flex-end; }
    .pp-status { margin: 0; font-size: 0.8rem; color: rgba(161,161,170,0.95); }
    .pp-info-row .pp-info-right { justify-self: end; }
    /* Elapsed and total, at the left-hand end of the progress bar's own row. */
    .pp-time-readout {
      flex-shrink: 0; white-space: nowrap;
      font-size: 0.78rem; color: rgba(161,161,170,0.95);
    }

    /* Says what the blue marks on the progress bar are. Singers asked what they
       meant, so the answer is printed beside the bar: always visible, on the
       score that has them, where the eye already is. Not a tooltip — a tooltip
       does not exist on a touch screen and does not answer a question nobody
       knows to ask. */
    .pp-legend {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 0.72rem; color: rgba(161,161,170,0.95);
      min-width: 0;
    }
    .pp-legend[hidden] { display: none; }
    .pp-legend-mark {
      flex: 0 0 auto; width: 3px; height: 0.85rem; border-radius: 1px;
      background: rgba(125,211,252,0.9);
    }

    /* Loop section bar. The script sets display to flex or none, so this rule
       carries no display of its own. */
    .pp-loop-bar {
      align-items: center; gap: 0.5rem;
      font-size: 0.8rem; flex-wrap: wrap;
    }
    /* The armed message and the stepper row are the two faces of this bar, and
       the script shows exactly one of them. Both lay out the same way. */
    .pp-loop-armed, .pp-loop-steps {
      align-items: center; gap: 0.4rem; flex-wrap: wrap;
    }
    .pp-loop-pip {
      width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0;
      background: rgb(74,222,128);
      box-shadow: 0 0 0 3px rgba(74,222,128,0.22);
    }
    .pp-loop-armed { color: rgba(187,247,208,0.95); }
    .pp-loop-armed b { color: #fff; font-weight: 600; }
    /* Each end says what it is, rather than leaning on an arrow between them.
       An arrow needs both boxes on one line to mean anything, and a phone
       cannot give them one; "from m." and "to m." still read when the second
       stepper drops onto a line of its own. */
    .pp-edge { display: inline-flex; align-items: center; gap: 0.35rem; }
    .pp-edge-label {
      font-weight: 600; color: rgba(228,228,231,0.95); white-space: nowrap;
    }
    /* Stepper: two buttons welded to the number they move. One measure per
       press, because that is the unit a singer names; the box between them
       still takes a beat ("33 · 2") or a whole range ("33-40") by hand. */
    .pp-stepper { display: inline-flex; align-items: stretch; }
    .pp-step-btn {
      width: var(--pp-step-h, 30px); height: var(--pp-step-h, 30px);
      flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
      font-size: 1.05rem; font-weight: 600; line-height: 1; cursor: pointer;
      color: rgba(255,255,255,0.9);
      background: linear-gradient(180deg, #32363d 0%, #202429 100%);
      border: 1px solid rgba(255,255,255,0.12);
      padding: 0;
    }
    .pp-step-btn:first-child { border-radius: 5px 0 0 5px; border-right: 0; }
    .pp-step-btn:last-child  { border-radius: 0 5px 5px 0; border-left: 0; }
    .pp-step-btn:hover { background: linear-gradient(180deg, #3c414a 0%, #282c33 100%); color: #fff; }
    .pp-step-btn:active { box-shadow: inset 0 2px 5px rgba(0,0,0,0.5); }
    .pp-step-btn:disabled { opacity: 0.35; cursor: default; background: linear-gradient(180deg, #2a2d33 0%, #1c1f23 100%); }
    /* The number is an input, not a label: typing is the escape hatch for a
       measure too far away to step to. Sized for "100", and widened only on
       the scores where a repeat makes the pass part of the address. */
    .pp-step-val {
      width: 3.1rem; height: var(--pp-step-h, 30px); padding: 0 2px;
      text-align: center; font-size: 0.9rem; font-weight: 700;
      background: rgba(0,0,0,0.45);
      border: 1px solid rgba(255,255,255,0.12); border-radius: 0;
      color: rgba(255,255,255,0.9);
      font-variant-numeric: tabular-nums; outline: none;
      transition: border-color 0.15s, background 0.15s;
    }
    .pp-step-val.has-pass { width: 5.6rem; }
    .pp-step-val:focus { background: rgba(255,255,255,0.10); border-color: rgba(255,255,255,0.5); }
    .pp-step-val.pp-time-start { color: rgb(134,239,172); }
    .pp-step-val.pp-time-end   { color: rgb(252,165,165); }
    .pp-step-val.pp-time-start:focus { border-color: rgba(74,222,128,0.75); }
    .pp-step-val.pp-time-end:focus   { border-color: rgba(248,113,113,0.75); }
    /* Ends the loop from the bar itself. The transport button no longer
       toggles: it always starts a new loop, so the off switch lives here. */
    .pp-loop-off-btn {
      padding: 0 8px; height: var(--pp-step-h, 30px);
      font-size: 0.75rem; cursor: pointer; white-space: nowrap;
      color: rgba(252,165,165,0.95);
      background: transparent;
      border: 1px solid rgba(248,113,113,0.4); border-radius: 5px;
    }
    .pp-loop-off-btn:hover { background: rgba(248,113,113,0.14); border-color: rgba(248,113,113,0.85); color: #fff; }
    /* Reopens the how-to card. Quiet on purpose: a singer who needs it looks
       for it, and one who does not never notices it. */
    .pp-loop-help-btn {
      width: var(--pp-step-h, 30px); height: var(--pp-step-h, 30px);
      flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
      font-size: 0.85rem; font-weight: 700; cursor: pointer;
      color: rgba(161,161,170,0.9); background: transparent;
      border: 1px solid rgba(255,255,255,0.14); border-radius: 50%;
    }
    .pp-loop-help-btn:hover { color: #fff; background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.35); }
    /* How long the passage is, and the way out of it. They travel together:
       on a phone the two steppers fill the line and this pair drops onto a
       second one, where the length sits left and the off switch sits right. */
    .pp-loop-summary { display: inline-flex; align-items: center; gap: 0.5rem; }
    .pp-loop-clock {
      color: rgba(161,161,170,0.9); font-size: 0.75rem;
      font-variant-numeric: tabular-nums; white-space: nowrap;
    }

    /* Animated waveform bars — shown while playing */
    .pp-waveform {
      display: flex; align-items: center; gap: 2px;
      height: 18px; flex-shrink: 0;
    }
    .pp-waveform span {
      display: block; width: 3px; border-radius: 2px;
      background: rgba(255,255,255,0.45);
      animation: pp-wave 0.85s ease-in-out infinite;
    }
    .pp-waveform span:nth-child(1) { height: 45%; animation-delay: 0.00s; }
    .pp-waveform span:nth-child(2) { height: 90%; animation-delay: 0.14s; }
    .pp-waveform span:nth-child(3) { height: 55%; animation-delay: 0.28s; }
    .pp-waveform span:nth-child(4) { height: 100%; animation-delay: 0.42s; }
    .pp-waveform span:nth-child(5) { height: 65%; animation-delay: 0.56s; }
    @keyframes pp-wave {
      0%, 100% { transform: scaleY(0.2); opacity: 0.3; }
      50%       { transform: scaleY(1);   opacity: 1; }
    }

    .note-spin { display: inline-block; animation: pp-spin 1s linear infinite; }
    @keyframes pp-spin { to { transform: rotate(360deg); } }

    /* The metronome and its volume are ONE card: the toggle fills the left of
       it and the dial sits in its own compartment at the right, behind a
       hairline. The dial used to float loose beside the button, where it read
       as a stray knob that belonged to nothing. The card draws the border, so
       .pp-metronome-btn draws none, and overflow:hidden clips the toggle's gold
       to the rounded corners. */
    .pp-metro-group {
      display: inline-flex; align-items: stretch; flex-shrink: 0;
      min-height: var(--pp-btn-h, 42px);
      border: 1px solid rgba(255,255,255,0.18); border-radius: 9px;
      overflow: hidden; transition: border-color 0.1s;
    }
    .pp-metro-group:hover { border-color: rgba(255,255,255,0.32); }
    .pp-metro-vol {
      display: inline-flex; align-items: center; padding: 0 8px;
      border-left: 1px solid rgba(255,255,255,0.14);
    }
    /* Smaller than a mixer dial, because it now shares the height of a button
       rather than owning a row. Three class names, so the wider dial of score
       mode does not win on specificity and burst the card. */
    .pp-metro-vol .pp-knob.pp-knob-sm { width: 32px; height: 32px; }
    .pp-knob.pp-knob-sm { width: 42px; height: 42px; }

    /* Tempo, built as the metronome's twin: one bordered card, the word
       inside it, a hairline dividing the word from the control it names.
       The word used to sit OUTSIDE the box, because inside it read as the
       first segment of the stepper — flush against the 50 button in the same
       frame. The divider is what answers that, and it is the same divider
       .pp-metro-vol draws between "Metronome" and its dial. Both words now
       share one size, one weight and one colour, and neither shouts in caps. */
    .pp-tempo-group { display: inline-flex; align-items: center; flex-shrink: 0; }
    .pp-tempo-widget {
      display: inline-flex; align-items: stretch; flex-shrink: 0;
      min-height: var(--pp-btn-h, 42px); box-sizing: border-box;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 8px; overflow: hidden;
    }
    .pp-tempo-label {
      display: inline-flex; align-items: center;
      padding: 0 12px; margin: 0; white-space: nowrap;
      font-size: 0.9rem; font-weight: 600; color: rgba(255,255,255,0.65);
      border-right: 1px solid rgba(255,255,255,0.14);
    }
    .pp-tempo-controls {
      display: flex; align-items: center; gap: 2px;
      padding: 3px 6px;
    }
    .pp-tempo-steps {
      display: flex; align-items: center; gap: 2px;
    }
    .pp-tempo-step {
      display: inline-flex; align-items: center; justify-content: center;
      padding: 3px 8px; border-radius: 4px; flex-shrink: 0;
      background: transparent; color: rgba(255,255,255,0.50);
      font-size: 0.75rem; font-weight: 600; line-height: 1; cursor: pointer;
      border: 1px solid transparent;
      user-select: none; -webkit-user-select: none;
      transition: background 0.1s, color 0.1s, border-color 0.1s;
    }
    .pp-tempo-step:hover { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.75); }
    .pp-tempo-step.is-active {
      background: rgba(250,204,21,0.18); color: rgba(250,204,21,1.0);
      border-color: rgba(250,204,21,0.55);
    }
    .pp-tempo-reset-btn {
      display: inline-flex; align-items: center; justify-content: center;
      width: 1.4rem; height: 1.4rem; border-radius: 4px; flex-shrink: 0;
      background: transparent; color: rgba(250,204,21,0.55);
      /* 8px, not 3: inside the card the reset now sits immediately after the
         gold "100" and read as a seventh step. The gap is what separates the
         control from the thing that undoes it. */
      font-size: 0.85rem; cursor: pointer; margin-left: 8px;
      user-select: none; -webkit-user-select: none; transition: background 0.1s, color 0.1s;
    }
    .pp-tempo-reset-btn:hover { background: rgba(250,204,21,0.12); color: rgba(250,204,21,0.95); }
    .pp-tempo-bpm-input {
      width: 3.4rem; padding: 2px 5px; font-size: 0.72rem; text-align: center;
      background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14);
      border-radius: 4px; color: rgba(255,255,255,0.6); outline: none;
      margin-left: 3px;
    }
    .pp-tempo-bpm-input:focus { border-color: rgba(255,255,255,0.35); color: rgba(255,255,255,0.9); }
    .pp-tempo-bpm-input::placeholder { color: rgba(255,255,255,0.22); }

    /* Track name — truncates when space is tight (score view sidebar) */
    .pp-track-name {
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;
    }

    /* Solo / Isolate buttons per track — shared base */
    .pp-focus-btn, .pp-iso-btn {
      display: inline-flex; align-items: center; justify-content: center;
      width: auto; padding: 0 10px; font-size: 0.74rem; font-weight: 600;
      letter-spacing: 0.01em;
      border-radius: 6px; cursor: pointer; flex-shrink: 0;
      min-height: 30px;
      border: 1px solid rgba(255,255,255,0.20);
      background: transparent; color: rgba(255,255,255,0.62);
      transition: background 0.1s, color 0.1s, border-color 0.1s, box-shadow 0.1s;
      user-select: none;
    }
    /* Solo — gold when active */
    .pp-focus-btn:hover {
      background: rgba(250,204,21,0.10); color: rgba(250,204,21,0.72);
      border-color: rgba(250,204,21,0.35);
    }
    .pp-focus-btn.is-focused {
      background: rgba(250,204,21,0.22); color: rgba(250,204,21,1.0);
      border-color: rgba(250,204,21,0.70);
      box-shadow: 0 0 7px rgba(250,204,21,0.30);
    }
    /* ISO — cyan when active */
    .pp-iso-btn:hover {
      background: rgba(56,189,248,0.10); color: rgba(56,189,248,0.72);
      border-color: rgba(56,189,248,0.35);
    }
    .pp-iso-btn.is-focused {
      background: rgba(56,189,248,0.22); color: rgba(56,189,248,1.0);
      border-color: rgba(56,189,248,0.70);
      box-shadow: 0 0 7px rgba(56,189,248,0.30);
    }

    /* "Download Mix" — renders the current settings to an MP3 download.
       It sits beside "Score" under the mixer and shares that button's
       shape; the one rule below is what keeps the pair matched. */
    .pp-export-btn:disabled { opacity: 0.45; cursor: progress; }
    .pp-bottom-actions {
      display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;
    }
    /* Shown only while the browser has parked the audio. Amber, the site's
       colour for "waiting on something", not rose: nothing is broken and on
       every browser but Safari the next press of play fixes it. Sized like
       body copy rather than a footnote, because a singer who cannot hear
       anything needs to be able to read it. */
    .pp-audio-alert {
      margin: 0 0 0.75rem;
      padding: 0.6rem 0.8rem;
      border-radius: 0.5rem;
      background: rgba(245, 158, 11, 0.12);
      box-shadow: inset 0 0 0 1px rgba(245, 158, 11, 0.35);
      color: #fcd34d;
      font-size: 1rem;
      line-height: 1.4;
    }
    .pp-audio-alert[hidden] { display: none; }

    .pp-export-status {
      margin-top: 0.4rem; font-size: 0.85rem; color: #d4d4d8;
      display: flex; align-items: center; gap: 8px;
    }
    /* Any display value set on a class outranks the UA rule for the hidden
       attribute, so every element here that carries one needs its own hide rule.
       Without this, el.hidden = true changes nothing and the line never goes away. */
    .pp-export-status[hidden] { display: none; }
    .pp-export-status .note-spin[hidden] { display: none; }
    .pp-export-close {
      margin-left: auto; flex-shrink: 0;
      width: 28px; height: 28px; line-height: 1; font-size: 1.1rem;
      display: inline-flex; align-items: center; justify-content: center;
      color: rgba(255,255,255,0.55); background: none;
      border: 1px solid transparent; border-radius: 6px; cursor: pointer;
    }
    .pp-export-close:hover { color: #fff; background: rgba(255,255,255,0.10); }
    .pp-export-close[hidden] { display: none; }
    .pp-export-status.is-error { color: #fda4af; }
    .pp-export-status.is-done { color: #6ee7b7; }
    .pp-export-bar {
      flex: 1; max-width: 220px; height: 6px; border-radius: 3px;
      background: rgba(255,255,255,0.12); overflow: hidden;
    }
    .pp-export-bar > i { display: block; height: 100%; width: 0%; background: #eab308; transition: width 0.15s linear; }

    /* Easter egg cowboy button — quiet until discovered */
    .pp-egg-btn {
      background: none; border: none; cursor: pointer;
      font-size: 1rem; line-height: 1; padding: 0 2px;
      opacity: 0.15; transition: opacity 0.15s, transform 0.15s;
      flex-shrink: 0;
    }
    .pp-egg-btn:hover { opacity: 0.60; }
    .pp-egg-btn.is-active {
      opacity: 1.0;
      animation: pp-egg-sway 0.8s ease-in-out infinite alternate;
    }
    @keyframes pp-egg-sway {
      from { transform: rotate(-8deg); }
      to   { transform: rotate( 8deg); }
    }

    /* The per-part pitch view is now merged into each channel row (.pp-lane),
       so the old standalone pitch card is unused. */
    .pp-waveview { display: none; }

    /* Sheet music viewer. AudioPractice has no stylesheet of its own and reuses
       .pp-sheet-toggle-btn outside .pp-bottom-actions, so the margin stays on
       the button rather than moving to the row. */
    .pp-sheet-toggle-btn,
    .pp-export-btn {
      display: inline-flex; align-items: center; gap: 7px; margin-top: 0.75rem;
      padding: 0 16px; min-height: var(--pp-btn-h, 42px); box-sizing: border-box;
      font-size: 0.95rem; font-weight: 500;
      color: rgba(255,255,255,0.75); background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.18); border-radius: 8px;
      cursor: pointer; transition: background 0.15s, color 0.15s, border-color 0.15s;
    }
    .pp-sheet-toggle-btn:hover,
    .pp-export-btn:hover:not(:disabled) {
      background: rgba(250,204,21,0.10); color: rgba(250,204,21,0.95);
      border-color: rgba(250,204,21,0.45);
    }
    .pp-sheet-section { margin-top: 0.75rem; }
    .pp-sheet-nav {
      display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;
    }
    /* Five controls do not fit across a 390px phone, and the X has to stay
       reachable, so the bar wraps instead of pushing it off the edge. */
    @media (max-width: 639px) {
      .pp-score-open .pp-sheet-nav { flex-wrap: wrap; row-gap: 0.4rem; }
      /* Two lines, in this order: the page counter, the follow switch and the
         X on the first, "My part" and the row loop on the second. The X is
         ordered onto the first line on purpose — it is the way out of the
         score, and stranded on a line of its own below it read as a control
         belonging to the loop button beside it. */
      .pp-score-open .pp-sheet-page-info { order: 1; }
      .pp-score-open .pp-sheet-nav .pp-follow-toggle { order: 2; }
      .pp-score-open .pp-sheet-close { order: 3; margin-left: auto; }
      .pp-score-open .pp-part-pick { order: 4; margin-left: 0; }
      .pp-score-open .pp-sheet-loop-btn { order: 5; }
      /* "Follow the music" spells itself out where there is room for it. */
      .pp-score-open .pp-follow-rest { display: none; }
      /* No push to the right here: the button rides beside "My part" and the
         X, which keeps the bar to two lines. Pushed right it took a third
         line of its own, and a sticky bar three lines deep is score a phone
         does not show. */
      .pp-sheet-loop-btn { margin-left: 0; font-size: 0.78rem; padding: 8px 10px; }
      .pp-sheet-loop-btn .pp-mm { display: none; }
    }
    /* Turning a page scrolls the new page's top into view, which used to carry
       this bar off the top of the screen with it — so you turned the page and
       lost sight of which page you were on. Sticky keeps the counter visible
       for the whole page. */
    .pp-score-open .pp-sheet-nav {
      position: sticky; top: 0; z-index: 8;
      margin: 0 -4px 0.5rem; padding: 6px 10px;
      border-radius: 0 0 10px 10px;
      background: rgba(10,10,12,0.94);
      border-bottom: 1px solid rgba(255,255,255,0.1);
      backdrop-filter: blur(6px);
    }
    .pp-score-open .pp-sheet-page-info {
      font-size: 0.9rem; font-weight: 600; color: rgba(255,255,255,0.8);
    }
    /* The way out of the score view is an X in the bar that never leaves the
       screen. "Hide Score" sat in the sidebar under the tempo row and was
       easy to lose (Howie, 2026-09-16), and Download Mix beside it is not
       something anyone does from the score, so both go while the score is
       open. The mini transport at the foot of a phone keeps its own
       "Hide score" for the single-column layout. */
    .pp-sheet-close {
      display: none; align-items: center; justify-content: center;
      width: 40px; height: 40px; margin-left: 0.5rem; flex: 0 0 auto;
      border-radius: 50%; font-size: 1.6rem; line-height: 1;
      color: rgba(255,255,255,0.85); background: rgba(255,255,255,0.10);
      border: 1px solid rgba(255,255,255,0.25); cursor: pointer;
    }
    .pp-sheet-close:hover { background: rgba(250,204,21,0.18); color: rgba(250,204,21,0.95); border-color: rgba(250,204,21,0.5); }
    .pp-sheet-close:focus-visible { outline: 2px solid rgba(250,204,21,0.85); outline-offset: 2px; }
    .pp-score-open .pp-sheet-close { display: inline-flex; }
    /* "Loop mm. 19-22": drill the row of music the box is in, without typing
       two measure numbers or punching two presses. The label carries the
       measures rather than the word "system", because the measures are what
       the page prints and what the director says. Gold when it is running,
       the same gold the loop region wears, and pressing it again lets go. */
    .pp-sheet-loop-btn {
      margin-left: auto; flex: 0 0 auto; white-space: nowrap; cursor: pointer;
      padding: 7px 12px; border-radius: 7px;
      font-size: 0.82rem; font-weight: 600;
      color: rgba(250,204,21,0.92); background: rgba(250,204,21,0.10);
      border: 1px solid rgba(250,204,21,0.45);
      transition: background 0.12s, color 0.12s;
    }
    .pp-sheet-loop-btn:hover { background: rgba(250,204,21,0.20); color: #fde68a; }
    .pp-sheet-loop-btn:focus-visible { outline: 2px solid rgba(250,204,21,0.85); outline-offset: 2px; }
    .pp-sheet-loop-btn.is-active {
      color: #3a2a00; border-color: rgba(250,204,21,0.9);
      background: linear-gradient(180deg, #f7c948 0%, #e0a800 100%);
    }
    .pp-sheet-loop-btn.is-active:hover { color: #3a2a00; background: linear-gradient(180deg, #fbd35e 0%, #ecb200 100%); }
    /* "My part": which staff to pick out inside the measure box. The choice
       is remembered across songs (localStorage), because a singer is an alto
       in every piece. */
    .pp-part-pick {
      display: inline-flex; align-items: center; gap: 0.35rem; margin-left: 0.75rem;
      font-size: 0.85rem; color: rgba(255,255,255,0.72); white-space: nowrap;
    }
    .pp-part-pick select {
      font-size: 0.9rem; padding: 4px 6px; border-radius: 6px; max-width: 9.5rem;
      color: rgba(255,255,255,0.9); background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.25);
    }
    @media (max-width: 639px) { .pp-part-pick { margin-left: 0.4rem; } .pp-part-pick select { max-width: 7rem; } }
    /* The singer's own staff, inside the measure box: the same gold, denser,
       and tall enough to take the words under the staff with it. */
    .pp-follow-part {
      position: absolute; box-sizing: border-box; pointer-events: none; z-index: 6;
      border: 3px solid rgba(var(--pp-ov-rgb), calc(0.95 * var(--pp-ov-a)));
      background: rgba(var(--pp-ov-rgb), calc(0.22 * var(--pp-ov-a)));
      border-radius: 4px;
      transition: left 0.12s ease-out, top 0.12s ease-out, width 0.12s ease-out, height 0.12s ease-out;
    }

    /* The options row. Wraps, because an iPad in portrait puts the slider on a
       second line and a clipped slider is worse than a taller panel. */
    /* `display: flex` on the class outranks the browser's own
       [hidden] { display: none }, so the panel rendered while still carrying
       the hidden attribute. State it back explicitly. */
    .pp-score-opts[hidden] { display: none; }
    .pp-score-opts {
      display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 1.1rem;
      padding: 0.5rem 0.25rem 0.1rem;
      border-top: 1px solid rgba(255,255,255,0.08);
      margin-top: 0.4rem;
    }
    .pp-score-opt {
      display: inline-flex; align-items: center; gap: 0.4rem;
      font-size: 0.8rem; color: rgba(228,228,231,0.92); cursor: pointer;
      /* 24px tall so a tap lands, per WCAG 2.2 SC 2.5.8. Singers here skew
         past 60 and many read the score on an iPad. */
      min-height: 24px;
    }
    .pp-score-opt input[type="checkbox"] { width: 16px; height: 16px; accent-color: #f7c948; }
    .pp-score-opt-range { gap: 0.5rem; cursor: default; }
    .pp-score-opt-range input[type="range"] { width: 8rem; accent-color: #f7c948; }
    .pp-score-opt-range output {
      font-variant-numeric: tabular-nums; min-width: 3ch;
      color: rgba(161,161,170,0.95);
    }
    /* Deliberately NOT .pp-sheet-btn: that class is hidden inside the nav once
       the score is open (the page arrows move next to the music), and score-open
       is exactly when a singer wants these controls. Same look, own rule. */
    .pp-score-opts-btn {
      padding: 4px 12px; border-radius: 5px; font-size: 0.8rem;
      background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.15);
      color: rgba(255,255,255,0.7); cursor: pointer; transition: background 0.15s;
    }
    .pp-score-opts-btn:hover { background: rgba(255,255,255,0.13); color: rgba(255,255,255,0.95); }
    .pp-score-opts-btn[aria-expanded="true"] {
      background: rgba(255,255,255,0.16); color: #fff;
      border-color: rgba(255,255,255,0.4);
    }
    @media (prefers-reduced-motion: reduce) { .pp-follow-part { transition: none; } }
    .pp-score-open .pp-export-btn,
    .pp-score-open .pp-sheet-toggle-btn { display: none; }
    .pp-sheet-btn {
      padding: 4px 12px; border-radius: 5px; font-size: 0.8rem;
      background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.15);
      color: rgba(255,255,255,0.7); cursor: pointer; transition: background 0.15s;
    }
    .pp-sheet-btn:hover { background: rgba(255,255,255,0.13); color: rgba(255,255,255,0.95); }
    .pp-sheet-page-info {
      flex: 1; text-align: center; font-size: 0.8rem;
      color: rgba(255,255,255,0.5); font-variant-numeric: tabular-nums;
    }
    .pp-sheet-canvas-wrap {
      position: relative; background: #1a1a1a; border-radius: 4px; overflow: hidden;
    }
    .pp-sheet-canvas { display: block; width: 100%; max-width: 100%; }

    /* Page turns used to live only in the bar above the score. A page is taller
       than the screen, so by the time you reach the bottom of one they are off
       the top and you have to scroll back up to turn it. These ride at
       mid-viewport over the music instead and follow the scroll, so a page turn
       is always under your thumb. */
    .pp-page-arrows { display: none; }
    .pp-score-open .pp-page-arrows {
      display: block;
      position: sticky; top: 50vh; height: 0; z-index: 7;
      pointer-events: none;   /* only the buttons take taps */
    }
    .pp-page-arrow {
      pointer-events: auto; position: absolute; top: 0;
      transform: translateY(-50%);
      width: 54px; height: 54px; border-radius: 999px;
      display: inline-flex; align-items: center; justify-content: center;
      font: inherit; font-size: 1.75rem; line-height: 1; padding: 0 0 4px;
      cursor: pointer; color: #fff;
      background: rgba(12,12,14,0.78);
      border: 1px solid rgba(255,255,255,0.32);
      box-shadow: 0 4px 16px rgba(0,0,0,0.7);
      backdrop-filter: blur(4px);
      transition: background 0.12s, border-color 0.12s;
    }
    .pp-page-arrow:hover { background: rgba(30,30,34,0.92); border-color: rgba(255,255,255,0.5); }
    .pp-page-arrow:focus-visible { outline: 2px solid rgba(250,204,21,0.85); outline-offset: 3px; }
    .pp-page-arrow[disabled] { opacity: 0.25; cursor: default; box-shadow: none; }
    .pp-page-prev { left: 8px; }
    .pp-page-next { right: 8px; }
    /* The bar above keeps the page counter; its arrows would just be a second
       copy of these, and further away from the music. */
    .pp-score-open .pp-sheet-nav .pp-sheet-btn { display: none; }
    @media (prefers-reduced-motion: reduce) {
      .pp-page-arrow { transition: none; }
    }
    .pp-sheet-loading {
      display: none;
      position: absolute; inset: 0; align-items: center; justify-content: center;
      background: rgba(0,0,0,0.55); font-size: 0.85rem; color: rgba(255,255,255,0.6);
    }

    /* Two-column score mode: controls sidebar + score main area.
       The threshold used to be 600px, which made widening the window shrink
       the score: at 599px the score got 507px of width, at 601px the fixed
       290px sidebar took over and left it 203px. An iPad in portrait (768px)
       landed in that trough at 326px — about 40% of natural size, which is
       what singers were reporting as unreadable. The sidebar is always ~306px
       of width taken away from the music, so it only earns its place once the
       score is still comfortable without it. 960px was the first attempt and it
       only moved the cliff: at 1000px the score dropped to 582px (71%) when one
       pixel narrower would have given it 968px. The threshold is now set where
       the two-column score is still at least full natural size, so crossing it
       never makes the music small, only less roomy. */
    @media (min-width: 1160px) and (min-aspect-ratio: 1/1) {
      .pp-score-open {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
      }
      .pp-score-open .pp-controls-wrap {
        flex: 0 0 290px;
        align-self: flex-start;
        position: sticky;
        top: 1rem;
        max-height: calc(100vh - 2rem);
        overflow-y: auto;
        /* card styling */
        background: rgba(0,0,0,0.35);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 10px;
        padding: 10px 10px 12px;
        scrollbar-width: thin;
        scrollbar-color: rgba(255,255,255,0.1) transparent;
      }
      .pp-score-open .pp-sheet-section {
        flex: 1;
        min-width: 0;
        margin-top: 0;
      }
      /* The transport stays on screen while the part list scrolls under it.
         The sidebar is already sticky to the viewport, but it is its own
         scroll container (max-height + overflow-y above), and with fourteen
         voice rows the play button scrolled out of the top of it — so the
         controls were unreachable exactly while the music was playing (Howie,
         2026-09-18: "the player and play button ... is invisible as it moves
         around"). Sticking it inside that container pins it to the top of the
         sidebar instead.
         Opaque, because the rows scroll underneath it. The negative margins
         let the background reach the sidebar's padding edges, so nothing shows
         through at the corners, and the padding puts the space back. */
      .pp-score-open .pp-controls-wrap > [id$="-transport"] {
        position: sticky;
        top: 0;
        z-index: 4;
        background: rgba(12,12,14,0.97);
        border-bottom: 1px solid rgba(255,255,255,0.10);
        margin: -6px -8px 0.5rem;
        padding: 6px 8px 6px;
      }
    }

    /* Single column: the score takes the full width and goes first, because
       opening the score should show the score rather than the mixer you were
       already looking at. At 768px that is 632px of width instead of 326px. */
    /* Width alone was the wrong test. A window can be well past 1160px and still
       be taller than it is wide, and in that shape the sidebar is taking the
       scarce dimension (width) to save the plentiful one (height) — so the
       score ends up small with empty space underneath. Side by side only earns
       its place when the viewport is actually wider than it is tall. */
    @media (max-width: 1159px), (max-aspect-ratio: 1/1) {
      .pp-score-open { display: flex; flex-direction: column; }
      .pp-score-open .pp-sheet-section { order: -1; margin-top: 0; }
      .pp-score-open .pp-controls-wrap { order: 0; }
      /* Last in flow on purpose. position:sticky with `bottom` pulls an element
         UP from below the fold — it does not pin one that has already scrolled
         past. Sat between the score and the controls it simply scrolled away;
         sat at the very end of a tall card its natural spot is always below the
         viewport, so it stays pinned the whole way down and only releases when
         you actually reach the bottom of the controls. */
      .pp-score-open .pp-mini-transport { order: 1; display: flex; }
      /* Room so the pinned strip never covers the last of the controls. */
      .pp-score-open .pp-controls-wrap { padding-bottom: 4px; }
    }

    /* A full-width score is ~826px tall on an iPad, so the real controls sit
       off-screen while you are reading. This strip carries the handful of
       things you reach for mid-song and sticks to the bottom of the viewport
       until you scroll down to the controls proper. */
    /* Hidden unless the single-column block below turns it on. Do not set
       display here: this rule and the two-column one have equal specificity, so
       whichever came last in the file would win, and the strip then leaked into
       the sidebar layout as a third flex item and squeezed the score. */
    .pp-mini-transport {
      display: none; align-items: center; gap: 8px;
      position: sticky; bottom: 8px; z-index: 6;
      margin: 8px 0 4px; padding: 8px;
      border-radius: 12px;
      background: rgba(10,10,12,0.94);
      border: 1px solid rgba(255,255,255,0.14);
      box-shadow: 0 6px 18px rgba(0,0,0,0.65);
      backdrop-filter: blur(6px);
    }
    /* Specificity beats the reveal rule in the single-column block, so this
       wins wherever it is in the file. */
    .pp-score-open .pp-mini-transport.is-redundant { display: none; }
    .pp-mini-transport .pp-ctrl-btn,
    .pp-mini-transport .pp-icon-btn { min-height: 44px; }
    .pp-mini-transport .pp-icon-btn { padding: 0 8px; font-size: 0.75rem; }
    /* "2nd of 3" under the measure number, on the pass through a repeat. Its
       own line: squeezing it onto the first one shrank the number that
       actually matters. The tight line-height on the readout keeps the row from
       growing taller as that second line appears. */
    /* The up-down cursor is the only hint that the wheel does anything here.
       It is not a click target, so `pointer` would promise the wrong gesture. */
    .pp-measure-readout, .pp-mini-measure { cursor: ns-resize; user-select: none; }
    .pp-measure-readout { line-height: 1.15; }
    .pp-measure-readout .pp-pass {
      display: block; font-size: 0.75rem; font-weight: 500;
      color: rgba(212,212,216,0.9);
    }
    .pp-mini-measure {
      flex: 1 1 auto; min-width: 0; text-align: center;
      font-size: 0.95rem; font-weight: 600;
      color: rgba(250,204,21,0.95); font-variant-numeric: tabular-nums;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .pp-mini-hide {
      flex: 0 0 auto; min-height: 44px; padding: 0 12px;
      border-radius: 9px; cursor: pointer; font: inherit;
      font-size: 0.85rem; font-weight: 600;
      color: rgba(255,255,255,0.75); background: transparent;
      border: 1px solid rgba(255,255,255,0.2);
    }
    .pp-mini-hide:hover { color: #fff; border-color: rgba(255,255,255,0.35); }
    .pp-mini-hide:focus-visible { outline: 2px solid rgba(250,204,21,0.75); outline-offset: 2px; }
    @media (max-width: 420px) {
      .pp-mini-transport { gap: 5px; padding: 6px; }
      .pp-mini-transport .pp-icon-btn { padding: 0 4px; font-size: 0.7rem; }
      .pp-mini-hide { padding: 0 8px; font-size: 0.8rem; }
    }

    /* Score-open sidebar (~290px): drop the note lane and put the channel on
       one line — name · S · I · note · dial — the same shape a phone takes,
       and for the same reason. It used to wrap to two lines because the words
       "Solo" and "Isolate" would not fit beside the part name. */
    .pp-score-open .pp-chan { flex-wrap: nowrap; gap: 6px; padding: 8px; }
    .pp-score-open .pp-lane { display: none; }
    .pp-score-open .pp-chan-name {
      width: auto; flex: 1 1 auto; order: 1;
      min-width: min(var(--pp-name-w, 6rem), 7rem);
    }
    /* No note box in the sidebar. 290px cannot carry the name, Solo/Isolate,
       the dial AND a 3.4rem note box, and something had to yield for the name
       to fit on one line. The note box yields because it earns its space least
       here: it repeats on the score what the part band already marks under the
       singer's own line, and the singer is reading the score. It stays in the
       full-width view, where there is room for all of it.
       Measured at 1300x700 with Ring Out's eight parts: rows 58px against 61px
       before, so MORE voices fit on screen than today, and names went from
       three lines to one (two for the very longest). Letting the controls wrap
       to a second line instead did fix the names but took rows to 96px, which
       is five voices visible where there were eight (Howie chose this,
       2026-09-19). */
    .pp-score-open .pp-note-box { display: none; }
    .pp-score-open .pp-chan-ctrls { display: contents; }
    .pp-score-open .pp-chan-btns { flex-direction: row; width: auto; flex: 0 0 auto; order: 2; }
    .pp-score-open .pp-note-box { order: 3; }
    .pp-score-open .pp-chan-vol { order: 4; }
    .pp-score-open .pp-focus-btn,
    .pp-score-open .pp-iso-btn {
      width: 30px; flex: 0 0 auto; padding: 0;
      font-size: 0.8rem; font-weight: 700; min-height: 30px;
    }
    .pp-score-open .pp-tempo-group,
    .pp-score-open .pp-metro-group {
      margin-left: 0 !important;
      width: 100%;
      box-sizing: border-box;
    }
    /* Every link in the chain needs min-width:0 or the steps refuse to shrink
       and the deck spills out of the ~288px sidebar (it overflowed by 124px
       before this). The "%" goes for the same reason it goes on phones. */
    .pp-score-open .pp-tempo-group { min-width: 0; }
    .pp-score-open .pp-tempo-widget { flex: 1 1 auto; min-width: 0; box-sizing: border-box; }
    .pp-score-open .pp-tempo-controls { flex: 1 1 auto; min-width: 0; }
    .pp-score-open .pp-tempo-steps { flex: 1 1 auto; min-width: 0; gap: 5px; }
    .pp-score-open .pp-tempo-step { flex: 1 1 0; min-width: 0; padding: 5px 0; font-size: 0.7rem; }
    .pp-score-open .pp-tempo-controls { padding: 4px 7px; }
    /* The sidebar is too narrow for the word AND six steps, and the steps are
       the control. Same call the phone makes below. */
    .pp-score-open .pp-tempo-label { display: none; }
    .pp-score-open .pp-step-pct { display: none; }
    /* The transport buttons carry desktop padding here; without shrinking they
       need ~430px in a 266px row. */
    .pp-score-open .pp-deck { flex-direction: column; align-items: stretch; }
    .pp-score-open .pp-deck-row { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .pp-score-open .pp-deck-row:first-child {
      display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px;
    }
    .pp-score-open .pp-transport-btns { display: contents; }
    .pp-score-open .pp-deck-row:first-child > button { width: 100%; min-width: 0; }
    .pp-score-open .pp-reset-btn { order: 0; margin-left: 0; width: 100%; }
    /* 6px, not 8: the play button holds a 20px icon, and 8px of padding on
       each side made it 38px in a 36px row. */
    .pp-score-open .pp-ctrl-btn { padding: 6px 4px; font-size: 0.85rem; }
    .pp-score-open .pp-ctrl-btn.pp-play-btn { min-width: 0; }
    .pp-score-open .pp-icon-btn { padding: 0 3px; gap: 3px; font-size: 0.7rem; }
    .pp-score-open .pp-icon-btn svg { width: 0.85rem; height: 0.85rem; }
    /* The "Reset"/"Loop" words are behind Tailwind's sm: breakpoint, which keys
       off the viewport, not this sidebar — so on a wide screen they reappear
       and overflow their cells. Hide them whenever the sidebar is what we are
       in. The unclassed "15s" spans are left alone. */
    .pp-score-open .pp-deck span.hidden { display: none; }

    /* Vertical space is the scarce thing in the sidebar: every row of padding
       is one fewer voice part visible without scrolling. Trim it hard here
       only, so the full-width layout keeps its roomier spacing. */
    .pp-score-open .pp-controls-wrap { padding: 6px 8px 8px; }
    .pp-score-open [id$="-transport"] { margin-bottom: 0.5rem; }
    /* The sidebar trades height for parts on screen, so its controls share a
       shorter version of the same token rather than each picking a size. */
    .pp-score-open .pp-deck { --pp-btn-h: 36px; padding: 8px; gap: 6px; }
    .pp-score-open .pp-mixer { gap: 5px; margin-top: 2px; }
    .pp-score-open .pp-chan { padding: 4px 8px; gap: 8px; border-left-width: 3px; }
    .pp-score-open .pp-chan-name { font-size: 0.92rem; }
    .pp-score-open .pp-chan-btns { gap: 3px; }
    .pp-score-open .pp-focus-btn,
    .pp-score-open .pp-iso-btn { padding-top: 3px; padding-bottom: 3px; }
    /* The dial sets the row height, so it is the biggest single saving. 48px
       still clears the grip comfortably since the grip scales with it. */
    .pp-score-open .pp-knob { width: 48px; height: 48px; }
    .pp-score-open .pp-note-box { height: 38px; }
    /* The score sidebar is about 288px wide, which is narrower than a phone. */
    .pp-score-open .pp-info-row { display: flex; flex-wrap: wrap; gap: 4px 10px; }
    .pp-score-open .pp-info-row .pp-loop-bar { flex: 1 1 100%; order: 2; }
    /* The sidebar trades height for parts on screen, so the steppers shrink
       with everything else rather than keeping the phone's touch target. */
    .pp-score-open .pp-loop-bar { --pp-step-h: 28px; gap: 0.3rem; }
    .pp-score-open .pp-step-val { width: 2.8rem; font-size: 0.82rem; }
    /* "128 (3rd)" needs more than a bare number, and the narrow width above
       beats the base has-pass rule on source order alone. */
    .pp-score-open .pp-step-val.has-pass { width: 4.8rem; }
    /* Same squeeze as a phone, for the same reason: a 288px sidebar fits one
       labelled stepper to a line. */
    .pp-score-open .pp-edge { flex: 1 1 100%; }
    .pp-score-open .pp-edge-label { width: 4rem; }
    .pp-score-open .pp-loop-summary { flex: 1 1 100%; justify-content: space-between; }
    .pp-score-open .pp-info-row .pp-info-right { order: 1; margin-left: auto; }
    .pp-score-open .pp-status,
    .pp-score-open [id$="-status"] { margin-top: 0; font-size: 0.75rem; }
    .pp-score-open .pp-metronome-btn { flex: 1 1 auto; justify-content: center; }
    .pp-score-open .pp-tempo-bpm-input { display: none; }

    /* Between a phone and a small laptop the row holds everything except the
       note lane. The lane is the one part of the row that can go: it wants
       hundreds of pixels to be worth reading, and a squeezed 40px one pushed
       the row into a sideways scroll. Below 640 it is already gone. */
    @media (min-width: 640px) and (max-width: 767px) {
      .pp-lane { display: none; }
    }

    /* A phone gives the card 664px of real screen once Safari's own bars are
       counted, and the card's header was taking 133 of it — two lines of title
       and composer, then a line of buttons. While a player is open that header
       is mostly answering questions the singer has already asked: they tapped
       Practice on this song, the score is a button inside the deck, and a
       reference recording is not something you use mid-rehearsal.
       So while practicing, on a phone only: the title and the way back out
       share one line, and the rest gives its space to the music. Nothing
       changes on a tablet or a desktop, where the singer reads the score from
       the same card and has the room for a title line and a button line. */
    @media (max-width: 639px) {
      .midi-practice.is-practicing > div:first-child {
        flex-direction: row; align-items: center; justify-content: space-between; gap: 8px;
      }
      .midi-practice.is-practicing .pdf-btn,
      .midi-practice.is-practicing .yt-btn,
      .midi-practice.is-practicing .guide-btn,
      .midi-practice.is-practicing .song-desc,
      .midi-practice.is-practicing .song-translation { display: none; }
      /* The title wraps rather than truncating. It is the one thing on the row
         a singer needs, and "2. Blow, Blow, Thou Winter..." is not a title. */
      .midi-practice.is-practicing .song-titleblock { flex-wrap: wrap; min-width: 0; }
      .midi-practice.is-practicing .song-title { white-space: normal; }
    }

    /* Narrow screens: drop the note lane and wrap each channel to two lines —
       name + current-note box on top, Solo/Isolate + volume below */
    @media (max-width: 639px) {
      .pp-chan { flex-wrap: nowrap; gap: 6px; padding: 5px 8px; }
      /* Score and Download Mix share a line rather than taking one each:
         stacked, the two of them cost 122px of a 844px screen. */
      .pp-deck-row .pp-sheet-toggle-btn,
      .pp-deck-row .pp-export-btn {
        flex: 1 1 0; min-width: 0; justify-content: center; white-space: nowrap;
      }
      /* The tempo and the meter can wrap onto a second line; three lines of it
         is the legend pushing its way in, so the legend goes under the text. */
      /* A phone has no room for three columns, so the row goes back to flex. */
      .pp-info-row { display: flex; flex-wrap: wrap; gap: 4px 10px; }
      .pp-info-left { flex: 1 1 auto; }
      /* A phone has no room for three things on one line. The loop controls
         take a full line of their own under the song text, and the egg stays
         up on the song line rather than costing a third line. */
      /* That full line is what pays for a proper touch target on the two
         steppers. They are the one control a singer uses mid-song with one
         thumb, so they get the same 44px the transport buttons get.
         Two classes deep on purpose: the score sidebar's own `--pp-step-h`
         is `.pp-score-open .pp-loop-bar`, and on a phone with the score open
         both selectors match. Equal specificity, and this one comes later. */
      .pp-info-row .pp-loop-bar { margin-left: 0; flex: 1 1 100%; order: 2; --pp-step-h: 44px; }
      .pp-info-row .pp-step-btn { font-size: 1.3rem; }
      .pp-info-row .pp-step-val { width: 3.4rem; font-size: 1rem; }
      .pp-info-row .pp-step-val.has-pass { width: 5.4rem; }
      /* The loop bar gets 298px on a 390px phone, and one stepper with its
         label is 190 of that. So each end takes a line of its own, labelled,
         and the length and the off switch share a third. Stacking is the
         deliberate version of the wrap that happened anyway. */
      .pp-info-row .pp-loop-steps { gap: 0.35rem 0.5rem; }
      .pp-info-row .pp-edge { flex: 1 1 100%; }
      .pp-info-row .pp-edge-label { width: 4.6rem; }
      .pp-info-row .pp-loop-summary { flex: 1 1 100%; justify-content: space-between; }
      /* Cancel wraps onto a line of its own, and stranded at the left it read
         as a button belonging to nothing. Pushed right, it sits where "Loop
         off" sits in the running state. */
      .pp-info-row .pp-loop-armed .pp-loop-off-btn { margin-left: auto; }
      /* Flex again here, so the right-hand group needs its own push. */
      .pp-info-row .pp-info-right { order: 1; margin-left: auto; }
      .pp-status { font-size: 0.75rem; }
      .pp-legend { font-size: 0.68rem; }
      /* One line per voice part: name · S · I · note · dial.
         It used to take two, because "Solo" and "Isolate" spelled out are
         wider than the part name they belong to. As single letters they fit
         beside it, and the second line goes back to the music.
         `display: contents` on the wrapper is what lets `order` arrange the
         four of them as siblings of the row rather than as a block of their
         own. Fixed widths total 200px of a 331px row, so the name keeps the
         rest and still wraps rather than truncating. */
      .pp-chan-name { width: auto; flex: 1 1 auto; min-width: 0; font-size: 0.95rem; order: 1; }
      .pp-chan-ctrls { display: contents; }
      .pp-chan-btns { flex-direction: row; width: auto; flex: 0 0 auto; gap: 4px; order: 2; }
      .pp-note-box { order: 3; }
      .pp-chan-vol { order: 4; }
      .pp-focus-btn, .pp-iso-btn {
        width: 32px; flex: 0 0 auto; padding: 0;
        font-size: 0.85rem; font-weight: 700; min-height: 32px;
      }
      .pp-lane { display: none; }
    }

    /* Narrow screens, part 2: the panel itself. A phone gives the deck only
       ~260px once four nested paddings are subtracted, which pushed the tempo
       stepper off the right edge (the "100%" step was clipped). Claw back the
       padding, then stack the deck into three full-width rows — transport,
       metronome, tempo — so every control is reachable and nothing overflows. */
    @media (max-width: 639px) {
      .resource-list > li { padding: 0.625rem; }
      .midi-practice > [id$="-panel"],
      .audio-practice > [id$="-panel"] { padding-left: 0.5rem; padding-right: 0.5rem; }
      .midi-practice > [id$="-panel"] > div,
      .audio-practice > [id$="-panel"] > div { padding: 0.75rem; }
      /* 44px is the phone touch target, and now the metronome and the two
         wide buttons get it too instead of 38px and 36px. */
      .pp-deck { --pp-btn-h: 44px; padding: 10px; gap: 8px; }
      /* The transport becomes a grid of five equal cells on a phone. */
      .pp-deck-row:first-child {
        display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px;
      }
      .pp-transport-btns { display: contents; }
      .pp-deck-row > button, .pp-deck-row .pp-ctrl-btn, .pp-deck-row .pp-icon-btn { min-width: 0; }
      .pp-metro-group { flex: 1 1 100%; }
      .pp-metronome-btn { flex: 1 1 auto; justify-content: center; }
      /* A phone gives the card a row of its own, so the dial keeps a bigger
         grip. This rule comes after the base one, which it has to: the two
         match on specificity and the later one wins. */
      .pp-metro-vol .pp-knob.pp-knob-sm { width: 34px; height: 34px; }
      .pp-tempo-group { flex: 1 1 100%; min-width: 0; }
      .pp-tempo-widget {
        display: flex; flex: 1 1 auto; width: 100%;
        box-sizing: border-box; min-width: 0;
        justify-content: space-between;
      }
      .pp-tempo-controls { padding: 4px 6px; }
      .pp-tempo-controls { flex: 1 1 auto; min-width: 0; }
      .pp-tempo-steps { flex: 1 1 auto; min-width: 0; gap: 3px; }
      /* Equal-width steps that shrink together instead of the last one falling
         off the edge. The visible "Tempo" caption goes — six percentages plus
         the reset arrow need every pixel, and the steps carry an aria-label. */
      .pp-tempo-label { display: none; }
      .pp-tempo-step { flex: 1 1 0; min-width: 0; padding: 8px 0; font-size: 0.72rem; }
      /* Below ~420px the "%" is what pushes "100%" past its 23px cell and gets
         sliced. Six bare numbers in a labelled Tempo group read the same; the
         buttons keep the percent in their aria-label. */
      .pp-step-pct { display: none; }

      /* Transport: five buttons summed to 304px in a 261px row, so "15s ⏩"
         wrapped alone onto a second line with a hole beside it. An equal
         five-column grid always fits and makes each button a wider target. */
      /* Five equal cells: play, the two skips, loop, then Reset on the right. */
      .pp-deck-row:first-child > button { width: 100%; min-width: 0; }
      .pp-reset-btn { order: 0; margin-left: 0; width: 100%; }
      .pp-ctrl-btn.pp-play-btn { min-width: 0; }
      .pp-icon-btn { padding: 0 3px; gap: 3px; font-size: 0.7rem; }
      .pp-icon-btn svg { width: 0.85rem; height: 0.85rem; }
      /* Icon over word, so both buttons say what they are in a 51px cell.
         The height is pinned, not just floored: Reset is a .pp-ctrl-btn and
         carries 8px of padding top and bottom, so stacking pushed it to 46px
         and the deck went ragged. Every control in this row is one height and
         members-practice-deck.spec.ts is the test that keeps it that way. */
      .pp-deck-row:first-child .pp-punch-btn,
      .pp-deck-row:first-child .pp-reset-btn {
        flex-direction: column; gap: 2px;
        height: var(--pp-btn-h, 44px); padding-top: 0; padding-bottom: 0;
      }
      .pp-btn-short, .pp-btn-word { font-size: 0.62rem; line-height: 1; }
      /* The measure readout reserved 5.5rem, starving the progress track. */
      .pp-measure-readout { font-size: 0.9rem; }
      .pp-measure-readout .pp-pass { font-size: 0.7rem; }
    }
</style>

<script>
  import { openLoopHowTo, loopHowToDismissed } from '../lib/loop-howto';
  import { stavesFor, partTokens, voiceParts } from '../lib/part-staff.js';
  import PIANO_ENERGY from '../lib/piano-sample-energy.json';
  import { registerSpaceToPlay } from '../lib/space-to-play';
  // === Player engine — the spring2026 MIDI engine plus the practice features
  // from the spring2026 audio player: Solo (others ducked to 18%) / ISO (others
  // muted), A-B loop, skip 15s, tempo+volume reset, saloon egg, and the
  // two-column score view. ===
  // Accordion registry shared with AudioPractice — the MIDI and recorded-audio
  // rows sit in the same list, so opening either one must close the other.
  const allPlayerClosers: Array<() => void> =
    ((window as any).__ssPracticeClosers ||= []);
  // Keyed by row prefix, so the rehearsal schedule's practice links can drive
  // one specific player. AudioPractice rows never register: recorded audio has
  // no measure map, so a measure range means nothing to it.
  const practiceJumps: Record<string, (from: number, to: number) => Promise<void>> =
    ((window as any).__ssPracticeJumps ||= {});
  // The Tone module, held once for the whole page.
  //
  // Each player also keeps its own `Tone` handle, and that handle starts as
  // null and is only filled by that player's own load(). So a player you had
  // never opened could not resume the audio, even on a page that had been
  // playing Tone for ten minutes. That is what made the rehearsal schedule's
  // practice links take two presses on a phone: the first press stopped the
  // song that was playing, loaded the new one, and then called Tone.start()
  // long after the tap had ended, which iOS refuses.
  let ToneMod: any = null;
  let tonePromise: Promise<any> | null = null;
  // The feedback form's "Sound:" line. A singer who hears nothing cannot tell
  // us whether the browser put the audio to sleep, so the form asks the player
  // (a singer's report of 2026-10-02 said only "no sound"). "interrupted"
  // is Safari's state, the one only a quit of Safari clears.
  (window as any).__ppMidiSound = () => (ToneMod ? String(ToneMod.getContext().state) : 'not started');
  // ONE DECODED PIANO FOR THE WHOLE PAGE
  //
  // The player built one Tone.Sampler per part from the sample URLs, and each
  // one fetched and decoded all 30 Salamander samples on its own. One decoded
  // set is about 155 MB (424 seconds of stereo audio), so opening a nine-part
  // score held about 1.4 GB of piano, a heavy load for a phone. Download Mix
  // did the same again for every export and never freed it, so after a few
  // exports the browser refused to decode any more and the button failed with
  // "Unable to decode audio data" (found 2026-09-27 while measuring Solo; see
  // tests/download-mix-repeats.spec.ts).
  //
  // Now the set is decoded once per page, by whichever player opens first,
  // and every sampler shares it: every part of every song, and every export.
  // A decoded AudioBuffer is only read during playback, so any number of
  // samplers, in any context, can use one. Disposing a sampler drops its own
  // wrapper around the buffer, not the buffer this cache holds.
  let pianoSet: Promise<Record<string, AudioBuffer>> | null = null;
  function sharedPiano(T: any, urls: Record<string, string>, baseUrl: string) {
    return (pianoSet ||= new Promise<Record<string, AudioBuffer>>((resolve, reject) => {
      const bufs = new T.ToneAudioBuffers({
        urls, baseUrl,
        onload: () => resolve(Object.fromEntries(Object.keys(urls).map(k => [k, bufs.get(k).get()]))),
        onerror: reject,
      });
    }).catch(err => { pianoSet = null; throw err; }));   // let a later export retry
  }

  function primeTone(): Promise<any> {
    return (tonePromise ||= import('tone').then((m) => (ToneMod = m)));
  }

  // Tone.start() is the resume. It has to be CALLED inside the click that
  // wants the sound, not after an await, or Safari no longer counts it as a
  // user gesture. So it is fired and not waited on: the Transport starts
  // against a parked clock quite happily and picks up the moment the context
  // comes back.
  //
  // Before this the play button took two presses to get the sound back, and
  // the first one only looked like it had done nothing. The practice links
  // still behaved that way afterwards, because they never called this.
  function unlockAudio() {
    primeTone();
    if (!ToneMod) return;
    try { ToneMod.getContext().rawContext.resume(); } catch {}
    try { ToneMod.start()?.catch?.(() => {}); } catch {}
  }

  // Start the Tone download on the press, not the release, so the click that
  // follows a few milliseconds later already has a module to resume. Without
  // this the first press of the session has nothing to unlock yet.
  //
  // Scoped to the controls that lead to sound. A listener on the whole
